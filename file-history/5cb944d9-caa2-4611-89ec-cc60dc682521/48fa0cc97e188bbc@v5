    def get_orders(
        self, start, end, first_crawl, first_loop, page_token=None, sync_job_id=None
    ):
        if first_loop:
            self.warehouse_to_address = {}
            if not self.in_perm_validator():
                warehouses = Warehouse(self).get_all_resources()
            else:
                warehouse_rsp = self.get_warehouses(start, end, first_crawl, first_loop)
                warehouses = warehouse_rsp["data"]
            for warehouse in warehouses:
                self.warehouse_to_address[warehouse["id"]] = warehouse["address"]
        page_size = 500
        if self.in_perm_validator():
            page_size = 1
        modify_start_dt = start
        if first_loop:
            # buffer to catch orders shipstation's api is slow to index
            modify_start_dt = start - timedelta(hours=2)
        # bulk edits can stamp more orders with one modifyDate second than fit in a page,
        # so the second-based cursor stalls; page within it via a {modify_date, page} token.
        page = 1
        offset = 0
        if page_token:
            modify_start_dt = str_to_dt(format_date(page_token["modify_date"]))
            page = page_token["page"]
            offset = page_token["offset"]
        # modifyDate is account-local (pacific) time, so cursors compare seconds in pacific.
        # the query uses the same whole second so a token re-reads exactly this page
        pacific_start = modify_start_dt.astimezone(pytz.timezone("US/Pacific"))
        modify_start_str = pacific_start.strftime("%Y-%m-%dT%H:%M:%S")
        query_params = {
            "modifyDateStart": modify_start_str,
            # bound orders to end; the shipment window stops at end, so without this a
            # back-sync with a past end pulls later orders and stores them with no shipment
            "modifyDateEnd": end,
            "pageSize": page_size,
            "page": page,
            "sortBy": "ModifyDate",
            "sortDir": "ASC",
        }
        orders_rsp = self.shipstation_request("orders", params=query_params)
        orders = orders_rsp["orders"]
        page_next_token = None
        page_next_start = None
        if len(orders) == page_size:
            last_second = orders[-1]["modifyDate"].split(".")[0]
            last_second_dt = str_to_dt(format_date(last_second))
            if last_second == modify_start_str:
                # the whole page falls in one second, so re-anchoring there would refetch
                # it; walk shipstation's pages within that second instead
                page_next_token = {
                    "modify_date": modify_start_str,
                    "page": page + 1,
                    "offset": 0,
                }
            elif start < last_second_dt < end:
                # move the window forward so latest_data advances during long backfills
                page_next_start = last_second_dt
            else:
                # the first loop's buffer can put last_second at or before start, which
                # next_start can't express
                page_next_token = {
                    "modify_date": last_second,
                    "page": 1,
                    "offset": 0,
                }

        shipment_start_date = dt_to_str(start - timedelta(days=7))
        # get all shipments 7 days before start on first loop.
        # get all fulfillments ever since there aren't that many
        # any order created before 7 days ago get shipments for it individually to ensure we don't miss shipments
        # there is no shipments info on the order itself so we need to do this to get all the shipment info.
        # prime candidate for improvement with ETL :)
        if first_loop and orders:
            # shipments response cover order shipments with labels generated in ShipStation
            # fulfillments response cover orders that have been marked as shipped either through the UI or the API
            self.shipment_map = defaultdict(list)
            self.fulfilllments_map = defaultdict(list)
            self.v2_enrich = False
            self.get_order_metadata()
            if not self.in_perm_validator():
                fulfillments_next_page = 1
                while fulfillments_next_page:
                    fulfillments_query_params = {
                        "createDateStart": shipment_start_date,
                        "page": fulfillments_next_page,
                        "pageSize": page_size,
                    }
                    fulfillments = self.shipstation_request(
                        "fulfillments", params=fulfillments_query_params
                    )
                    for fulfillment in fulfillments["fulfillments"]:
                        self.fulfilllments_map[fulfillment["orderId"]].append(
                            fulfillment
                        )

                    if fulfillments["pages"] > fulfillments_next_page:
                        fulfillments_next_page += 1
                    else:
                        fulfillments_next_page = None

                self.v2_enrich = (
                    self.integration_secret.get("v2_api_key")
                    and self.org_id in ENABLED_SHIPSTATION_V2_PACKAGE_NAME_ORGS
                )
                v2_package_names = {}
                if self.v2_enrich:
                    try:
                        v2_package_names = self._load_v2_package_names(
                            start - timedelta(days=7), end
                        )
                    except PermissionsException:
                        # v2 best-effort; fall back to v1 resolution
                        pass
                # chunk into 7-day windows — keeps page count low for v1's
                # 40/min rate limit (v2 has 200/min; fetched once above)
                window_start = start - timedelta(days=7)
                seen_shipment_ids = set()
                while window_start < end:
                    window_end = min(window_start + timedelta(days=7), end)
                    shipments_next_page = 1
                    while shipments_next_page:
                        shipments_query_params = {
                            "createDateStart": dt_to_str(window_start),
                            "createDateEnd": dt_to_str(window_end),
                            "page": shipments_next_page,
                            "pageSize": page_size,
                            "includeShipmentItems": True,
                        }
                        shipments = self.shipstation_request(
                            "shipments", params=shipments_query_params
                        )
                        for shipment in shipments["shipments"]:
                            # shipstation matches createDateStart/End by calendar day,
                            # so two windows meeting on a date both return that date's
                            # shipments; keep only the first copy of each
                            if shipment["shipmentId"] in seen_shipment_ids:
                                continue
                            seen_shipment_ids.add(shipment["shipmentId"])
                            self.shipment_map[shipment["orderId"]].append(shipment)
                            if self.v2_enrich:
                                shipment["_v2_package_name"] = v2_package_names.get(
                                    f"se-{shipment['orderId']}"
                                )
                        if shipments_next_page == 1:
                            logger.info(f"{shipments['pages']}")

                        if shipments["pages"] > shipments_next_page:
                            shipments_next_page += 1
                        else:
                            shipments_next_page = None
                    window_start = window_end

        # a page full of orders needing the individual lookup above outruns a task, so stop the
        # slice after a fixed count and carry the offset in the token to keep the progress
        slice_end = offset
        historical_in_slice = 0
        while slice_end < len(orders):
            order = orders[slice_end]
            is_historical = (
                order["createDate"] < shipment_start_date
                and order["orderStatus"] == "shipped"
            )
            if (
                is_historical
                and historical_in_slice >= SHIPSTATION_GET_ORDERS_HISTORICAL_CHUNK_SIZE
            ):
                break
            if is_historical:
                historical_in_slice += 1
            slice_end += 1
        work_orders = orders[offset:slice_end]
        next_start = None
        if slice_end < len(orders):
            next_token = {
                "modify_date": modify_start_str,
                "page": page,
                "offset": slice_end,
            }
        else:
            next_token = page_next_token
            next_start = page_next_start

        formatted_orders = []
        for order in work_orders:
            # get shipment info for orders not captured by shipment/fulfillment window
            if (
                order["createDate"] < shipment_start_date
                and order["orderStatus"] == "shipped"
            ):
                shipments = self.shipstation_request(
                    "shipments",
                    params={
                        "orderId": order["orderId"],
                        "includeShipmentItems": True,
                    },
                )
                self.shipment_map[order["orderId"]] = shipments["shipments"]
                if self.v2_enrich:
                    v2_package_name = self._fetch_v2_package_name(order["orderId"])
                    for shipment in shipments["shipments"]:
                        shipment["_v2_package_name"] = v2_package_name
                fulfillments = self.shipstation_request(
                    "fulfillments",
                    params={"orderId": order["orderId"]},
                )
                self.fulfilllments_map[order["orderId"]] = fulfillments["fulfillments"]

            curr_fulfillments = self.fulfilllments_map[order["orderId"]]
            curr_shipments = self.shipment_map[order["orderId"]]
            formatted_fullfillments = []
            for fulfillment in curr_fulfillments:
                formatted_fulfillment = format_order_fulfillment(
                    order,
                    fulfillment,
                    self.warehouse_to_address,
                    self.packages,
                    self.sm_code_to_name,
                    self.carrier_code_to_name,
                )
                warehouse_id = formatted_fulfillment["warehouse_id"]
                if string_is_empty(warehouse_id):
                    continue
                formatted_fullfillments.append(formatted_fulfillment)

            formatted_shipments = []
            for shipment in curr_shipments:
                formatted_shipment = format_order_shipment(
                    order,
                    shipment,
                    self.warehouse_to_address,
                    self.packages,
                    self.sm_code_to_name,
                    self.carrier_code_to_name,
                )
                if formatted_shipment:
                    formatted_shipments.append(formatted_shipment)

            formatted_order = format_order(
                order,
                self.sm_code_to_name,
                self.carrier_code_to_name,
                self.carrier_name_to_code,
                formatted_shipments
                + formatted_fullfillments,  # shipments and fulfillments
                self.org_id in SHIPSTATION_SKIP_NO_SKU_LINE_ITEMS_ORGS,
                tag_id_to_name=self.tag_id_to_name,
                store_id_to_channel=self.store_id_to_channel,
            )
            formatted_orders.append(formatted_order)

        return {
            "data": formatted_orders,
            "next_token": next_token,
            "next_start": next_start,
        }

