    def create_order_schema(self):
        class OrderSchema(TrackstarWriteSchema):
            order_number = Order().order_number(required=False)
            # shipstation's own order status, not a trackstar one: it decides which
            # tab the order lands in, and only awaiting_shipment is ready to ship
            status = String(
                "The ShipStation status to create the order with. Orders created as `awaiting_payment` sit in the Awaiting Payment tab and have to be moved before they can ship.",
                "awaiting_shipment",
                validate=[OneOf(["awaiting_payment", "awaiting_shipment"])],
                required=False,
            )
            required_ship_date = Order().required_ship_date(required=False)
            shipping_method_id = Order().shipping_method_id(required=False)
            shipping_method_name = Order().shipping_method_name(required=False)
            bill_to_address = self.create_address(
                "CreateBillingAddress",
                optional=["address2", "company"],
                nullable=["company", "address2"],
                required=False,
            )
            ship_to_address = self.create_address(
                "CreateOrderShipToAddress",
                optional=["address2", "company"],
                nullable=["company", "address2"],
            )
            line_items = Order(self).create_line_items_schema(
                quantity=Integer("The quantity of the item"),
                sku=String("The SKU of the item"),
                unit_price=Float("The unit price of the item", required=False),
            )

        schema = OrderSchema()
        return schema

