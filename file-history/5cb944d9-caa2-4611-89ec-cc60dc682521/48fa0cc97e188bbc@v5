    def shipstation_request(self, path, method="GET", is_v2=False, **kwargs):
        if is_v2:
            url = f"https://api.shipstation.com/v2/{path}"
            if not self.integration_secret.get("v2_api_key"):
                error = self.create_permissions_exception(path)
                self.api_call_errors[path] = error
                raise error
            else:
                self.api_call_errors[path] = None
            headers = {
                "api-key": self.integration_secret.get(
                    "v2_api_key"
                ),  # for backwards compatibility
            }
        else:
            url = f"{self.base_url()}/{path}"
            headers = {
                "Authorization": f"Basic {base64.b64encode(self.integration_secret['access_token'].encode()).decode()}",
            }

        @retry(3, "ShipStation")
        def make_request():
            session = get_request_session()
            rsp = session.request(method, url, headers=headers, **kwargs)
            if rsp.status_code == 429:
                raw_limit_reset = rsp.headers.get("X-Rate-Limit-Reset")
                if raw_limit_reset:
                    limit_reset = int(raw_limit_reset)
                    raise ThrottleException("ShipStation", limit_reset)
                raise PokedexException(
                    f"ShipStation request failed: {rsp.text}",
                    rsp.status_code,
                    origin="integration",
                )
            elif rsp.status_code == 401:
                if is_v2:
                    if (
                        "You must upgrade your billing plan or add required features"
                        in rsp.text
                    ):
                        error = self.create_permissions_exception(path)
                        self.api_call_errors[path] = error
                        raise error
                try:
                    js = rsp.json()
                except Exception:
                    if rsp.text == "401 Unauthorized":
                        raise self.create_invalid_credentials_exception()
                    raise PokedexException(
                        f"ShipStation request failed: {rsp.text}",
                        rsp.status_code,
                        origin="integration",
                    )
                errors = js["errors"]
                for error in errors:
                    if error["message"] == "Access denied.":
                        err_path = error["path"]
                        # don't have a good way to test this path rn
                        err = self.create_permissions_exception(err_path)
                        self.api_call_errors[path] = err
                        raise err
                    raise PokedexException(
                        f"ShipStation request failed: {rsp.text}",
                        rsp.status_code,
                        origin="integration",
                    )
                raise self.create_invalid_credentials_exception()
            elif rsp.status_code == 402:
                err = self.create_permissions_exception(path)
                self.api_call_errors[path] = err
                raise err
            elif rsp.status_code != 200:
                try:
                    js = rsp.json()
                    exception_message = js.get("ExceptionMessage")
                    inner_exception = js.get("InnerException")
                    generic_message = js.get("Message", "ShipStation request failed")
                    if inner_exception:
                        exception_message += f": {inner_exception}"
                    if not exception_message:
                        exception_message = generic_message
                    raise PokedexException(
                        exception_message, rsp.status_code, origin="integration"
                    )
                except Exception:
                    raise PokedexException(
                        f"ShipStation request failed: {rsp.text}",
                        rsp.status_code,
                        origin="integration",
                    )
            return rsp

        rsp = make_request()
        self.api_call_errors[path] = None
        try:
            rsp = rsp.json()
        except Exception:
            raise PokedexException(
                f"ShipStation request failed: {rsp.text}",
                rsp.status_code,
                origin="integration",
            )

        return rsp

    def make_request(self, path, method, headers=None, data=None, params=None):
        # v1 and v2 are separate apis on separate hosts with separate keys, so the
        # caller picks v2 by keeping the version in the path (e.g. "v2/inventory")
        if path.startswith("v2/"):
            if not self.integration_secret.get("v2_api_key"):
                raise self.create_permissions_exception(path)
            url = f"https://api.shipstation.com/{path}"
            request_headers = {"api-key": self.integration_secret["v2_api_key"]}
        else:
            url = f"{self.base_url()}/{path}"
            encoded_access_token = base64.b64encode(
                self.integration_secret["access_token"].encode()
            ).decode()
            request_headers = {"Authorization": f"Basic {encoded_access_token}"}
        if headers:
            request_headers.update(headers)
        session = get_request_session()
        response = session.request(
            method, url, headers=request_headers, json=data, params=params
        )
        try:
            body = response.json()
        except Exception:
            body = response.text
        return {
            "status_code": response.status_code,
            "headers": dict(response.headers),
            "body": body,
        }

    def get_inventory(self, start, end, first_crawl, first_loop, page_token=1):
        if first_loop:
            self.inventory = defaultdict(dict)
            path = "inventory"
            try:
                inv_rsp = self.shipstation_request(path, is_v2=True)
                inv = inv_rsp["inventory"]
                next_url = inv_rsp["links"]["next"].get("href")
                while next_url:
                    cursor = next_url.split("cursor=")[1]
                    inv_rsp = self.shipstation_request(
                        f"inventory?cursor={cursor}", is_v2=True
                    )
                    inv.extend(inv_rsp["inventory"])
                    next_url = inv_rsp["links"]["next"].get("href")
                for item in inv:
                    self.inventory[item["sku"]] = item
            except Exception as e:
                # Dont want to show a "red" error if the user doesn't have permissions
                if isinstance(e, PermissionsException):
                    return {"data": [], "next_token": None}
                else:
                    raise e

        page_size = 500
        if self.in_perm_validator():
            page_size = 1
        path = "products"
        query_params = {
            "page": page_token,
            "pageSize": page_size,
        }
        products = self.shipstation_request(path, params=query_params)
        formatted_inventory = []
        for product in products["products"]:
            prod_inv = self.inventory.get(product["sku"])
            if not prod_inv:
                continue
            formatted_inventory.append(format_inventory(product, prod_inv))

        next_token = None
        if products["pages"] > page_token:
            next_token = page_token + 1

        return {"data": formatted_inventory, "next_token": next_token}

    def get_products(self, start, end, first_crawl, first_loop, page_token=1):
        path = "products"
        page_size = 500
        if self.in_perm_validator():
            page_size = 1
        query_params = {
            "page": page_token,
            "pageSize": page_size,
        }
        products = self.shipstation_request(path, params=query_params)
        formatted_products = []
        for product in products["products"]:
            product_modified_date = (
                str_to_dt(format_date(product["modifyDate"]))
                if product["modifyDate"]
                else None
            )
            # if the product was modified before the start date or the product doesn't have a modify date, skip it
            if not first_crawl:
                if product_modified_date and product_modified_date < start:
                    continue
            formatted_products.append(format_product(product))

        next_token = None
        if products["pages"] > page_token:
            next_token = page_token + 1

        return {"data": formatted_products, "next_token": next_token}

    def get_order_metadata(self):
        self.sm_code_to_name = {}
        self.carrier_code_to_name = {}
        self.carrier_name_to_code = {}
        self.packages = {}
        self.tag_id_to_name = {}
        for tag in self.shipstation_request("accounts/listtags") or []:
            self.tag_id_to_name[tag["tagId"]] = tag["name"]
        self.store_id_to_channel = {}
        # inactive stores still own old orders, so include them in the lookup
        for store in self.shipstation_request("stores?showInactiveStores=true") or []:
            # marketplaceId names the platform, not the store, so on its own it
            # collides across stores; suffix the store (our warehouse customer)
            self.store_id_to_channel[store["storeId"]] = {
                "channel_id": str(store["marketplaceId"]) + "_" + str(store["storeId"]),
                "channel_name": store["marketplaceName"],
            }
        sms_to_iterate = []
        scheduler_row = None
        if not self.in_perm_validator():
            scheduler_row = ShippingMethod(self).get_scheduler_row()
        if not scheduler_row or not scheduler_row.get("latest_data"):
            shipping_method_rsp = self.get_shipping_methods(None, None, None, None)
            sms_to_iterate: list = shipping_method_rsp["data"]
        else:
            sms_to_iterate = ShippingMethod(self).get_all_resources()
        for sm in sms_to_iterate:
            self.sm_code_to_name[sm["id"]] = sm["name"]
            self.carrier_code_to_name[sm["carrier_id"]] = sm["carrier_name"]
            self.carrier_name_to_code[sm["carrier_name"]] = sm["carrier_id"]
        for carrier in self.carrier_code_to_name:
            try:
                packages = self.shipstation_request(
                    f"carriers/listpackages?carrierCode={carrier}"
                )
                # Error handling for bad carriers
            except PokedexException as e:
                if "Invalid Carrier" in e.message:
                    continue
                raise e
            if "Message" in packages:
                continue
            for package in packages:
                self.packages[(carrier.lower(), package["code"].lower())] = package

