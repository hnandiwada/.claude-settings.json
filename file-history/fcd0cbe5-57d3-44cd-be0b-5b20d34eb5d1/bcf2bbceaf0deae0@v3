def test_deleted_connection_is_not_processed(mocker, connection_row):
    deleted_row = {**connection_row, "deleted": True}

    # stands in for get_connections_row, which only rejects a deleted row when the
    # caller leaves ignore_deleted alone. asking for one back is what this pins.
    def get_row(connection_id, ignore_deleted=True, consistent=False):
        if ignore_deleted:
            raise Exception("Connection deleted")
        return deleted_row

    mocker.patch("utils.event_intake.get_connections_row", side_effect=get_row)
    build = mocker.patch("utils.event_intake.build_integration")
    with pytest.raises(Exception, match="Connection deleted"):
        EventIntake(CONNECTION_ID)
    build.assert_not_called()


class TestProcess:
    def test_update_action_calls_handle_update(self, intake, mocker):
        mock_handle = mocker.patch.object(intake, "_handle_update")
        transform_result = {
            "resource": "products",
            "id": "sku-123",
            "action": "update",
            "fields": {"active": True},
        }
        intake.process(transform_result)
        mock_handle.assert_called_once()

    def test_inactive_org_skips_event(self, intake, mocker):
        mocker.patch("utils.event_intake.is_org_inactive", return_value=True)
        mock_handle = mocker.patch.object(intake, "_handle_update")
        transform_result = {
            "resource": "products",
            "id": "sku-123",
            "action": "update",
            "fields": {"active": True},
        }
        intake.process(transform_result)
        mock_handle.assert_not_called()

    def test_unsupported_action_raises(self, intake):
        transform_result = {
            "resource": "products",
            "id": "sku-123",
            "action": "delete",
            "fields": {},
        }
        with pytest.raises(Exception, match="Unsupported action"):
            intake.process(transform_result)

    def test_handle_update_stores_and_sends_webhook(self, intake, mocker):
        merged_row = {
            "connection_id": CONNECTION_ID,
            "id": "sku-123",
            "active": True,
            "updated_date": "2026-04-09T00:00:00Z",
        }
        mocker.patch(
            "utils.event_intake.prepare_partial_update", return_value=merged_row
        )
        mocker.patch(
            "utils.event_intake.get_rows_for_dynamo_webhook",
            return_value=([merged_row], [merged_row]),
        )
        mock_store = mocker.patch("utils.event_intake.store_resources")
        mock_webhook = mocker.patch("utils.event_intake.write_pickle_to_s3")

        resource = MagicMock()
        intake._handle_update(resource, "sku-123", {"active": True})

        mock_webhook.assert_called_once_with(
            "webhook",
            {"resource": resource, "data": [merged_row]},
            source="event-intake",
        )
        mock_store.assert_called_once()

    def test_handle_update_no_existing_row(self, intake, mocker):
        mocker.patch("utils.event_intake.prepare_partial_update", return_value=None)
        mock_store = mocker.patch("utils.event_intake.store_resources")
        mock_webhook = mocker.patch("utils.event_intake.write_pickle_to_s3")

        resource = MagicMock()
        intake._handle_update(resource, "sku-123", {"active": True})

        mock_store.assert_not_called()
        mock_webhook.assert_not_called()

    def test_handle_update_no_changes_detected(self, intake, mocker):
        mocker.patch(
            "utils.event_intake.prepare_partial_update",
            return_value={"id": "sku-123"},
        )
        mocker.patch(
            "utils.event_intake.get_rows_for_dynamo_webhook",
            return_value=([], []),
        )
        mock_store = mocker.patch("utils.event_intake.store_resources")
        mock_webhook = mocker.patch("utils.event_intake.write_pickle_to_s3")

        resource = MagicMock()
        intake._handle_update(resource, "sku-123", {"active": True})

        mock_store.assert_not_called()
        mock_webhook.assert_not_called()

    def test_handle_update_skips_webhook_when_disabled(self, intake, mocker):
        intake.connection_row["webhooks_disabled"] = True
        merged_row = {"id": "sku-123", "active": True}
        mocker.patch(
            "utils.event_intake.prepare_partial_update", return_value=merged_row
        )
        mocker.patch(
            "utils.event_intake.get_rows_for_dynamo_webhook",
            return_value=([merged_row], [merged_row]),
        )
        mock_store = mocker.patch("utils.event_intake.store_resources")
        mock_webhook = mocker.patch("utils.event_intake.write_pickle_to_s3")

        resource = MagicMock()
        intake._handle_update(resource, "sku-123", {"active": True})

        # store should still run - only the webhook is skipped when disabled
        mock_store.assert_called_once()
        mock_webhook.assert_not_called()


