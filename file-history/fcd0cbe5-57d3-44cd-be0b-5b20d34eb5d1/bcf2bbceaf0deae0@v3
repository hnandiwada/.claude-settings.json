class TestProcessHttp:
    # generic contract between process_http and any integration's verify_notification —
    # uses flexport as the example integration name for logging realism only.

    @pytest.fixture
    def http_intake(self, mocker):
        integration = MagicMock()
        integration.verify_notification.return_value = True
        integration.transform_notification.return_value = None

        intake = MagicMock()
        intake.integration = integration
        intake.integration_type = "wms"
        intake.integration_name = "flexport"

        mocker.patch("lambda_handlers.event_intake.EventIntake", return_value=intake)
        return intake

    def _event(self, headers=None, body=None):
        return {
            "requestContext": {"httpMethod": "POST"},
            "pathParameters": {"connection_id": CONNECTION_ID},
            "headers": headers if headers is not None else {},
            "body": body if body is not None else json.dumps({"event": "test"}),
        }

    def test_verify_called_with_payload_raw_body_and_headers(self, http_intake):
        headers = {"X-Trackstar-Webhook-Token": "abc"}
        body = json.dumps({"event": "test"})

        process_http(self._event(headers=headers, body=body))

        http_intake.integration.verify_notification.assert_called_once_with(
            {"event": "test"}, body, headers
        )

    def test_returns_401_and_skips_transform_when_verify_false(self, http_intake):
        http_intake.integration.verify_notification.return_value = False

        response = process_http(
            self._event(headers={"X-Trackstar-Webhook-Token": "bad"})
        )

        assert response["statusCode"] == 401
        assert json.loads(response["body"]) == {"error": "unauthorized"}
        http_intake.integration.transform_notification.assert_not_called()

    def test_proceeds_to_transform_when_verify_true(self, http_intake):
        http_intake.integration.verify_notification.return_value = True

        response = process_http(
            self._event(headers={"X-Trackstar-Webhook-Token": "good"})
        )

        assert response["statusCode"] == 200
        http_intake.integration.transform_notification.assert_called_once()
