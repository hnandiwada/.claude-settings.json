def wms_order():
    return {
        "id": "order_1",
        "warehouse_customer_id": "wc_1",
        "reference_id": "#1001",
        "status": "shipped",
        "ship_to_address": person_address(),
        "line_items": [
            {"product_id": "p_1", "sku": "sku_1", "quantity": 2, "unit_price": 9.99}
        ],
        "shipments": [
            {
                "shipment_id": "shipment_1",
                "warehouse_id": "wh_1",
                "line_items": [
                    {
                        "inventory_item_id": "item_1",
                        "sku": "sku_1",
                        "quantity": 2,
                        "parent_product_id": None,
                    }
                ],
                "ship_to_address": person_address(),
                "ship_from_address": warehouse_address(),
                "packages": [
                    {
                        "package_id": "package_1",
                        "tracking_number": "1Z999",
                        "line_items": [],
                    }
                ],
            }
        ],
        "tags": ["vip"],
        "trackstar_tags": [],
    }


def test_wms_order():
    order = wms_order()
    original = copy.deepcopy(order)

    redacted = redact_resource_pii(order)

    expected = wms_order()
    expected["ship_to_address"] = redacted_person_address()
    expected["shipments"][0]["ship_to_address"] = redacted_person_address()
    assert redacted == expected
    assert order == original


def test_wms_order_with_partial_address():
    order = wms_order()
    order["ship_to_address"]["address2"] = ""
    order["ship_to_address"]["address3"] = None
    order["ship_to_address"]["email_address"] = IntegrationNotImplemented

    redacted = redact_resource_pii(order)

    ship_to_address = redacted["ship_to_address"]
    assert ship_to_address["full_name"] == REDACTED
    assert ship_to_address["address1"] == REDACTED
    assert ship_to_address["address2"] == ""
    assert ship_to_address["address3"] is None
    assert ship_to_address["email_address"] is IntegrationNotImplemented


