class String(FieldMixin, StringField):
    fallback_example = None

    def __init__(
        self, desc: str = "", example: str = "", dont_strip: bool = False, **kwargs
    ):
        self.dont_strip = dont_strip
        validate = kwargs.get("validate", [])
        # OneOf stopped showing enums in meta response. Here we add them in manually
        for v in validate:
            if isinstance(v, RawOneOf):
                kwargs["enum"] = v.choices
        validate.append(validate_string_is_not_empty)
        kwargs["validate"] = validate
        kwargs["description"] = desc
        if example:
            kwargs["example"] = example
        super().__init__(**kwargs)

    def default_example(self, field_name, replacing=None):
        load_default = self.load_default
        if load_default is missing or not isinstance(load_default, str):
            load_default = None
        enum = self.metadata.get("enum")
        if is_placeholder_enum(enum):
            enum = None
        candidates = [
            same_option_in(enum, replacing),
            load_default,
            # min() used to ensure the same pick every time
            min(enum) if enum else None,
            self.fallback_example,
            field_name,
        ]
        for candidate in candidates:
            if candidate and self.example_is_allowed(candidate):
                return candidate
        return None

    def example_is_allowed(self, candidate):
        for validator in self.validators:
            # only the declarative validators
            if not isinstance(validator, (RawOneOf, Regexp, Length)):
                continue
            if isinstance(validator, RawOneOf) and is_placeholder_enum(
                validator.choices
            ):
                continue
            try:
                validator(candidate)
            except ValidationError:
                # test will fail and we can edit the individual example
                return False
        return True

    def _bind_to_schema(self, field_name, schema):
        super()._bind_to_schema(field_name, schema)
        given = self.metadata.get("example")
        if given and self.example_is_allowed(given):
            return
        example = self.default_example(field_name, replacing=given)
        if example:
            self.metadata["example"] = example
        else:
            self.metadata.pop("example", None)

    def deserialize(self, *args, **kwargs):
        original_value = args[0]
        stripped_value = get_real_string_value(original_value)
        if self.dont_strip:
            if stripped_value is None:
                value_to_use = None
            else:
                value_to_use = original_value
        else:
            value_to_use = stripped_value
        args_to_use = (value_to_use,) + args[1:]
        ret = super().deserialize(*args_to_use, **kwargs)
        return ret


class DateTime(String):
    fallback_example = "2023-03-15T13:45:30Z"

    def __init__(self, desc: str = "", example: str = "", **kwargs):
        metadata = kwargs.get("metadata", {})
        metadata["format"] = "date-time"
        kwargs["metadata"] = metadata

        def validate_iso8601_datetime(item):
            try:
                dt = datetime.fromisoformat(item)
                if not dt.tzinfo:
                    raise ValidationError("ISO8601 datetime must have a timezone.")
            except ValueError:
                raise ValidationError(f"Invalid ISO8601 datetime format for {item}")

        validate = kwargs.get("validate", [])
        validate.append(validate_iso8601_datetime)
        kwargs["validate"] = validate
        super().__init__(
            desc=desc,
            example=example,
            **kwargs,
        )

    def _deserialize(self, *args, **kwargs):
        ret = super()._deserialize(*args, **kwargs)
        try:
            dt = datetime.fromisoformat(ret)
        except ValueError:
            raise ValidationError(f"Invalid ISO8601 datetime format: {ret}")
        if not dt.tzinfo:
            raise ValidationError("ISO8601 datetime must have a timezone.")
        in_utc = dt_to_str(dt)
        return in_utc


class Date(String):
    fallback_example = "2023-03-15"

    def __init__(self, desc: str = "", example: str = "", **kwargs):
        metadata = kwargs.get("metadata", {})
        metadata["format"] = "date"
        kwargs["metadata"] = metadata

        def validate_date(item):
            try:
                datetime.strptime(item, "%Y-%m-%d")
            except ValueError:
                raise ValidationError("Invalid date format.")

        validate = kwargs.get("validate", [])
        validate.append(validate_date)
        kwargs["validate"] = validate
        super().__init__(
            desc=desc,
            example=example,
            **kwargs,
        )

    def _deserialize(self, *args, **kwargs):
        ret = super()._deserialize(*args, **kwargs)
        if "T" in ret:
            ret = ret.split("T")[0]
        return ret


