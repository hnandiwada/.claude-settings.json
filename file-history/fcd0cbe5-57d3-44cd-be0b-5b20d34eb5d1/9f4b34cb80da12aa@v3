def redact_pii(item):
    fields_to_redact = [
        "full_name",
        "name",
        "first_name",
        "last_name",
        "address1",
        "address2",
        "address3",
        "phone_number",
        "phone",
        "email_address",
        "email",
    ]
    resource_needs_redaction = "full_name" in item or "name" in item
    # otherwise it's not a PII address.
    # for example, inbound shipments have a "ship_from_address" that is the warehouse, not a person.
    result = {}
    for field_name, field_value in item.items():
        if isinstance(field_value, str):
            if (
                resource_needs_redaction
                and field_name in fields_to_redact
                and field_value
            ):
                field_value = REDACTED
        if isinstance(field_value, dict):
            field_value = redact_pii(field_value)
        elif isinstance(field_value, list):
            field_value = redact_pii_list(field_value)
        result[field_name] = field_value
    return result


def redact_pii_list(resources):
    redacted_resources = []
    for resource in resources:
        if isinstance(resource, dict):
            resource = redact_pii(resource)
        # shouldn't need to handle list of list
        redacted_resources.append(resource)
    return redacted_resources


