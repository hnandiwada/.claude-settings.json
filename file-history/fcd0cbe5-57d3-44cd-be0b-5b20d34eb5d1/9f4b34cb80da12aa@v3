def validate_task_payload(task, payload):
    from resources import Resource

    schema = {
        "submitter": {
            "resource": Resource,
            "first_crawl": bool,
            "start": str,
            "data": list,
        },
        "webhook": {
            "resource": Resource,
            "data": list,
        },
        "linked-refresh": {
            "resource": Resource,
            "data": list,
        },
    }
    if task not in schema:
        raise ValueError(f"Invalid task: {task}")
    for key, expected_type in schema[task].items():
        if key not in payload:
            raise ValueError(f"Missing required field '{key}' for task '{task}'")
        elif not isinstance(payload[key], expected_type):
            raise ValueError(
                f"Invalid type for field '{key}': expected {expected_type.__name__}, got {type(payload[key]).__name__}"
            )
