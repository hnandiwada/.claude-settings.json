class List(FieldMixin, ListField):
    def __init__(
        self,
        desc: str = "",
        example: list = [],
        obj=None,
        not_implemented_default=[],
        **kwargs,
    ):
        if not obj:
            raise ValueError("obj is required")
        init_args = {"cls_or_instance": obj, "description": desc}
        if example:
            init_args["example"] = example
        super().__init__(
            **init_args, not_implemented_default=not_implemented_default, **kwargs
        )


class CommaSeparatedList(FieldMixin, DelimitedListField):
    def __init__(self, desc: str = "", example: str = "", obj=None, **kwargs):
        if not obj:
            raise ValueError("obj is required")
        kwargs["delimiter"] = ","
        init_args = {"cls_or_instance": obj, "description": desc}
        if example:
            init_args["example"] = example
        super().__init__(**init_args, **kwargs)


class Dict(FieldMixin, DictField):
    def __init__(
        self,
        desc: str = "",
        example: dict = {},
        keys=None,
        values=None,
        not_implemented_default={},
        **kwargs,
    ):
        if not keys:
            raise ValueError("keys is required")
        if not values:
            raise ValueError("values is required")
        super().__init__(
            description=desc,
            example=example,
            keys=keys,
            values=values,
            not_implemented_default=not_implemented_default,
            **kwargs,
        )


class NestedSchema(FieldMixin, Nested):
    def __init__(self, schema_name, not_implemented_default={}, **kwargs):
        # build schema out of kwargs
        assert " " not in schema_name, "Schema name cannot contain spaces"
        kwargs = kwargs.copy()
        allow_none = kwargs.pop("allow_none", False)
        required = kwargs.pop("required", True)
        allow_not_implemented = kwargs.pop("allow_not_implemented", False)
        exclude = kwargs.pop("exclude", [])
        partial = kwargs.pop("partial", None)
        if partial:
            schema_name += "Partial"
        unknown = kwargs.pop("unknown", None)
        schema = Schema.from_dict(kwargs, name=schema_name)
        schema_instance = schema(partial=partial, unknown=unknown, exclude=exclude)
        super().__init__(
            schema_instance,
            not_implemented_default=not_implemented_default,
            allow_none=allow_none,
            required=required,
            allow_not_implemented=allow_not_implemented,
        )


