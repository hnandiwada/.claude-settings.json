def compare_with_base_schema(schema, base_schema, parent_field=""):
    required_fields = []
    optional_fields = []
    schema_specific_fields = {}
    base_fields = []
    # iterate through the base schema fields

    def traverse_nested(field, field_name):
        field_list = []
        for nested_field_name in field.schema.fields.keys():
            field_list.append(f"{field_name}.{nested_field_name}")
        type_schemas = {}
        if hasattr(field.schema, "type_schemas"):
            # for OneOfSchema
            type_schemas = field.schema.type_schemas
        for type_schema_class in type_schemas.values():
            type_schema = type_schema_class()
            for nested_field_name in type_schema.fields.keys():
                # TODO should this have another identifier for the shape?
                field_list.append(f"{field_name}.{nested_field_name}")
        return field_list

    for field_name, field in base_schema.fields.items():
        base_fields.append(field_name)
        if isinstance(field, Nested):
            field_list = traverse_nested(field, field_name)
            base_fields.extend(field_list)
        elif isinstance(field, List):
            if isinstance(field.inner, Nested):
                field_list = traverse_nested(field.inner, field_name)
                base_fields.extend(field_list)

    for field_name, field in schema.fields.items():
        current_field = f"{parent_field}.{field_name}" if parent_field else field_name
        # Check if the field/parent_field is in the base schema
        if current_field not in base_fields:
            schema_specific_fields[current_field] = field

        if isinstance(field, Nested):
            nested_required, nested_optional, nested_specific = (
                compare_with_base_schema(field.schema, base_schema, current_field)
            )
            required_fields.extend(nested_required)
            optional_fields.extend(nested_optional)
            schema_specific_fields.update(nested_specific)
            if current_field not in schema_specific_fields:
                if field.required:
                    required_fields.append(current_field)
                else:
                    optional_fields.append(current_field)
        elif isinstance(field, List):
            if isinstance(field.inner, Nested):
                nested_required, nested_optional, nested_specific = (
                    compare_with_base_schema(
                        field.inner.schema, base_schema, current_field
                    )
                )
                required_fields.extend(nested_required)
                optional_fields.extend(nested_optional)
                schema_specific_fields.update(nested_specific)
            if current_field not in schema_specific_fields:
                if field.required:
                    required_fields.append(current_field)
                else:
                    optional_fields.append(current_field)
        else:
            if current_field not in schema_specific_fields:
                if field.required:
                    required_fields.append(current_field)
                else:
                    optional_fields.append(current_field)

    return required_fields, optional_fields, schema_specific_fields


def resolve_mm_json_schema(schema):
    original_schema = deepcopy(schema)
    definitions = original_schema["definitions"]
    copied_definitions = deepcopy(definitions)
    # for handling doubly nested. like labels.labels.image_location etc.
    resolved_definitions = resolve_definitions(copied_definitions)
    ref = original_schema["$ref"]
    trimmed_ref = ref.removeprefix("#/definitions/")
    schema = definitions[trimmed_ref]
    properties = schema["properties"]
    for key in properties:
        value = properties[key]
        if "$ref" in value:
            ref = value["$ref"].removeprefix("#/components/schemas/")
            properties[key] = resolved_definitions[ref]
        elif "items" in value:
            if value["items"].get("$ref"):
                items_ref = value["items"]["$ref"].removeprefix("#/components/schemas/")
                properties[key]["items"] = resolved_definitions[items_ref]
    schema = remove_unwanted_schema_fields(schema)
    return schema


def resolve_definitions(definitions):
    cleaned_definitions = {}
    for outer_key, outer_value in definitions.items():
        properties = outer_value.get("properties", {})
        for key, value in properties.items():
            if "$ref" in value:
                ref = value["$ref"].removeprefix("#/components/schemas/")
                properties[key] = definitions[ref]
            elif "items" in value:
                if value["items"].get("$ref"):
                    items_ref = value["items"]["$ref"].removeprefix(
                        "#/components/schemas/"
                    )
                    properties[key]["items"] = definitions[items_ref]

        cleaned_definitions[outer_key] = remove_unwanted_schema_fields(outer_value)
    return cleaned_definitions


def resolve_api_spec_schema(schemas, schema_name):
    base_schema = schemas[schema_name]
    properties = base_schema.get("properties", {})
    for key in properties:
        value = properties[key]
        if "$ref" in value:
            ref = value["$ref"].removeprefix("#/components/schemas/")
            resolved_ref = resolve_api_spec_schema(schemas, ref)
            properties[key] = resolved_ref
        elif "items" in value:
            if "$ref" in value["items"]:
                items_ref = value["items"]["$ref"].removeprefix("#/components/schemas/")
                resolved_items_ref = resolve_api_spec_schema(schemas, items_ref)
                properties[key]["items"] = resolved_items_ref
        elif "allOf" in value:
            all_of = value.pop("allOf")
            description = value.pop("description", None)
            assert not value, "allOf should be the only key in the schema"
            assert len(all_of) == 1, "allOf should only have one item"
            all_of = all_of[0]
            if "$ref" not in all_of:
                raise Exception("allOf should have a $ref")
            all_of_ref = all_of["$ref"].removeprefix("#/components/schemas/")
            resolved_all_of_ref = resolve_api_spec_schema(schemas, all_of_ref)
            properties[key] = {"type": "object", "properties": resolved_all_of_ref}
            if description:
                properties[key]["description"] = description
    for i, one_of in enumerate(base_schema.get("oneOf", [])):
        if "$ref" in one_of:
            one_of_ref = one_of["$ref"].removeprefix("#/components/schemas/")
            resolved_one_of_ref = resolve_api_spec_schema(schemas, one_of_ref)
            base_schema["oneOf"][i] = resolved_one_of_ref

    base_schema = remove_unwanted_schema_fields(base_schema)
    return base_schema


def remove_unwanted_schema_fields(data):
    unwanted_field = ["allow_not_implemented", "additionalProperties", "discriminator"]
    for field in unwanted_field:
        if field in data:
            del data[field]
    # we cannot use required as a field name in our schemas since it is a reserved keyword used by NestedSchema
    if "required" in data:
        data["required_fields"] = data["required"]
        del data["required"]
    for _, value in data.items():
        if isinstance(value, dict):
            remove_unwanted_schema_fields(value)

    return data


## Validation functions


def is_upper(value):
    if value and value != value.upper():
        raise ValidationError("Must be all caps")
    return True


def is_digit(value):
    if value and not value.isdigit():
        raise ValidationError(f"Must be a number - got {value}")
    return True


def is_decimal(value):
    # isdecimal rejects superscript and other digit-like chars that isdigit accepts
    # but int() can't parse; use it to guard a value that will be int()-ed
    if value and not value.isdecimal():
        raise ValidationError(f"Must be a number - got {value}")
    return True


def max_length(str, max_length):
    if len(str) > max_length:
        raise ValidationError(
            f"String is too long. Max length is {max_length} characters."
        )
    return True


def greater_than_zero(value):
    if value <= 0:
        raise ValidationError(f"Value must be greater than 0 - got {value}")
    return True


def list_not_empty(value):
    if not value:
        raise ValidationError("List must not be empty")
    return True


# dynamo caps the IN operator at 100 operands, so in/nin filters must too
def list_within_in_limit(value):
    if len(value) > MAX_IN_OPERANDS:
        raise ValidationError(
            f"in/nin filters accept at most {MAX_IN_OPERANDS} values "
            f"(got {len(value)}); split your request into multiple calls"
        )
    return True


def same_state_country(body_state, body_country, rsp_state, rsp_country):
    body_codes = get_state_and_country_codes_from_input(
        body_state, body_country, should_fail=False
    )
    state_code, country_code = body_codes
    if state_code and "-" in state_code:
        state_code = state_code.split("-")[1]
    data_codes = get_state_and_country_codes_from_input(
        rsp_state, rsp_country, should_fail=False
    )
    rsp_state_code, rsp_country_code = data_codes
    if rsp_state_code and "-" in rsp_state_code:
        rsp_state_code = rsp_state_code.split("-")[1]
    if country_code:
        country_code = country_code.upper()
    if rsp_country_code:
        rsp_country_code = rsp_country_code.upper()
    assert country_code == rsp_country_code, (
        f"Country {country_code} does not match {rsp_country_code}"
    )
    if state_code:
        state_code = state_code.upper()
    if rsp_state_code:
        rsp_state_code = rsp_state_code.upper()
    assert state_code == rsp_state_code, (
        f"State {state_code} does not match {rsp_state_code}"
    )


