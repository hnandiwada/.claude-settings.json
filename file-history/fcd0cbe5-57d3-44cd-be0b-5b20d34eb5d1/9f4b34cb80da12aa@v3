PASSTHROUGH_FIELDS_NOTE = "Use this object to pass fields directly to the underlying API. You will have to read the API's documentation to know what fields are available, and cannot override fields that are managed by Trackstar."


class PassthroughFields:
    # use this to allow users to pass arbitrary fields to the underlying API.
    # we don't normalize or validate, but we also don't want them to be able to override fields we manage.
    # this class is a wrapper around a dict so that we can control how it is used.
    # the apply_to method is the only way to apply the direct fields to a target dict,
    # and it will raise an exception if there are any conflicts with managed fields.
    def __init__(self, fields):
        self.fields = dict(fields)

    def __repr__(self):
        return f"PassthroughFields({self.fields!r})"

    def __getattr__(self, name):
        # dunders are left to fail normally so copy/pickle machinery (deepcopy
        # probes __deepcopy__ etc.) still works; everything else points the dev
        # at apply_to instead of a bare AttributeError on .keys()/.get()/...
        if name.startswith("__"):
            raise AttributeError(name)
        raise AttributeError(
            f"PassthroughFields has no .{name}; it is not a dict. "
            f"call passthrough_fields.apply_to(target) to merge its fields"
        )

    def apply_to(self, target):
        conflicts = []
        for key in self.fields:
            if key in target:
                conflicts.append(key)
        if conflicts:
            raise PokedexException(
                f"passthrough_fields cannot override managed fields: {sorted(conflicts)}",
                400,
                origin="trackstar",
            )
        target.update(self.fields)
        return target


class PassthroughFieldsField(Dict):
    def _deserialize(self, *args, **kwargs):
        # validate keys=String / values=Raw first, then wrap so the result can't
        # be spread
        validated = super()._deserialize(*args, **kwargs)
        return PassthroughFields(validated)

    def _serialize(self, value, *args, **kwargs):
        # write-only field; if ever dumped, expose the plain dict
        if isinstance(value, PassthroughFields):
            value = value.fields
        return super()._serialize(value, *args, **kwargs)


def PASSTHROUGH_FIELDS(description="", **kwargs):
    description = description.strip()
    if not description:
        full_description = PASSTHROUGH_FIELDS_NOTE
    elif description.endswith("."):
        # caller already ended with a period, don't double up the ". "
        full_description = f"{description} {PASSTHROUGH_FIELDS_NOTE}"
    else:
        full_description = f"{description}. {PASSTHROUGH_FIELDS_NOTE}"
    return PassthroughFieldsField(
        desc=full_description,
        keys=String(),
        values=Raw(),
        required=False,
        example={"custom_field_1": "value1", "custom_field_2": 123},
        **kwargs,
    )


