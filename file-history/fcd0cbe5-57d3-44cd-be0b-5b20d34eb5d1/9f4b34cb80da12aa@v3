# parses the field[operator]=value query syntax (bare field => eq) for any
# schema built from allowed_operators; shared by resource list endpoints and
# other query endpoints that want the same filter UX
class OperatorQueryParams(Schema):
    @pre_load
    def normalize_operators(self, data, **kwargs):
        # parse ImmutableMultiDict to dict and join comma separated stuff
        data_as_dict = data.to_dict(flat=False)
        # handle data_keys. e.g. trackstar_tags_flat
        # is exposed on as trackstar_tags via data_key
        fields_by_data_key = {}
        for attr_name, field_obj in self.fields.items():
            wire_name = field_obj.data_key if field_obj.data_key else attr_name
            fields_by_data_key[wire_name] = field_obj
        # turns everything into lists
        data_object = {}
        for key, value in data_as_dict.items():
            match = re.match(r"^(.*)\[(.*)\]$", key)
            if match:
                field = match.group(1)
                operator = match.group(2)
            else:
                field = key
                operator = "eq"
            error_dict = {"parameter": field, "operator": operator}
            if field not in fields_by_data_key:
                raise ValidationError(f"Unsupported query parameter: {error_dict}")
            field_schema = fields_by_data_key[field]
            if isinstance(field_schema, Nested):
                allowed_operators = []
                for nested_field in field_schema.schema.fields.values():
                    if nested_field.data_key:
                        allowed_operators.append(nested_field.data_key)
                    else:
                        allowed_operators.append(nested_field.name)
                if operator not in allowed_operators:
                    raise ValidationError(f"Unsupported query parameter: {error_dict}")
                field_dict = data_object.get(field, {})
                field_dict[operator] = ",".join(value)
                data_object[field] = field_dict
            else:
                if operator != "eq":
                    raise ValidationError(f"Unsupported query parameter: {error_dict}")
                data_object[field] = ",".join(value)
        return data_object

    @post_load
    def wrap_operators(self, data, **kwargs):
        js_data = json.loads(json.dumps(data))
        parsed_params = {}
        for key, value in js_data.items():
            if not isinstance(value, dict):
                parsed_params[key] = {"eq": value}
            else:
                nested_fields = self.fields[key].schema.fields
                parsed_value = {}
                for nested_key, nested_value in value.items():
                    nested_field = nested_fields[nested_key]
                    nested_field_data_key = nested_field.name
                    if nested_field.data_key:
                        nested_field_data_key = nested_field.data_key
                    parsed_value[nested_field_data_key] = nested_value
                parsed_params[key] = parsed_value
        return parsed_params


