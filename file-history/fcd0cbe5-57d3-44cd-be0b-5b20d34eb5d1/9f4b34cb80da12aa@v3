def validate_tag(items):
    """Validator to ensure each item in the list is either a string or a single key-value pair dictionary."""
    for item in items:
        if not isinstance(item, (str, dict)):
            raise ValidationError(
                "Each tag must be either a string or a dictionary with one key-value pair."
            )
        if isinstance(item, dict) and len(item) != 1:
            raise ValidationError(
                "Dictionary tags must contain exactly one key-value pair."
            )


