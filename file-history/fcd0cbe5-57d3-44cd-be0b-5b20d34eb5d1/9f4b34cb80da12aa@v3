class IntegrationRequestBodyEntry(Schema):
    url = String("Outbound URL")
    method = String("HTTP method", "POST")
    body = Raw(allow_none=True)


def validate_integration_request_bodies(integration):
    if not integration:
        return []
    entries = integration.sanitized_request_bodies()
    schema = IntegrationRequestBodyEntry()
    try:
        return schema.load(entries, many=True, unknown="exclude")
    except ValidationError as e:
        logger.warning(
            f"Dropping invalid integration request body entries: {e.messages}"
        )
        invalid_indices = set(e.messages.keys())
        valid = []
        for idx, item in enumerate(e.valid_data):
            if idx not in invalid_indices:
                valid.append(item)
        return valid


