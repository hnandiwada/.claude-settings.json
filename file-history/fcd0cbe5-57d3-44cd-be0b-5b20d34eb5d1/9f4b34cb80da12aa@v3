class FieldMixin(Field):
    def __init__(self, *args, not_implemented_default=None, **kwargs):
        kwargs = self.set_default_on_init(not_implemented_default, **kwargs)
        super().__init__(*args, **kwargs)

    def set_default_on_init(self, not_implemented_default=None, **kwargs):
        kwargs.setdefault("required", True)
        allow_none = kwargs.get("allow_none", False)
        allow_not_implemented = kwargs.get("allow_not_implemented", False)
        if allow_not_implemented:
            if not_implemented_default is None:
                if "allow_none" in kwargs and not allow_none:
                    # TRA-734
                    raise Exception(
                        "allow_not_implemented requires allow_none to be True"
                    )
                allow_none = True
        kwargs["allow_none"] = allow_none
        kwargs["allow_not_implemented"] = allow_not_implemented
        self.allow_not_implemented = allow_not_implemented
        self.not_implemented_default = not_implemented_default
        # when you override "validators" it becomes not JSON serializable
        validators_msg = (
            "Don't override `validators`! You probably meant to override `validate`."
        )
        assert "validators" not in kwargs, validators_msg
        validate = kwargs.get("validate", [])
        assert isinstance(validate, list), "validate must be a list"
        kwargs["validate"] = validate
        default_msg = "Don't override `default`, `missing` or `dump_default`! You probably meant to override `load_default`."
        assert "default" not in kwargs, default_msg
        assert "missing" not in kwargs, default_msg
        assert "dump_default" not in kwargs, default_msg
        if "load_default" in kwargs:
            assert kwargs["required"] is False, (
                "required should be False if default is set"
            )
            kwargs["default"] = kwargs["load_default"]
            # for showing up in the meta response

        return kwargs

    def _serialize(self, value, *args, **kwargs):
        if isinstance(value, IntegrationNotImplementedClass):
            return self.not_implemented_default
        return super()._serialize(value, *args, **kwargs)

    def deserialize(self, value, *args, **kwargs):
        if isinstance(value, IntegrationNotImplementedClass):
            if self.allow_not_implemented:
                return self.not_implemented_default
            raise ValidationError("Field must be implemented")
        return super().deserialize(value, *args, **kwargs)


class IntegrationNotImplementedClass:
    def __bool__(self):
        return False

    # instances get copied by deepcopy and rebuilt on deserialize, so identity can't
    # be relied on when one of these is used as a dict key
    def __eq__(self, other):
        return isinstance(other, IntegrationNotImplementedClass)

    def __hash__(self):
        return hash(IntegrationNotImplementedClass)


IntegrationNotImplemented = IntegrationNotImplementedClass()


def load_not_implemented(obj, implemented_dict):
    for key, value in obj.items():
        if key not in implemented_dict:
            continue
        if key == "trackstar_tags":
            continue
        impl_value = implemented_dict[key]
        if not value and impl_value == False:
            obj[key] = IntegrationNotImplemented
            continue
        if isinstance(value, dict):
            if isinstance(impl_value, dict):
                load_not_implemented(value, impl_value)
            elif not impl_value:
                if not value:
                    obj[key] = IntegrationNotImplemented
                else:
                    all_keys_null = True
                    for v in value.values():
                        if v is not None:
                            all_keys_null = False
                            break
                    if all_keys_null:
                        obj[key] = IntegrationNotImplemented
            else:
                obj[key] = value
        elif isinstance(value, list):
            returned_list = []
            for item in value:
                if isinstance(item, dict):
                    if impl_value and isinstance(impl_value[0], dict):
                        load_not_implemented(item, impl_value[0])
                else:
                    if impl_value:
                        if not item and not impl_value[0]:
                            item = IntegrationNotImplemented
                returned_list.append(item)
            obj[key] = returned_list


def same_option_in(choices, value):
    # if example has different capitalization, correct it
    if not choices or not value:
        return None
    wanted = re.sub(r"[^a-z0-9]", "", value.lower())
    for choice in sorted(choices):
        if not isinstance(choice, str):
            continue
        if re.sub(r"[^a-z0-9]", "", choice.lower()) == wanted:
            return choice
    return None


def is_placeholder_enum(choices):
    # filter out some placeholders
    if not choices:
        return False
    for choice in choices:
        if not isinstance(choice, str):
            return False
        text = choice.lower()
        if "connect an account" not in text and not text.startswith("n/a"):
            return False
    return True


def string_is_empty(item):
    if item is None:
        return True
    if not isinstance(item, str):
        return False
    item = item.strip()
    if item.lower() == "none":
        return True
    if item.lower() == "null":
        return True
    if item == "":
        return True
    return False


def validate_string_is_not_empty(item):
    if string_is_empty(item):
        raise ValidationError("String may not be empty.")
    return item


def get_real_string_value(item):
    if string_is_empty(item):
        return None
    if isinstance(item, str):
        return item.strip()
    return item


