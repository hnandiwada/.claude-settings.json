def hydrate_index_page(resource, index_items):
    # index rows are thin projections, so we refill them from the main table.
    # we stop at the cap: pulling a whole page of big rows timed requests out
    ids_to_get = [item["id"] for item in index_items]
    hydrated = []
    running_size = 0
    for start in range(0, len(ids_to_get), BATCH_GET_KEY_CHUNK):
        chunk = ids_to_get[start : start + BATCH_GET_KEY_CHUNK]
        fetched = resource.batch_get_resources(chunk)
        # batch_get does not preserve order, and the next token comes off the
        # last row we keep, so put the page back in the order ddb walked it
        fetched_by_id = {item["id"]: item for item in fetched}
        chunk_rows = [fetched_by_id[id_] for id_ in chunk if id_ in fetched_by_id]
        hydrated.extend(chunk_rows)
        running_size += len(json.dumps(chunk_rows, default=str).encode("utf-8"))
        if running_size > MAX_API_RESPONSE_BYTES:
            return hydrated, True
    return hydrated, False


def api_get_resources(resource_type, query_params):
    # for use by the API
    integration = request.environ["integration"]
    resource = resource_type(integration)
    connection_id = request.environ["connection_id"]

    table_name = resource.table_name()

    # if list of ids is provided, we ignore the rest of the query params
    if "ids" in query_params:
        ids = query_params["ids"]
        for value in ids.values():
            ids = value if isinstance(value, list) else [value]
        response = resource.batch_get_resources(ids)
        last_key = None
        items = response
    else:
        dynamo_args, filters = create_dynamo_args(
            table_name, connection_id, query_params=query_params
        )
        try:
            response = query(table_name, dynamo_args, filters)
        except ClientError as e:
            if e.response["Error"]["Code"] in (
                "ThrottlingException",
                "RequestLimitExceeded",
            ):
                raise ThrottleException(integration.integration_name, 1)
            raise e

        last_key = response.get("LastEvaluatedKey")
        items = response["Items"]
        stopped_early = False
        if dynamo_args.get("IndexName"):
            # see utils.boto.get_all_resources/get_resources_single_page
            items, stopped_early = hydrate_index_page(resource, items)
        running_size = len(json.dumps(items, default=str).encode("utf-8"))
        # over the byte cap, or stopped short of the page: either way the index's
        # own last key is wrong, so rebuild the next token off the last row kept
        if (running_size > MAX_API_RESPONSE_BYTES or stopped_early) and len(items) > 1:
            # key_fields is the schema we use to rebuild
            # last evaluated key if it's manually set.
            # e.g. for an index query on updated_date,
            # key_fields = ["connection_id", "id", "updated_date"]
            # and the rebuilt last_key looks like
            # {"connection_id": "abc", "id": "42", "updated_date": "2026-..."}.
            # if no index, will just be connection_id and id
            meta = get_table_meta(table_name)
            if last_key is not None:
                key_fields = list(last_key.keys())
            else:
                key_fields = [k["AttributeName"] for k in meta["key_schema"]]
                if dynamo_args.get("IndexName"):
                    for idx in meta["global_secondary_indexes"]:
                        if idx["IndexName"] != dynamo_args["IndexName"]:
                            continue
                        for k in idx["KeySchema"]:
                            if k["AttributeName"] not in key_fields:
                                key_fields.append(k["AttributeName"])
            while running_size > MAX_API_RESPONSE_BYTES and len(items) > 1:
                # estimate how many items to drop
                target_count = max(
                    1,
                    int(len(items) * MAX_API_RESPONSE_BYTES / running_size),
                )
                if target_count >= len(items):
                    target_count = len(items) - 1
                del items[target_count:]
                running_size = len(json.dumps(items, default=str).encode("utf-8"))
            last_key = {field: items[-1][field] for field in key_fields}
        start_time = time.time()
        cur_time = start_time
        limit_size = MIN_API_RETURN_SIZE
        if query_params.get("limit"):
            limit_size = query_params["limit"]["eq"]
        api_return_size = min(limit_size, MIN_API_RETURN_SIZE)
        while (
            last_key is not None
            and len(items) < api_return_size
            and cur_time - start_time < MAX_API_GET_DURATION
            and running_size < MAX_API_RESPONSE_BYTES
        ):
            dynamo_args["ExclusiveStartKey"] = last_key
            dynamo_args["Limit"] = api_return_size - len(items)
            try:
                response = query(table_name, dynamo_args, filters)
            except ClientError as e:
                if e.response["Error"]["Code"] in (
                    "ThrottlingException",
                    "RequestLimitExceeded",
                ):
                    raise ThrottleException(integration.integration_name, 1)
                raise e
            page_items = response["Items"]
            if dynamo_args.get("IndexName"):
                page_items, stopped_early = hydrate_index_page(resource, page_items)
                if stopped_early:
                    # this page alone fills a response, so leave it for next time
                    break
            new_items_size = len(json.dumps(page_items, default=str).encode("utf-8"))
            if running_size + new_items_size > MAX_API_RESPONSE_BYTES:
                break
            running_size += new_items_size
            last_key = response.get("LastEvaluatedKey")
            items.extend(page_items)
            cur_time = time.time()

    next_token = None
    if last_key is not None:
        next_token = base64.b64encode(json.dumps(last_key).encode("utf-8")).decode(
            "utf-8"
        )

    reconstituted_items = []
    for item in items:
        item = dynamo_to_dict(item)
        del item["connection_id"]
        reconstituted_items.append(item)
    items = reconstituted_items
    api_response = OrderedDict()
    api_response["data"] = items
    api_response["total_count"] = len(items)
    api_response["next_token"] = next_token
    return api_response


def api_get_resource(resource_type, item_id):
    integration = request.environ["integration"]
    resource = resource_type(integration)
    connection_id = request.environ["connection_id"]
    table_name = resource.table_name()

    dynamo_args, filters = create_dynamo_args(table_name, connection_id, item_id)
    try:
        query_rsp = query(table_name, dynamo_args, filters)
    except ClientError as e:
        if e.response["Error"]["Code"] in (
            "ThrottlingException",
            "RequestLimitExceeded",
        ):
            raise ThrottleException(integration.integration_name, 1)
        raise e
    if not query_rsp["Items"]:
        raise ResourceNotFoundException(resource, item_id)

    item = dynamo_to_dict(query_rsp["Items"][0])
    del item["connection_id"]
    api_response = {"data": item}

    to_return = best_effort_load(
        resource.validate_single_item_endpoint,
        resource.single_item_endpoint_schema,
        api_response,
    )
    return to_return


def cleanup_meta_schema(schema):
    if "example" in schema:
        del schema["example"]
    if "allow_not_implemented" in schema:
        del schema["allow_not_implemented"]
    if "allOf" in schema:
        if len(schema["allOf"]) == 1:
            schema["$ref"] = schema["allOf"][0]["$ref"]
            del schema["allOf"]
    for key, value in schema.items():
        if isinstance(value, dict):
            cleanup_meta_schema(value)
        elif isinstance(value, list):
            for v in value:
                if isinstance(v, dict):
                    cleanup_meta_schema(v)
    return schema


def connection_meta_endpoint(resource_type, action_type):
    integration = request.environ["integration"]
    resource = resource_type(integration)
    action = action_type(resource)

    schema = action.input_schema()
    apispec = APISpec(
        title="dummy",
        version="1.0.0",
        openapi_version=OPENAPI_VERSION,
        plugins=[
            MarshmallowPlugin(schema_name_resolver=lambda sch: sch.__class__.__name__)
        ],
    )
    schema_name = schema.__class__.__name__
    apispec.components.schema(schema_name, schema=schema)
    apispec_schemas = apispec.to_dict()["components"]["schemas"]
    cleaned = cleanup_meta_schema(apispec_schemas)
    # TODO deprecate
    to_return = {"$ref": f"#/definitions/{schema_name}", "definitions": cleaned}
    sorted_return = recursively_sort_dict_keys(to_return)
    return sorted_return


def recursively_sort_dict_keys(d):
    # can remove this when we deprecate
    """
    Recursively sorts the keys of a dictionary and any nested dictionaries.
    Returns a new dictionary with sorted keys.
    """
    if not isinstance(d, dict):
        return d  # Return non-dict values as-is

    sorted_items = sorted(d.items())  # Sort items by key
    sorted_dict = {}
    for key, value in sorted_items:
        sorted_dict[key] = recursively_sort_dict_keys(value)  # Recurse for nested dicts
    return sorted_dict


def parse_request_body() -> dict:
    if not request.headers.get("Content-Type"):
        raise PokedexException("Content-Type header required", 400, origin="trackstar")
    content_type = request.headers["Content-Type"].lower()
    if "application/json" in content_type:
        return request.get_json(silent=True) or {}
    if "multipart/form-data" in content_type:
        body = request.form.to_dict()
        if request.files:
            body.update(request.files)
        return body
    raise PokedexException("Unsupported content type", 415, origin="trackstar")


def tag_write_function(action):
    # tag before the first log line so every line for the request carries @function.
    # best-effort: resolving raises for e.g. unimplemented writes — skip the tag and
    # let action.run() re-raise that where it's handled, after the body is logged
    try:
        tags = {"function": action.function().__name__}
    except Exception:
        return
    logger.updateConfig(tags)
    tracer.set_tags(tags)


def run_action(action, loaded_body, item_id=None):
    action.set_skip_retrieval(loaded_body)
    body_to_pass = copy.deepcopy(loaded_body)
    args = []
    if "body" in action.run_args():
        args.append(body_to_pass)
    if "item_id" in action.run_args():
        args.append(item_id)
    return action.run(*args)


def validate_write_body(integration, action, body):
    # a write schema may call the vendor to build its choices, so the same
    # translations the write itself gets apply here
    try:
        assert_write_function_enabled(integration, action)
        # generally duplicated in base_test.py write_and_validate
        return action.validate_body(body)
    except (PermissionsException, InvalidCredentialsException) as e:
        handle_perm_cred_err(e, action.resource, request.method)
        raise Exception("unreachable")
    except AssertionError as e:
        raise PokedexException(str(e), 422, origin="trackstar")


def inject_trackstar_bookkeeping(item, existing, resource, body=None):
    # post-write fields write_item and write_items add per item (created_date,
    # trackstar_*). `existing` is the prior dynamo row if any; `body` is the
    # request body when single-item writes can pass trackstar_tags through it
    # (e.g. the AddTrackstarTag action).
    if "created_date" not in item:
        if existing:
            item["created_date"] = existing["created_date"]
        else:
            item["created_date"] = EPOCH
    if "updated_date" not in item:
        item["updated_date"] = item["created_date"]
    now_str = dt_to_str(now())
    item["trackstar_created_date"] = now_str
    item["trackstar_updated_date"] = now_str
    if not AddTrackstarTag(resource).is_implemented():
        return
    if "trackstar_tags" in item:
        return
    if body is not None and "trackstar_tags" in body:
        item["trackstar_tags"] = body["trackstar_tags"]
    elif existing:
        # sandbox doesn't start with trackstar_tags
        item["trackstar_tags"] = existing.get("trackstar_tags")
    else:
        item["trackstar_tags"] = None


