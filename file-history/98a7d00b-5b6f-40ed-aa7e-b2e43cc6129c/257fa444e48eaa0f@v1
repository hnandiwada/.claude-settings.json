            return wrapper

        return decorator

    # trackstar owns the tags, so the body is the same for every integration
    if isinstance(action, AddTrackstarTag):
        tag_input_schema = action.input_schema()
        tag_input_schema.load = lambda data, **kwargs: data
        return decorate(tag_input_schema)

    integration_type_schemas = {}
    integration_names = sorted(list_integration_names(integration_type))
    # sandbox goes first so it is the tab the docs open on
    if "sandbox" in integration_names:
        integration_names.remove("sandbox")
        integration_names.insert(0, "sandbox")
    for integration_name in integration_names:
        integration_file = get_integration_file(integration_name, integration_type)
        integration = integration_file.Integration()
        integration_action = action.__class__(resource.__class__(integration))
        if not integration_action.is_implemented():
            continue
        display_name = integration.get_display_name()
        # used in update_openapi_spec — only [a-zA-Z0-9._-] survives the
        # openapi 3.1 component-name pattern, so & needs an encoded form
        replaced_display_name = (
            display_name.replace(" ", "__")
            .replace("(", "-_")
            .replace(")", "_-")
            .replace("&", "_AMP_")
        )
        formatted_display_name = "--" + replaced_display_name + "--"
        action_input_schema = integration_action.input_schema()
        action_input_schema.load = lambda data, **kwargs: data
        input_name = f"{integration_action.__class__.__name__}{integration_type}{singular}{formatted_display_name}Schema"
        action_input_schema.__class__.__name__ = input_name
        action_input_schema.context["integration_name"] = integration_name
        integration_type_schemas[integration_name] = action_input_schema

    # no integration writes this yet, so show the shape we plan to support
    if not integration_type_schemas:
        base_input_schema = action.base_input_schema(unknown="include")
        base_input_schema.load = lambda data, **kwargs: data
        return decorate(base_input_schema)

    class InputSchema(OneOfSchema):
        type_schemas = integration_type_schemas

    InputSchema.__name__ = (
        f"{action.__class__.__name__}{integration_type}{singular}InputSchema"
    )
    full_input_schema = InputSchema()
    full_input_schema.load = lambda data, **kwargs: data
    return decorate(full_input_schema)


def decorate_cancel_endpoint(api, resource_type):
    resource_obj = resource_type()
    action = Cancel(resource_obj)
    integration_type = resource_obj.get_integration_type()
    response_schema = action.response_schema()

    def decorator(func):
        @wraps(func)
        @api.input(WriteHeaderSchema(), location="headers")
        @api.output(response_schema)
        @api.doc(tags=[integration_type, resource_obj.english_plural_name()])
        def wrapper(*args, **kwargs):
            return func(*args, **kwargs)

        return wrapper

    return decorator


def decorate_fulfill_endpoint(api, resource_type):
    resource_obj = resource_type()
    integration_type = resource_obj.get_integration_type()
    condensed_plural_name = resource_obj.english_plural_name().replace(" ", "")
    single_item_endpoint_schema = resource_obj.single_item_endpoint_schema()
    single_item_endpoint_schema.fields["data"].schema.fields["status"] = String(
        "The status of the object after fulfillment.", "fulfilled"
    )
    single_item_endpoint_schema.__class__.__name__ = (
        f"{condensed_plural_name}FulfillResponse"
    )
    data_schema = single_item_endpoint_schema.fields["data"].schema
    data_schema.__class__.__name__ = f"Fulfill{data_schema.__class__.__name__}"

    def decorator(func):
        @wraps(func)
        @api.input(APIAndAccessTokenHeaderSchema(), location="headers")
        @api.output(single_item_endpoint_schema)
        @api.doc(tags=[integration_type, resource_obj.english_plural_name()])
        def wrapper(*args, **kwargs):
            return func(*args, **kwargs)

        return wrapper

    return decorator


def api_sync_connection(connection_id, functions_to_sync=[]):
    try:
        connection = get_connections_row(connection_id)
        connection_schedulers = get_connection_scheduler_rows(connection["id"])
        connection_type = connection["integration_type"]
        integration_file = get_integration_file(
            connection["integration_name"], connection_type
        )
        integration = integration_file.Integration()
        org_row = get_org_row(connection["org_id"])
        # a disabled function must not sync, even on a manual/force sync. its scheduler row
        # can linger from before it was disabled, so skip it here as the scheduler does.
        disabled_functions = resolve_disabled_functions(
            connection, org_row, connection["integration_name"], connection_type
        )
        for schedule in connection_schedulers:
            function_name = schedule["function_name"]
            # if functions are specified, only sync those functions
            if functions_to_sync and function_name not in functions_to_sync:
                continue
            # don't force sync if crawl in progress
            resource = function_to_resource_map[connection_type][function_name](
                integration
            )
            if resource.is_function_disabled(disabled_functions):
                continue
            crawl_frequency = connection["crawl_frequencies"].get(
                function_name, resource.crawl_frequency()
            )
            # handle dynamo's Decimal type
            crawl_frequency = int(crawl_frequency)
            update_crawl_items(
                connection_id, function_name, {"force_sync_pending": True}
            )
            started = crawl_started(schedule)
            active = crawl_heartbeat_active(schedule)
            if started and active:
                continue
            latest_data = schedule.get("latest_data")
            last_enqueued = schedule.get("last_enqueued")
            function_name = schedule["function_name"]
            if last_enqueued and last_enqueued > dt_to_str(
                now() - timedelta(seconds=120)
            ):
                continue
            enqueue_crawl_task(
                {
                    "connection_row": connection,
                    "org_row": org_row,
                    "function_name": function_name,
                    "first_crawl": False,
                    "start_time_str": latest_data,
                    "end_time_str": None,
                    "page_token": None,
                    "resuming": False,
                    "force": True,
                }
            )
    except Exception:
        raise PokedexException("Error syncing connection", 500, origin="trackstar")
    return {
        "id": connection_id,
        "syncing": True,
        "functions_to_sync": functions_to_sync,
    }


def api_get_connection_schedules(connection_id, org_id):
    org_row = get_org_row(org_id)
    connection = get_connections_row(connection_id)
    connection_type = connection["integration_type"]
    scheduler_rows = get_connection_scheduler_rows(connection_id)
    integration_file = get_integration_file(
        connection["integration_name"], connection_type
    )
    integration = integration_file.Integration()
    visible_rows = []
    for row in scheduler_rows:
        function_name = row["function_name"]
        resource = function_to_resource_map[connection_type][function_name](integration)
        if resource.is_hidden():
            continue
        visible_rows.append(row)
        row["resource_name"] = resource.english_plural_name()
        row["crawl_frequency"] = resolve_crawl_frequency(
            connection, org_row, resource, function_name
        )
        # add sync status
        connection_errors = get_connection_errors(connection_id)
        sync_status = get_sync_status(row, connection_errors, resource.endpoint_base())
        row["sync_status"] = sync_status
        # tasks_started + tasks_finished are non serializable sets and not needed
        if "submit" in row:
            del row["submit"]

    return visible_rows


def api_direct_get(resource_type, item_id):
    integration = request.environ["integration"]
    resource: Resource = resource_type(integration)
    get_fn = resource.get_function()
    rsp = get_fn(item_id)
    to_return = best_effort_load(
        resource.validate_pass_through,
        resource.single_item_endpoint_schema,
        rsp,
    )
    return to_return


def get_sync_status(schedule_row, connection_errors, resource_endpoint):
    last_enqueued = schedule_row.get("last_enqueued")
    last_crawl_end = schedule_row.get("last_crawl_end")
    latest_data = schedule_row.get("latest_data")
    sync_status = "enabled"
    if schedule_row.get("paused"):
        sync_status = "disabled"
    elif schedule_row.get("stuck"):
        sync_status = "stuck"
    elif not latest_data or (last_enqueued and not last_crawl_end):
        sync_status = "first_sync_in_progress"
    elif last_enqueued and last_crawl_end and last_enqueued > last_crawl_end:
        sync_status = "sync_in_progress"
    # check if sync error exists
    for error in connection_errors:
        for affected_endpoint in error["affected_endpoints"]:
            error_resource_name = affected_endpoint["endpoint"].split("/")[2]
            if (
                error_resource_name == resource_endpoint
                and affected_endpoint["preventing_sync"]
            ):
                sync_status = "error"
                break
    return sync_status


def get_available_on_demand_sync_functions(integration):
    integration_type = integration.integration_type
    function_map = function_to_resource_map.get(integration_type, {})
    available = []
    for function_name, resource_type in function_map.items():
        if not integration.is_implemented(function_name):
            continue
        resource = resource_type(integration)
        if resource.allow_on_demand_sync():
            available.append(function_name)
    return available


def api_create_on_demand_sync(
    connection_id, start_time_str, end_time_str, function_name
):
    if start_time_str >= end_time_str:
        raise PokedexException(
            "start_time must be before end_time", 400, origin="trackstar"
        )

    connection = get_connections_row(connection_id)
    if not connection:
        raise PokedexException("Connection not found", 404, origin="trackstar")

    org_id = connection["org_id"]
    integration_type = connection["integration_type"]
    integration_name = connection["integration_name"]

    integration_file = get_integration_file(integration_name, integration_type)
    integration = integration_file.Integration()
    if not integration.is_implemented(function_name):
        raise PokedexException(
            f"Function {function_name} is not implemented for {integration_name}",
            400,
            origin="trackstar",
        )
    org_row = get_org_row(org_id)
    disabled_functions = resolve_disabled_functions(
        connection, org_row, integration_name, integration_type
    )
    if function_name in disabled_functions:
        raise PokedexException(
            f"Function {function_name} is disabled for this connection",
            400,
            origin="trackstar",
        )
    resource_type = function_to_resource_map[integration_type].get(function_name)
    if resource_type:
        empty_resource = resource_type()
        try:
            # for resources like inventory that don't support on-demand sync at all
            # want to say something nicer. TRA-1948
            resource_universally_blocked = False
            if not empty_resource.allow_on_demand_sync():
                resource_universally_blocked = True
        except Exception:
            resource_universally_blocked = False
        if resource_universally_blocked:
            raise PokedexException(
                f"On-demand sync is not enabled for {function_name} in general. On-demand sync is not useful for this resource type, and is not supported for any connection.",
                400,
                origin="trackstar",
            )
        resource = resource_type(integration)
        if not resource.allow_on_demand_sync():
            raise PokedexException(
                f"On-demand sync is not enabled for {integration_name} {function_name}",
                400,
                origin="trackstar",
            )
    existing_jobs = get_sync_jobs_for_connection(
        connection_id, function_name=function_name, status="open"
    )
    if existing_jobs:
        raise PokedexException(
            f"An open sync job already exists for {function_name}. "
            "Please wait for it to complete or cancel it first.",
            400,
            origin="trackstar",
        )

    created_at_str = dt_to_str(now())

    job_id = str(uuid.uuid4())
    job_data = {
        "id": job_id,
        "connection_id": connection_id,
        "org_id": org_id,
        "function_name": function_name,
        "status": "open",
        "requested_start_time": start_time_str,
        "requested_end_time": end_time_str,
        "created_at": created_at_str,
    }
    create_sync_job(job_data)
    record_event(
        org_id,
        "on_demand_sync_started",
        integration_name,
        integration_type,
        connection_id=connection_id,
        customer_id=connection.get("customer_id"),
        additional_fields={
            "function_name": function_name,
            "requested_start_time": start_time_str,
            "requested_end_time": end_time_str,
        },
    )

    return {
        "data": {
            "id": job_id,
            "connection_id": connection_id,
            "function_name": function_name,
            "status": "open",
            "requested_start_time": start_time_str,
            "requested_end_time": end_time_str,
            "created_at": created_at_str,
        }
    }


def api_get_on_demand_sync(connection_id, sync_id):
    sync_job = get_sync_job(sync_id)
    if not sync_job:
        raise PokedexException("Sync job not found", 404, origin="trackstar")
    if sync_job["connection_id"] != connection_id:
        raise PokedexException("Sync job not found", 404, origin="trackstar")
    return {"data": sync_job}


def api_list_on_demand_syncs(connection_id):
    sync_jobs = get_sync_jobs_for_connection(connection_id)
    return {"data": sync_jobs}


def api_cancel_on_demand_sync(connection_id, sync_id):
    sync_job = get_sync_job(sync_id)
    if not sync_job:
        raise PokedexException("Sync job not found", 404, origin="trackstar")
    if sync_job["connection_id"] != connection_id:
        raise PokedexException("Sync job not found", 404, origin="trackstar")
    if sync_job["status"] != "open":
        raise PokedexException(
            "Only open sync jobs can be cancelled", 400, origin="trackstar"
        )
    cancelled_at_str = dt_to_str(now())
    update_sync_job(
        sync_id,
        {"status": "cancelled", "cancelled_at": cancelled_at_str, "stale": False},
    )
    sync_job["status"] = "cancelled"
    sync_job["cancelled_at"] = cancelled_at_str
    sync_job["stale"] = False
    # the cancel already committed; the connection is fetched only for the event,
    # so a concurrent delete must not fail the request. record_event itself is
    # best-effort, so only the lookup needs guarding.
    try:
        connection = get_connections_row(connection_id)
    except Exception as e:
        connection = None
        logger.error(
            f"failed to load connection for cancel event: {format_exception(e)}"
        )
    if connection:
        record_event(
            connection["org_id"],
            "on_demand_sync_cancelled",
            connection["integration_name"],
            connection["integration_type"],
            connection_id=connection_id,
            customer_id=connection.get("customer_id"),
            additional_fields={
                "function_name": sync_job["function_name"],
                "requested_start_time": sync_job["requested_start_time"],
                "requested_end_time": sync_job["requested_end_time"],
            },
        )
    return {"data": sync_job}
