def update_openapi_spec(spec, test=False, skip_webhooks=False):
    def find_original_name(schema_name):
        match = re.match(r"^(.*?)(\d+)?$", schema_name)
        if match:
            original_name, suffix = match.group(1), match.group(2)
            return original_name
        return schema_name

    def update_component(component):
        if isinstance(component, dict):
            # keys = list(component.keys()) # TODO remove these comments when nullable object better supported
            # for key in keys:
            for key, value in component.items():
                # value = component[key]
                # if key == "anyOf":
                #     if len(value) == 2:
                #         original_name = None
                #         nullable = False
                #         for item in value:
                #             if "$ref" in item:
                #                 ref = item["$ref"]
                #                 original_name = find_original_name(ref.split("/")[-1])
                #             if "type" in item and item.get("nullable"):
                #                 nullable = True
                #         if nullable and original_name:
                #             component["allOf"] = [{"$ref": f"#/components/schemas/{original_name}"}]
                #             component["nullable"] = True
                #             del component["anyOf"]
                # elif key in ["$ref", "id", "name"] and isinstance(value, str):
                if key in ["$ref", "id", "name"] and isinstance(value, str):
                    if not value.startswith("#/components/schemas/"):
                        continue
                    schema_name = value.split("/")[-1]
                    original_name = find_original_name(schema_name)
                    component[key] = f"#/components/schemas/{original_name}"
                else:
                    component[key] = update_component(value)
            component.pop("allow_not_implemented", None)
            return component
        elif isinstance(component, list):
            return [update_component(item) for item in component]
        else:
            return component

    def add_referenced_schemas(schema_dict, apispec_schemas, spec):
        """Recursively find all $ref and add them to spec.components"""
        if isinstance(schema_dict, dict):
            if "$ref" in schema_dict:
                ref = schema_dict["$ref"]
                ref_name = find_original_name(ref.split("/")[-1])
                if (
                    ref_name not in spec.components.schemas
                    and ref_name in apispec_schemas
                ):
                    ref_schema = apispec_schemas[ref_name]
                    updated_ref_schema = update_component(ref_schema)
                    spec.components.schema(ref_name, updated_ref_schema)
                    # recursively process the newly added schema
                    add_referenced_schemas(updated_ref_schema, apispec_schemas, spec)
            for value in schema_dict.values():
                add_referenced_schemas(value, apispec_schemas, spec)
        elif isinstance(schema_dict, list):
            for item in schema_dict:
                add_referenced_schemas(item, apispec_schemas, spec)

    condensed_schemas = {}
    for schema_name, schema_definition in spec.components.schemas.items():
        original_name = find_original_name(schema_name)
        condensed_schema_definition = update_component(schema_definition)
        condensed_schema_definition["title"] = original_name
        if "--" in original_name:
            # created in decorate_write_endpoint
            # turn this: "CreatewmsKit--Cin7__Core__-_Dear__Systems_---"
            # into this: "Cin7 Core (Dear Systems)"
            with_removed_prefix = "".join(original_name.split("--")[1:])
            with_removed_surrounding = with_removed_prefix.replace("--", " ")
            with_replaced_open_parens = with_removed_surrounding.replace("-_", "(")
            with_replaced_close_parens = with_replaced_open_parens.replace("_-", ")")
            with_replaced_amp = with_replaced_close_parens.replace("_AMP_", "&")
            replaced_integration_name = with_replaced_amp.replace("__", " ")
            condensed_schema_definition["title"] = replaced_integration_name
        if original_name in condensed_schemas:
            existing_schema = condensed_schemas[original_name]
            if existing_schema != condensed_schema_definition:
                if test:
                    raise Exception(
                        f"""Schema conflict: {original_name}
Existing schema: {existing_schema}
New schema: {condensed_schema_definition}"""
                    )
                logger.error(f"Schema conflict: {original_name}")
                raise PokedexException(
                    "An unexpected error occurred generating the OpenAPI spec.",
                    500,
                    origin="trackstar",
                )
        condensed_schemas[original_name] = condensed_schema_definition

    # strip fake discriminators: OneOfSchema (marshmallow_oneofschema) emits a
    # `type` discriminator on write input wrappers, but the variant schemas
    # have no `type` property — the integration is identified by the access
    # token header. Detect via the "--" in the variant names given by
    # decorate_write_endpoint, which no real discriminator uses. There are true
    # discriminators (e.g. channel objects) which should NOT be affected
    for schema_definition in condensed_schemas.values():
        discriminator = schema_definition.get("discriminator")
        if not discriminator:
            continue
        variant_refs = (discriminator.get("mapping") or {}).values()
        if any("--" in ref for ref in variant_refs):
            schema_definition.pop("discriminator", None)

    # can't directly set spec.components.schemas to condensed_schemas, so we have to delete and re-add
    for schema in list(spec.components.schemas.keys()):
        del spec.components.schemas[schema]
    for schema_name, schema_definition in condensed_schemas.items():
        spec.components.schema(schema_name, schema_definition)
    # auth is documented as request headers (parameters), not securitySchemes.
    # declare an empty root `security` so every operation satisfies the
    # "operation must have security defined on it or at the root level" lint
    # rule without forcing an Authorizations section in the docs.
    # the authorization stuff struggles with optional fields and examples
    spec.options["security"] = []
    for path, path_item in spec._paths.items():
        for operation in path_item.values():
            # sanitize auto-generated operationIds — apiflask derives them
            # from the flask endpoint name, which for path-routed endpoints
            # ends up with slashes and angle brackets that fail the redocly
            # URL-safe rule
            if "operationId" in operation:
                operation["operationId"] = re.sub(
                    r"[^A-Za-z0-9_.-]+", "_", operation["operationId"]
                ).strip("_")
            for parameter in operation.get("parameters", []):
                if "schema" in parameter and parameter["schema"].get("$ref"):
                    schema_name = parameter["schema"]["$ref"].split("/")[-1]
                    original_name = find_original_name(schema_name)
                    parameter["schema"]["$ref"] = (
                        f"#/components/schemas/{original_name}"
                    )
                    parameter["style"] = "deepObject"
                    parameter["explode"] = True
            for response in operation.get("responses", {}).values():
                for media_type in response.get("content", {}).values():
                    if "schema" in media_type:
                        if "$ref" not in media_type["schema"]:
                            # for endpoints without output specs
                            # should just be write-info
                            if not path.endswith("write-info"):
                                raise Exception(
                                    f"Unexpected schema without $ref in response for path {path}: {media_type['schema']}"
                                )
                            continue
                        schema_name = media_type["schema"]["$ref"].split("/")[-1]
                        original_name = find_original_name(schema_name)
                        media_type["schema"]["$ref"] = (
                            f"#/components/schemas/{original_name}"
                        )
            if "requestBody" in operation:
                request_body = operation["requestBody"]
                if "content" in request_body:
                    request_body_content = request_body["content"]
                    for media_type in request_body_content.values():
                        if "schema" in media_type:
                            schema_name = media_type["schema"]["$ref"].split("/")[-1]
                            original_name = find_original_name(schema_name)
                            media_type["schema"]["$ref"] = (
                                f"#/components/schemas/{original_name}"
                            )

    apispec = APISpec(
        title="dummy",
        version="1.0.0",
        openapi_version=OPENAPI_VERSION,
        plugins=[
            MarshmallowPlugin(schema_name_resolver=lambda sch: sch.__class__.__name__)
        ],
    )
    webhooks = {}
    for resource_type in resource_map:
        if skip_webhooks:
            continue
        sub_resource_map = resource_map[resource_type]
        for resource in sub_resource_map.values():
            resource = resource()
            if resource.suppress_webhooks():
                continue
            try:
                webhook_base_type = resource.webhook_base_type()
            except NotImplementedError:
                continue  # not a type we send webhooks for
            webhook_types = resource.supported_webhook_types()
            for verb in webhook_types:
                webhook_name = f"{webhook_base_type}.{verb}"
                description = webhook_types[verb]["description"]
                attributes_to_exclude = []
                previous_attribute_field = webhook_types[verb].get("change_field")
                if verb != "updated" and not previous_attribute_field:
                    attributes_to_exclude.append("previous_attributes")
                schema = resource.webhook_schema(
                    verb, resource_type, exclude=attributes_to_exclude
                )
                apispec.components.schema("dummy", schema=schema)
                apispec_schemas = apispec.to_dict()["components"]["schemas"]
                apispec_schema = apispec_schemas["dummy"]
                # the library always names a "type" field for telling the two
                # shapes apart, but a webhook has no such field to read
                apispec_schema.pop("discriminator", None)
                del apispec.components.schemas["dummy"]
                schema_name = schema.__class__.__name__
                updated_apispec_schema = update_component(apispec_schema)
                add_referenced_schemas(updated_apispec_schema, apispec_schemas, spec)
                if schema_name not in spec.components.schemas:
                    spec.components.schema(schema_name, updated_apispec_schema)
                else:
                    if spec.components.schemas[schema_name] != updated_apispec_schema:
                        logger.error(f"Schema conflict: {schema_name}")
                        raise PokedexException(
                            "An unexpected error occurred generating the OpenAPI spec.",
                            500,
                            origin="trackstar",
                        )
                summary = webhook_name.replace(".", " ").replace("-", " ").capitalize()
                operation_id = "webhook_" + re.sub(
                    r"[^A-Za-z0-9_.-]+", "_", webhook_name
                ).strip("_")
                webhooks[webhook_name] = {
                    "post": {
                        "operationId": operation_id,
                        "summary": summary,
                        "description": description,
                        # outbound — the customer doesn't auth to receive these
                        "security": [],
                        "requestBody": {
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": f"#/components/schemas/{schema_name}"
                                    }
                                }
                            }
                        },
                        "responses": {"200": {"description": "Success"}},
                    }
                }
    if webhooks:
        # svix uses this
        spec.options["x-webhooks"] = webhooks
    mintlify_webhooks = {}
    for webhook_name, webhook_info in webhooks.items():
        post = webhook_info["post"]
        schema = post["requestBody"]["content"]["application/json"]["schema"]
        mintlify_webhooks[webhook_name] = {
            "description": post["description"],
            "schema": schema,
        }
    if webhooks:
        # don't know why this is not using mintlify_webhooks here tbh
        spec.options["webhooks"] = webhooks
    return spec


def get_shared_integration_type(data):
    integration_type = None
    try:
        state = data["state"]
        state_parts = state.split(OAUTH_STATE_FIELD_SEPARATOR)
        for part in state_parts:
            if not part.startswith("integration_type"):
                continue
            integration_type = part.split(OAUTH_STATE_FIELD_EQUALITY_OPERATOR)[1]
    except:
        logger.error(
            f"Error: No integration type provided for shared integration: {data}"
        )
        integration_type = "wms"
    if not integration_type:
        logger.error(
            f"No Error: No integration type provided for shared integration: {data}"
        )
        integration_type = "wms"
    return integration_type


def is_connection_paused(schedules):
    # a connection is "paused" only when it has schedules and every one is paused
    if not schedules:
        return False
    paused_count = 0
    for schedule in schedules:
        if schedule.get("paused"):
            paused_count += 1
    return paused_count == len(schedules)


def recompute_connection_paused(connection_id):
    # nothing recomputes this later, so both reads have to see what the last toggle
    # wrote: a stale one stores a wrong flag, or a wrong paused_at, for good
    schedules = get_connection_scheduler_rows(connection_id, consistent=True)
    paused = is_connection_paused(schedules)
    connection = get_connections_row(connection_id, consistent=True)
    was_paused = connection.get("paused") is True
    update_fields = {"paused": paused}
    # only stamp on the transition into paused, so an idempotent re-pause keeps
    # the original time; clear it on resume
    if paused and not was_paused:
        update_fields["paused_at"] = dt_to_str(now())
    elif not paused:
        update_fields["paused_at"] = None
    update_connections_row(connection_id, update_fields)
    # a connection is disabled once every schedule is paused, and enabled again
    # when it leaves that state; only record the actual transition
    if paused and not was_paused:
        connection_event_type = "connection_disabled"
    elif was_paused and not paused:
        connection_event_type = "connection_enabled"
    else:
        connection_event_type = None
    if connection_event_type:
        record_event(
            connection["org_id"],
            connection_event_type,
            connection["integration_name"],
            connection["integration_type"],
            connection_id=connection_id,
            customer_id=connection.get("customer_id"),
        )
    return paused


def record_schedule_pause_events(connection_id, function_names, paused):
    # one event per function paused or unpaused. fetching the connection (which
    # a concurrent delete could remove) must never break the toggle, so on any
    # failure just skip the events
    try:
        connection = get_connections_row(connection_id)
    except Exception as e:
        logger.error(f"failed to record schedule pause events: {format_exception(e)}")
        return
    event_type = "schedule_paused" if paused else "schedule_unpaused"
    for function_name in function_names:
        record_event(
            connection["org_id"],
            event_type,
            connection["integration_name"],
            connection["integration_type"],
            connection_id=connection_id,
            customer_id=connection.get("customer_id"),
            additional_fields={"function_name": function_name},
        )


# pokecenter loads every connection, so we hand it several dynamo pages at once.
# capped so one org's response stays well under the lambda response size limit.
INTERNAL_CONNECTIONS_PAGE_TARGET = 1000


def api_query_connections(org_id, connection_id, page_token, internal_call=False):
    items = []
    next_token = None
    connection_id_to_schedule_map = {}
    if connection_id:
        try:
            item = get_connections_row(connection_id)
        except:
            raise PokedexException(
                f"Connection {connection_id} not found", 404, origin="trackstar"
            )
        if item["org_id"] != org_id:
            raise PokedexException(
                f"Connection {connection_id} not found", 404, origin="trackstar"
            )
        items.append(item)
        connection_errors = get_connection_errors(connection_id)
        raw_schedules = get_connection_scheduler_rows(connection_id)
        connection_id_to_schedule_map[connection_id] = raw_schedules
    else:
        if internal_call:
            # gather several dynamo pages per response so a big org loads in one
            # round trip instead of many, and the org-wide error and schedule
            # scans below run once for the whole batch rather than once per page.
            page = page_token
            more_pages = True
            while more_pages:
                response = get_connections_by_org_id(org_id, page_token=page)
                items.extend(response["Items"])
                last_key = response.get("LastEvaluatedKey")
                if last_key is None:
                    more_pages = False
                else:
                    page = base64.b64encode(
                        json.dumps(last_key).encode("utf-8")
                    ).decode("utf-8")
                    if len(items) >= INTERNAL_CONNECTIONS_PAGE_TARGET:
                        next_token = page
                        more_pages = False
        else:
            response = get_connections_by_org_id(org_id, page_token=page_token)
            items = response["Items"]
            last_key = response.get("LastEvaluatedKey")
            if last_key is not None:
                last_key = json.dumps(last_key).encode("utf-8")
                next_token = base64.b64encode(last_key).decode("utf-8")
        connection_errors = get_connection_errors_for_org(org_id)
        # pokecenter's connection list shows each row's status from its errors
        # alone and loads a connection's schedules only when the row is opened, so
        # for the internal call skip the org-wide schedule scan and the per-
        # connection sync-status work it feeds. that enrichment is the bulk of the
        # time on a large org, and nothing in the list view reads it.
        if not internal_call:
            raw_schedules = get_all_scheduler_rows_for_org(org_id)
            for schedule in raw_schedules:
                schedule_connection_id = schedule["connection_id"]
                if schedule_connection_id not in connection_id_to_schedule_map:
                    connection_id_to_schedule_map[schedule_connection_id] = []
                connection_id_to_schedule_map[schedule_connection_id].append(schedule)

    errors_by_connection = defaultdict(list)
    for error in connection_errors:
        error_connection_id = error["connection_id"]
        errors_by_connection[error_connection_id].append(error)

    # org policy is constant across this org's connections; fetch once for the resolver
    org_row = None
    if not internal_call:
        org_row = get_org_row(org_id)

    connection_id_map = {}
    display_name_by_integration = {}
    for item in items:
        sync_schedules = []
        available_actions = []
        item_id = item["id"]
        connection_type = item["integration_type"]
        integration_file = get_integration_file(
            item["integration_name"], connection_type
        )
        customer_id = item.get("customer_id")
        integration = integration_file.Integration()
        # cache the manifest display name so a batch of connections to the same
        # integration doesn't re-read the same file; keyed on type too because the
        # same name lives under different types with different display names
        display_name_key = (item["integration_name"], connection_type)
        if display_name_key not in display_name_by_integration:
            display_name_by_integration[display_name_key] = (
                integration.get_display_name()
            )
        if not internal_call:
            try:
                disabled_functions = resolve_disabled_functions(
                    item, org_row, item["integration_name"], connection_type
                )
                available_actions = get_available_actions_for_integration(
                    integration_file,
                    org_id,
                    item_id,
                    disabled_functions=disabled_functions,
                )
            except PokedexException as e:
                if e.status_code != 404:  # integration not found
                    raise e

        item_errors = []
        errors_for_connection = errors_by_connection[item["id"]]
        for connection_error in errors_for_connection:
            item_error = {
                "error_message": connection_error["error_message"],
                "affected_endpoints": connection_error.get("affected_endpoints"),
                "first_seen": connection_error["created_date"],
                "last_seen": connection_error["last_seen"],
            }
            item_errors.append(item_error)
        schedules_for_connection = connection_id_to_schedule_map.get(item_id, [])
        for schedule in schedules_for_connection:
            function_name = schedule["function_name"]
            resource = function_to_resource_map[connection_type][function_name](
                integration
            )
            if resource.is_hidden():
                continue
            schedule["resource_name"] = resource.english_plural_name()
            crawl_frequency = item["crawl_frequencies"].get(
                function_name, resource.crawl_frequency()
            )
            sync_frequency = int(crawl_frequency)

            last_crawl_end = schedule.get("last_crawl_end")
            sync_status = get_sync_status(
                schedule, item_errors, resource.endpoint_base()
            )

            sync_schedules.append(
                {
                    "function_name": schedule["function_name"],
                    "last_crawl_start": schedule.get("last_crawl_start"),
                    "last_crawl_end": last_crawl_end,
                    "latest_data": schedule.get("latest_data"),
                    "sync_frequency": sync_frequency,
                    "sync_status": sync_status,
                }
            )
        connection = {
            "connection_id": item_id,
            "customer_id": customer_id,
            "integration_name": item["integration_name"],
            # human-readable name from the manifest so callers don't maintain their own mapping
            "integration_display_name": display_name_by_integration[display_name_key],
            "integration_type": connection_type,
            "created_at": item["created_at"],
            "last_used": item.get("last_used"),
            "times_used": item.get("times_used"),
            "errors": item_errors,
            "sync_schedules": sync_schedules,
            "available_actions": available_actions,
            "webhooks_disabled": item.get("webhooks_disabled", False),
            "paused": item.get("paused", False),
            # absent on connections that have never been paused
            "paused_at": item.get("paused_at"),
            "historical_sync_completed": item.get("historical_sync_completed", {}),
            "me": None,
        }
        connection_id_map[item_id] = {
            "connection": connection,
            "integration_file": integration_file,
            "dynamo_connection_row": item,
        }
    transformed_items = []
    max_workers = min(len(items), 10)
    if internal_call or not max_workers:
        transformed_items = [v["connection"] for v in connection_id_map.values()]
    else:
        org_private_key = get_org_private_key(org_id)
        with ThreadPoolExecutor(max_workers=max_workers) as executor:
            future_to_connection_row = {}
            for connection_id, conn_and_integration in connection_id_map.items():
                connection_row_to_return = conn_and_integration["connection"]
                integration_file = conn_and_integration["integration_file"]
                dynamo_connection_row = conn_and_integration["dynamo_connection_row"]
                customer_id = connection_row_to_return["customer_id"]
                future = executor.submit(
                    call_integration_me,
                    integration_file,
                    dynamo_connection_row,
                    org_private_key,
                    connection_id,
                    org_id,
                    customer_id,
                    True,
                )
                future_to_connection_row[future] = connection_row_to_return
            for future in as_completed(future_to_connection_row):
                integration_me = future.result()
                connection_row_to_return = future_to_connection_row[future]
                connection_row_to_return["me"] = integration_me
                transformed_items.append(connection_row_to_return)
    api_response = {
        "data": transformed_items,
        "total_count": len(transformed_items),
        "next_token": next_token,
    }
    to_return = api_response
    loose_schema = get_connections_response_schema(partial=True, unknown="include")
    try:
        to_return = loose_schema.load(api_response)
        strict_schema = get_connections_response_schema()
        strict_schema.load(to_return)
    except Exception as e:
        logger.error(f"Validation Exception: {e}")
    return to_return


