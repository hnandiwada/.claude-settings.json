def assert_write_function_enabled(integration, action):
    # connection_row is stashed by the access-token auth path that every write goes through
    connection_row = request.environ["connection_row"]
    org_row = get_org_row(request.environ["org_id"])
    disabled_functions = resolve_disabled_functions(
        connection_row,
        org_row,
        integration.integration_name,
        connection_row["integration_type"],
    )
    # common case: nothing disabled, so don't even resolve the write's name
    if not disabled_functions:
        return
    write_function_name = action.function().__name__
    if write_function_name in disabled_functions:
        raise PokedexException(
            f"{write_function_name} is disabled for this connection",
            403,
            origin="trackstar",
        )


def use_idempotency_key(loaded_body, resource):
    # the header was validated by the endpoint's header schema before we got here
    idempotency_key = request.headers.get("Idempotency-Key")
    if idempotency_key is None:
        return None, None
    logger.info(f"idempotency_key: {idempotency_key}")
    connection_id = request.environ["connection_id"]
    # the same key on another endpoint or with another body is a mistake, not a retry
    body_json = json.dumps(loaded_body, sort_keys=True, default=str)
    request_hash = hashlib.sha256(
        f"{request.method} {request.path}\n{body_json}".encode()
    ).hexdigest()
    existing = create_idempotency_key_row(
        connection_id, idempotency_key, request_hash, logger.config["request_id"]
    )
    if existing is None:
        return idempotency_key, None
    if existing["request_hash"] != request_hash:
        raise PokedexException(
            f"Idempotency-Key `{idempotency_key}` was already used for a different request",
            400,
            origin="trackstar",
        )
    if existing["status"] == IDEMPOTENCY_SUCCEEDED:
        request.environ["idempotent_replayed"] = True
        return idempotency_key, replay_first_write(existing, resource)
    # the put takes over a row left in progress by a dead request, so a row still
    # here belongs to a request that is really running
    raise PokedexException(
        f"A request with Idempotency-Key `{idempotency_key}` is still in progress. "
        "Wait for it to finish before retrying.",
        409,
        origin="trackstar",
    )


def replay_first_write(existing, resource):
    if existing.get("response"):
        # apiflask serializes this the same way it did the first time
        return json.loads(existing["response"])
    # the first response was too big for the row, so rebuild it from the resource
    write_ids = existing["write_ids"]
    if not write_ids:
        raise PokedexException(
            "The first request with this Idempotency-Key succeeded, but its response "
            f"is too large to replay. Fetch the {resource.english_singular_name().lower()} directly.",
            409,
            origin="trackstar",
        )
    if existing["batch"]:
        return {"data": resource.batch_get_resources(write_ids), "unused_fields": []}
    write_id = write_ids[0]
    if existing["skip_retrieval"]:
        data = {"id": write_id, "success": True}
        return {"id": write_id, "data": data, "unused_fields": []}
    try:
        data = resource.get_resource(write_id)
    except ResourceNotFoundException:
        # some writes never store a row; the retry still gets its id back
        data = {"id": write_id}
    return {"id": write_id, "data": data, "unused_fields": []}


def store_response_for_replay(idempotency_key, action, to_return):
    if idempotency_key is None:
        return
    # the write already succeeded, so a failure here must not turn it into an error
    try:
        batch = action.is_batch()
        write_ids = []
        if batch:
            for item in to_return["data"]:
                write_ids.append(str(item["id"]))
        elif to_return.get("id") is not None:
            write_ids.append(str(to_return["id"]))
        response = current_app.json.dumps(action.response_schema().dump(to_return))
        if len(response.encode()) > config.IDEMPOTENCY_RESPONSE_MAX_BYTES:
            response = None
        mark_idempotency_key_succeeded(
            request.environ["connection_id"],
            idempotency_key,
            write_ids,
            batch,
            action.skip_retrieval,
            response,
        )
    except Exception as e:
        logger.error(f"could not mark idempotency_key {idempotency_key} succeeded: {e}")


def delete_idempotency_key(idempotency_key):
    # the write failed, so a retry with this key must run the write again
    if idempotency_key is None:
        return
    try:
        delete_idempotency_key_row(request.environ["connection_id"], idempotency_key)
    except Exception as e:
        logger.error(f"could not delete idempotency_key {idempotency_key}: {e}")


def api_write_resource(
    resource_type,
    action_type,
    item_id=None,
    fail_validation=False,
):
    integration = request.environ["integration"]
    resource: Resource = resource_type(integration)
    action: Action = action_type(resource)

    body = parse_request_body()
    tag_write_function(action)
    loaded_body, unused_fields = validate_write_body(integration, action, body)
    idempotency_key, replay = use_idempotency_key(loaded_body, resource)
    if replay is not None:
        return replay
    write_args = (resource, action, body, loaded_body, unused_fields, fail_validation)
    try:
        if action.is_batch():
            to_return = write_items(*write_args)
        else:
            to_return = write_item(*write_args, item_id)
    except Exception:
        delete_idempotency_key(idempotency_key)
        raise
    store_response_for_replay(idempotency_key, action, to_return)
    return to_return


def write_item(
    resource, action, body, loaded_body, unused_fields, fail_validation, item_id
):
    integration = resource.integration

    if "item_id" in action.run_args():
        assert item_id
    else:
        assert not item_id
    logger.info(f"Request body: {body}")
    connection_id = request.environ["connection_id"]

    linked_resource_key = resource.linked_resource_key
    linked_id_from_body = None

    try:
        action.set_skip_retrieval(loaded_body)
        body_to_pass = copy.deepcopy(loaded_body)
        # child Create: lift linked_resource_key out of the body and pass it as
        # the positional id so the integration signature stays (data, linked_id).
        if (
            linked_resource_key
            and isinstance(action, Create)
            and isinstance(body_to_pass, dict)
            and linked_resource_key in body_to_pass
        ):
            linked_id_from_body = body_to_pass.pop(linked_resource_key)
        args = []
        if "body" in action.run_args():
            args.append(body_to_pass)
        if "item_id" in action.run_args():
            args.append(item_id)
        elif linked_id_from_body is not None:
            args.append(linked_id_from_body)
        rsp = action.run(*args)
    except (PermissionsException, InvalidCredentialsException) as e:
        handle_perm_cred_err(e, resource, request.method)
        raise Exception("unreachable")
    except ValidationError as e:
        raise e
    except AssertionError as e:
        raise PokedexException(str(e), 422, origin="trackstar")
    else:
        handle_api_call_errors(rsp, resource, request.method, allow_errors=False)
    if (
        connection_id in DEPOSCO_CUSTOMER_ORDER_CONNECTIONS
        and resource.name() == "orders"
    ):
        if isinstance(action, Create) and body.get("trackstar_tags"):
            # only has reference_id
            created = now()
            # normally, inject_trackstar_bookkeeping would add the trackstar_tags
            # but since we don't store the order in dynamo, we have to early
            # return and store the tags here
            # we delete the row anyway in populate_customer_order_trackstar_tags,
            # but adding a ttl just in case to avoid orphaned rows
            ttl = int((created + timedelta(days=90)).timestamp())
            side_row = {
                "connection_id": connection_id,
                "id": body["reference_id"],
                "trackstar_tags": body["trackstar_tags"],
                "created_date": dt_to_str(created),
                "updated_date": dt_to_str(created),
                # need for store_resources ^
                "ttl": ttl,
            }
            dco = DeposcoCustomerOrder(integration)
            try:
                dco.get_resource(body["reference_id"])
                logger.info(
                    f"DeposcoCustomerOrder with id {body['reference_id']} already exists, skipping side store insert"
                )
            except ResourceNotFoundException:
                store_resources(dco.table_name(), [side_row])
        return rsp
    item = rsp["data"]

    if not isinstance(action, Create):
        try:
            original_item = resource.get_resource(item_id)
        except ResourceNotFoundException:
            original_item = None
    else:
        original_item = None

    if isinstance(item, dict) and not action.skip_retrieval:
        inject_trackstar_bookkeeping(item, original_item, resource, body=body)

    rsp["unused_fields"] = unused_fields
    write_id = rsp.get("id")
    # for some integrations that don't actually create a new shipment, but modify an existing one
    if not write_id:
        write_id = action.get_write_id(item, original_item, item_id, fail_validation)
    rsp["id"] = write_id
    to_return = best_effort_load(
        action.validate_write_response,
        action.response_schema,
        rsp,
        fail_validation=fail_validation,
    )
    if not action.store_response():
        return to_return

    # TODO: this is a hack to avoid having FBM update inventory
    if integration.integration_name == "fba" and isinstance(action, AdjustInventory):
        return to_return
    try:
        action.validate_write_response_fields(loaded_body, to_return, item_id, write_id)
    except Exception as e:
        logger.error(f"Validation Exception: {str(e)}")
        if fail_validation:
            raise e
    # don't update dynamo when skipping resource retrieval on writes
    if action.skip_retrieval:
        return to_return
    persist_items_and_emit_webhook(resource, [to_return["data"]], connection_id)

    if resource.linked_resource_type is not None:
        # child write already committed + webhooked; enqueue async refresh of the
        # linked record. failure here must not 500 the caller (would duplicate).
        try:
            # write response echoes the linked record's FK; on create it was
            # lifted from the body, so fall back to that. one child, one linked.
            linked_id = (
                to_return["data"].get(linked_resource_key) or linked_id_from_body
            )
            if linked_id:
                now_str = dt_to_str(now())
                payload = {
                    "resource": resource.trimmed(),
                    "data": [str(linked_id)],
                    "start": now_str,
                    "end": now_str,
                    "tracking_id": "",
                }
                write_pickle_to_s3("linked-refresh", payload, "linked_refresh")
        except Exception as e:
            logger.error(f"linked-refresh enqueue failed for {resource.name()}: {e}")

    return to_return


def write_items(resource, action, body, loaded_body, unused_fields, fail_validation):
    # batch sibling of write_item: integration returns a list of items
    # under rsp["data"] instead of a single dict. shared post-processing
    # (trackstar bookkeeping injection, dynamo upsert, webhook emit) runs once
    # over the list rather than once per single-item write.
    logger.info(f"Request body: {body}")
    connection_id = request.environ["connection_id"]

    try:
        rsp = run_action(action, loaded_body)
    except (PermissionsException, InvalidCredentialsException) as e:
        handle_perm_cred_err(e, resource, request.method)
        raise Exception("unreachable")
    except ValidationError as e:
        raise e
    except AssertionError as e:
        raise PokedexException(str(e), 422, origin="trackstar")
    else:
        handle_api_call_errors(rsp, resource, request.method, allow_errors=False)

    items = rsp["data"]

    # batch-lookup existing dynamo rows so we can preserve created_date and
    # trackstar_* immutables — same logic as the single-item path's
    # `original_item = resource.get_resource(item_id)`, just one round-trip.
    item_ids = []
    for item in items:
        item_ids.append(item["id"])
    if item_ids:
        existing_items = resource.batch_get_resources(item_ids)
    else:
        existing_items = []
    existing_by_id = {}
    for existing in existing_items:
        existing_by_id[existing["id"]] = existing

    for item in items:
        inject_trackstar_bookkeeping(item, existing_by_id.get(item["id"]), resource)

    rsp["unused_fields"] = unused_fields

    to_return = best_effort_load(
        action.validate_write_response,
        action.response_schema,
        rsp,
        fail_validation=fail_validation,
    )

    # batch semantic check: line-by-line, did the response reflect what we
    # asked for? mirrors the single-item validate_write_response_fields hop
    # in write_item. logs in prod; raises under fail_validation.
    try:
        action.validate_write_response_fields(loaded_body, to_return, None, None)
    except Exception as e:
        logger.error(f"Validation Exception: {str(e)}")
        if fail_validation:
            raise e

    if not action.store_response():
        return to_return
    if not to_return["data"]:
        return to_return
    persist_items_and_emit_webhook(resource, to_return["data"], connection_id)
    return to_return


def best_effort_load(validator, schema_fn, rsp, fail_validation=False) -> dict:
    to_return = rsp
    schema = schema_fn()
    try:
        dumped = schema.dump(rsp)
        # to exclude hidden fields
        to_return = dumped
        to_return = schema.load(dumped, partial=True, unknown="include")
        validator(to_return)
    except Exception as e:
        parsed_err = str(e).split("\n")[0]
        prefix = "Response Validation Exception: "
        data = to_return.get("data", {})
        if isinstance(data, dict):
            id = data.get("id")
            if id:
                prefix = f"Response Validation Exception for {id}: "
        logger.error(f"{prefix}{parsed_err}")
        if fail_validation:
            raise e
    return to_return


def delete_connection_helper(connection_id, org_id):
    try:
        # the sandbox connection backs the dashboard's onboarding state; deleting it
        # bounces the customer's home page back to the getting-started screen
        connection = get_connections_row(connection_id)
        if connection["integration_name"] == "sandbox":
            raise PokedexException(
                "Sandbox connections cannot be deleted", 403, origin="trackstar"
            )
        deleted_connection = delete_connections_row(connection_id)
        integration_name = deleted_connection["Attributes"]["integration_name"]
        integration_type = deleted_connection["Attributes"]["integration_type"]
        customer_id = deleted_connection["Attributes"].get("customer_id")
        record_event(
            org_id,
            "connection_deleted",
            integration_name,
            integration_type,
            connection_id=connection_id,
            customer_id=customer_id,
        )

        # decrypt secret so integration can call external apis (e.g. unsubscribe from notifications)
        integration_secret = None
        try:
            org_private_key = get_org_private_key(org_id)
            encrypted_secret = deleted_connection["Attributes"].get(
                "integration_secret"
            )
            if encrypted_secret:
                integration_secret = org_decrypt(encrypted_secret, org_private_key)
        except Exception as e:
            logger.error(f"Could not decrypt integration_secret for delete: {e}")

        integration = build_integration(
            deleted_connection["Attributes"],
            org_id,
            integration_secret=integration_secret,
        )

        try:
            integration.pre_delete()
        except Exception as e:
            logger.error(f"pre_delete error for {connection_id}: {e}")

        connection_deleted = {
            "item": {
                "connection_id": connection_id,
                "deleted_date": dt_to_str(now()),
            },
            "action": "deleted",
        }
        resource = Connection(integration).trimmed()
        webhook_payload = {
            "resource": resource,
            "data": [connection_deleted],
        }
        write_pickle_to_s3("webhook", webhook_payload, source="api")
        logger.info(f"Deleted connection row: {deleted_connection['Attributes']}")
    except PokedexException:
        # let the sandbox-block 403 (and any other intentional status) through
        raise
    except Exception:
        raise PokedexException("Error deleting connection", 500, origin="trackstar")

    return {"id": connection_id, "object": "connection", "deleted": True}


def call_integration_me(
    integration_file,
    integration_row,
    org_private_key,
    connection_id,
    org_id,
    customer_id,
    safe=False,
):
    integration_secret = integration_row["integration_secret"]
    additional_fields = integration_row["additional_fields"]
    raw_integration_secret = org_decrypt(integration_secret, org_private_key)
    integration = integration_file.Integration(
        connection_id=connection_id,
        org_id=org_id,
        customer_id=customer_id,
        integration_secret=raw_integration_secret,
        connection_additional_fields=additional_fields,
    )
    me = None
    try:
        if not safe:
            me = integration.me()
        else:
            me = integration.safe_me()
    except Exception as e:
        endpoint = "safe_me" if safe else "me"
        logger.error(
            f"Error fetching '{endpoint}' info for integration {connection_id}: {str(e)}"
        )
    return me


