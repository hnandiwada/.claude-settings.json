def accept_api_key_or_auth(
    api,
    method,
    path,
    cors_origins,
    query_input=Schema(),
    json_input=None,
    output=Schema(),
    tags=[],
):
    # this is a hack that generates two functions, one that accepts an api key and one that accepts an auth header
    # this is because we want to call these endpoints from pokecenter, but we don't want to build a backend
    # this makes sure that the input schemas get validated and generated in docs properly
    json_location = "json"
    if not json_input:
        json_input = Schema()
        json_location = None

    def decorator(func):
        @wraps(func)
        @api.route(path, methods=[method], endpoint=f"{method}_{path}")
        @api.input(APIKeyHeaderSchema(), location="headers")
        @api.input(query_input, location="query")
        @api.input(json_input, location=json_location)
        @api.output(output)
        @api.doc(tags=tags)
        def backend(*args, **kwargs):
            return func(*args, **kwargs)

        @wraps(func)
        @api.route(
            f"/internal{path}", methods=[method], endpoint=f"{method}_internal_{path}"
        )
        @cross_origin(origins=cors_origins)
        @api.input(query_input, location="query")
        @api.input(AuthHeaderSchema, location="headers")
        @api.input(json_input, location=json_location)
        @api.output(output)
        @api.doc(hide=True)
        def frontend(*args, **kwargs):
            return func(*args, **kwargs)

        return backend

    return decorator


def decorate_list_endpoint(api, resource_type):
    resource_obj = resource_type()
    integration_type = resource_obj.get_integration_type()

    def decorator(func):
        @wraps(func)
        @api.input(resource_type().query_params_schema(), location="query")
        @api.input(APIAndAccessTokenHeaderSchema(), location="headers")
        @api.output(resource_obj.list_endpoint_schema())
        @api.doc(tags=[integration_type, resource_obj.english_plural_name()])
        def wrapper(*args, **kwargs):
            query_data = dict(kwargs.get("query_data", {}))
            integration = request.environ["integration"]
            resource = resource_type(integration)
            implemented = resource.get_endpoint_implemented()
            if not implemented:
                raise NotImplementedException(
                    request.method, request.path, integration.integration_name
                )
            logger.updateConfig({"query_params": query_data})
            return func(*args, **kwargs)

        return wrapper

    return decorator


