# passthrough path is customer-controlled and most integrations concatenate it
# onto the vendor host (e.g. f"https://{domain}{path}"). if the part before the
# first '/', '?' or '#' carries a userinfo '@' or a ':' it becomes the url
# authority, so "@evil.test/x" sends the connection's auth header to evil.test.
# integrations disagree on whether path is rooted (shopify needs a leading '/',
# deposco/linnworks/walmart/wayfair must not have one), so we can't force a
# leading slash -- instead reject anything that can inject into the authority.
MAX_PASSTHROUGH_PATH_LENGTH = 2048


def validate_passthrough_path(path):
    # "//host" is parsed as a protocol-relative authority by some clients
    if path.startswith("//"):
        raise ValidationError("path must not start with '//'")
    # backslash is treated like '/' by some url parsers, reopening host injection
    if "\\" in path:
        raise ValidationError("path must not contain backslashes")
    # control chars / spaces enable url-signing and header injection
    for char in path:
        if ord(char) < 0x20 or char in (" ", "\x7f"):
            raise ValidationError(
                "path must not contain whitespace or control characters"
            )
    if len(path) > MAX_PASSTHROUGH_PATH_LENGTH:
        raise ValidationError("path is too long")
    # the authority is everything before the first '/', '?' or '#'. a '@'
    # (userinfo) or ':' (scheme/port) there would redirect the request to
    # another host, so reject it. a legit timestamp ':' lives after the '?'.
    authority = re.split(r"[/?#]", path, maxsplit=1)[0]
    if "@" in authority or ":" in authority:
        raise ValidationError("path must not target another host")


