def enforce_active_org_billing(org_row):
    # cache miss or missing row: allow the call rather than locking everyone out
    if not org_row:
        return
    if org_row["billing_status"] in INACTIVE_BILLING_STATUSES:
        raise InvalidTrackstarCredentialsException("Organization is not active")


def validate_api_key(api_key):
    try:
        row = get_api_key_row_cached(api_key)
    except:
        logger.info(f"Invalid API key: {api_key}")
        raise InvalidTrackstarCredentialsException("Invalid API key")
    if row["read_only"] and request.method != "GET":
        raise PokedexException(
            "Read-only API key cannot make write requests", 403, "trackstar"
        )
    org_id = row["org_id"]
    request.environ["org_id"] = org_id
    logger.updateConfig({"org_id": org_id})
    tracer.set_tags({"org_id": org_id})
    org_row = None
    try:
        org_row = get_org_row_cached(org_id)
        org_name = org_row["name"]
        request.environ["org_name"] = org_name
        logger.updateConfig({"org_name": org_name})
        tracer.set_tags({"org_name": org_name})
    except:
        pass
    enforce_active_org_billing(org_row)


def validate_auth_header(auth_header):
    try:
        frontend_token = decode_auth_header(auth_header)
    except:
        raise InvalidTrackstarCredentialsException("Invalid Authorization header")
    exp, nbf = frontend_token["exp"], frontend_token["nbf"]
    cur = int(time.time())
    if cur > exp:
        raise InvalidTrackstarCredentialsException("Token has expired")
    if cur < nbf:
        raise InvalidTrackstarCredentialsException("Token is not valid yet")

    org_id = frontend_token["org_id"]
    request.environ["org_id"] = org_id
    logger.updateConfig({"org_id": org_id})
    tracer.set_tags({"org_id": org_id})
    submitter_user_id = frontend_token.get("sub")
    if submitter_user_id:
        request.environ["submitter_user_id"] = submitter_user_id
    try:
        org_row = get_org_row_cached(org_id)
        org_name = org_row["name"]
        request.environ["org_name"] = org_name
        logger.updateConfig({"org_name": org_name})
        tracer.set_tags({"org_name": org_name})
    except:
        pass


def validate_access_token(access_token):
    if not access_token.startswith("trackstar_"):
        raise ValidationError("Malformed access token")
    access_token = access_token.split("trackstar_")[1]

    org_id = request.environ.get("org_id")
    if not org_id:
        raise InvalidTrackstarCredentialsException("API key required")
    try:
        org_private_key = get_org_private_key(org_id)
    except:
        logger.error(f"Failed to get org private key for {org_id}")
        raise InvalidTrackstarCredentialsException("Invalid access token")
    try:
        decoded_token = decode_access_token(access_token, org_private_key)
    except:
        logger.error(f"Failed to decode access token {access_token}")
        raise InvalidTrackstarCredentialsException("Invalid access token")

    integration_name = decoded_token.get("integration_name")
    request.environ["integration_name"] = integration_name
    logger.updateConfig({"integration_name": integration_name})
    tracer.set_tags({"integration_name": integration_name})

    connection_id = decoded_token.get("connection_id") or decoded_token.get("token_id")
    # to support when connection ID used to be called token ID
    request.environ["connection_id"] = connection_id
    logger.updateConfig({"connection_id": connection_id})
    tracer.set_tags({"connection_id": connection_id})

    if not integration_name or not connection_id:
        raise InvalidTrackstarCredentialsException("Invalid access token")

    try:
        connections_row = get_connections_row(connection_id)
    except:
        raise InvalidTrackstarCredentialsException("Invalid access token")

    integration_type = connections_row["integration_type"]
    request.environ["integration_type"] = integration_type
    request.environ["connection_row"] = connections_row
    logger.updateConfig({"integration_type": integration_type})
    tracer.set_tags({"integration_type": integration_type})
    request.environ["integration"] = build_integration(connections_row, org_id)


