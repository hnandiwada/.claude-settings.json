failed = False
files = {}
for path, old, new, count in edits:
    if path not in files:
        files[path] = open(path).read()
    found = files[path].count(old)
    if found != count:
        print(f"MISMATCH {path}: expected {count}, found {found}\n{old[:120]}\n")
        failed = True
        continue
    files[path] = files[path].replace(old, new)

if failed:
    raise SystemExit(1)


def add_import(src):
    multi = re.search(r"from utils\.exceptions import \(\n(.*?)\)", src, re.S)
    if multi:
        names = multi.group(1)
        lines = names.rstrip("\n").split("\n")
        lines.append("    WriteNotReturnedException,")
        return src.replace(multi.group(0), "from utils.exceptions import (\n" + "\n".join(lines) + "\n)")
    single = re.search(r"from utils\.exceptions import (.+)\n", src)
    names = single.group(1).split(", ")
    names.append("WriteNotReturnedException")
    joined = ", ".join(names)
    line = f"from utils.exceptions import {joined}\n"
    if len(line) > 89:
        inner = ""
        for name in names:
            inner += f"    {name},\n"
        line = f"from utils.exceptions import (\n{inner})\n"
    return src.replace(single.group(0), line)


for path, src in files.items():
    src = add_import(src)
    if path.endswith("deposco/integration.py") or path.endswith("shiphero/integration.py"):
        pass
    open(path, "w").write(src)
    print("updated", path)
