    def get_shipping_method_by_name_and_carrier(
        self, shipping_method_name, carrier=None, carrier_required_for_name=True
    ):
        sm_resource = ShippingMethod(self)
        shipping_method_params = {
            "name": {"eq": shipping_method_name},
        }
        if not carrier:
            if carrier_required_for_name:
                raise PokedexException(
                    "Carrier must be provided if shipping method is a name instead of ID",
                    400,
                    origin="trackstar",
                )
        else:
            shipping_method_params["carrier"] = {"eq": carrier}
        shipping_methods = sm_resource.get_all_resources(shipping_method_params)
        if not shipping_methods:
            # try lowercased shipping method name
            shipping_method_params["name"] = {"eq": shipping_method_name.lower()}
            shipping_methods += sm_resource.get_all_resources(shipping_method_params)
        if not shipping_methods:
            if carrier:
                raise PokedexException(
                    f"Shipping method {shipping_method_name} not found for carrier {carrier}",
                    400,
                    origin="trackstar",
                )
        if not shipping_methods:
            raise PokedexException(
                f"Shipping method {shipping_method_name} not found",
                400,
                origin="trackstar",
            )
        shipping_method = shipping_methods[0]
        return shipping_method

    def get_order_channel_by_id_or_name(
        self, channel_identifier, warehouse_customer_id=None
    ):
        # TODO delete after fully deprecated
        channel_resource = OrderChannel(self)
        try:
            order_channel = channel_resource.get_resource(channel_identifier)
        except ResourceNotFoundException:
            params = {"name": {"eq": channel_identifier}}
            if warehouse_customer_id:
                params["warehouse_customer_id"] = {"eq": warehouse_customer_id}
            order_channel = channel_resource.get_all_resources(params)
            if not order_channel:
                raise PokedexException(
                    f"Order channel {channel_identifier} not found",
                    400,
                    origin="trackstar",
                )
            order_channel = order_channel[0]
        order_channel_id = order_channel["id"]
        if (
            order_channel.get(
                "warehouse_customer_id"
            )  # TODO: only a .get while we're updating the schema
            and order_channel["warehouse_customer_id"] in order_channel_id
        ):
            order_channel_id = order_channel_id.replace(
                f"_{order_channel['warehouse_customer_id']}", ""
            )
        return order_channel_id

    def get_supplier_by_name(self, supplier_name, warehouse_customer_id=None):
        params = {"name": {"eq": supplier_name}}
        if warehouse_customer_id:
            params["warehouse_customer_id"] = {"eq": warehouse_customer_id}
        supplier = InboundShipmentSupplier(self).get_all_resources(params)
        if not supplier:
            raise PokedexException(
                f"Supplier {supplier_name} not found",
                400,
                origin="trackstar",
            )
        return supplier[0]

