    def get_order_channels(self, first_loop, formatted_orders):
        formatted_order_channels = {}
        for o in formatted_orders:
            channel_object = o["channel_object"]
            if not channel_object:
                continue
            channel_id = channel_object["channel_id"]
            channel_id = get_real_string_value(channel_id)
            if not channel_id:
                raise Exception(
                    f"No channel ID for order {o['id']} - channel {channel_object}"
                )
            channel_name = channel_object["channel_name"]
            channel_name = get_real_string_value(channel_name)
            if not channel_name:
                channel_name = None
            wh_customer_id = o["warehouse_customer_id"]
            wh_customer_id = get_real_string_value(wh_customer_id)
            if not wh_customer_id:
                wh_customer_id = None
            # assume name is only unique by wh_customer_id
            if channel_id == channel_name:
                assert not wh_customer_id, (
                    f"Channel ID and name are the same for a warehouse customer: {channel_id}"
                )
            formatted_order_channel = {
                "id": channel_id,
                "name": channel_name,
                "warehouse_customer_id": wh_customer_id,
                "additional_fields": {},
            }
            if channel_id in formatted_order_channels:
                existing_channel = formatted_order_channels[channel_id]
                assert existing_channel == formatted_order_channel, (
                    f"Channel ID {channel_id} has multiple names {existing_channel} and {formatted_order_channel}"
                )
            formatted_order_channels[channel_id] = formatted_order_channel
        return {
            "data": list(formatted_order_channels.values()),
            "api_call_made": False,
        }

    def get_inbound_shipment_suppliers(self, first_loop, formatted_inbound_shipments):
        formatted_suppliers = {}
        for o in formatted_inbound_shipments:
            supplier_object = o["supplier_object"]
            if not supplier_object:
                continue
            supplier_id = supplier_object["supplier_id"]
            supplier_id = get_real_string_value(supplier_id)
            if not supplier_id:
                raise Exception("No supplier ID")
            supplier_name = supplier_object["supplier_name"]
            supplier_name = get_real_string_value(supplier_name)
            wh_customer_id = o["warehouse_customer_id"]
            wh_customer_id = get_real_string_value(wh_customer_id)
            # assume name is only unique by wh_customer_id
            if supplier_id == supplier_name:
                assert not wh_customer_id, (
                    f"Supplier ID and name are the same for a warehouse customer: {supplier_id}"
                )
            formatted_supplier = {
                "id": supplier_id,
                "name": supplier_name,
                "warehouse_customer_id": wh_customer_id,
                "additional_fields": {},
            }
            if supplier_id in formatted_suppliers:
                existing_supplier = formatted_suppliers[supplier_id]
                assert existing_supplier == formatted_supplier, (
                    "Supplier ID has multiple names"
                )
            formatted_suppliers[supplier_id] = formatted_supplier

        return {"data": list(formatted_suppliers.values()), "api_call_made": False}

