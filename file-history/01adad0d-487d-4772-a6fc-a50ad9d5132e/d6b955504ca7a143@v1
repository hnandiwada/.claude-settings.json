    def get_warehouses(self, start, end, first_crawl, first_loop, page_token=None):
        # Overwrite this method if the integration has a warehouse endpoint
        if self.in_perm_validator():
            return {"data": [], "next_token": None, "api_call_made": False}

        if self.is_implemented("get_inventory"):
            InventoryItem(self).check_first_crawl_complete()

        warehouses = set()
        if first_crawl:
            inventory_items = InventoryItem(self).get_all_resources()
        else:
            inventory_items = InventoryItem(self).get_all_resources(
                {"trackstar_updated_date": {"gte": dt_to_str(start)}}
            )
        for item in inventory_items:
            inventory_by_warehouse_id = item["inventory_by_warehouse_id"]
            for warehouse_id in inventory_by_warehouse_id.keys():
                warehouses.add(warehouse_id)

        formatted_warehouses = []
        for warehouse_id in warehouses:
            formatted_warehouses.append(
                {
                    "id": warehouse_id,
                    "name": warehouse_id,
                    "code": IntegrationNotImplemented,
                    "address": IntegrationNotImplemented,
                    "additional_fields": {},
                }
            )

        return {
            "data": formatted_warehouses,
            "next_token": None,
            "api_call_made": False,
        }

