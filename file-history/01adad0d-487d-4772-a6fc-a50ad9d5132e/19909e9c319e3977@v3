    # @pytest.mark.only
    # @pytest.mark.skip
    def test_get_inbound_shipments(
        self,
        mocker,
        integration,
        start_time,
        end_time,
        context,
        page_token: object = "default",
    ):
        resource = InboundShipment(integration)
        response = self.get_and_validate(
            mocker, resource, start_time, end_time, page_token=page_token
        )
        data = response["data"]
        po_id = None
        warehouse_ids = set()
        li_inventory_item_ids = set()
        receipt_inventory_item_ids = set()
        suppliers = {}
        for item in data:
            if item["warehouse_id"]:
                warehouse_ids.add(item["warehouse_id"])
            if item["line_items"]:
                po_id = item["id"]
                li_inventory_item_ids.update(
                    [li["inventory_item_id"] for li in item["line_items"]]
                )
            if not isinstance(item["receipts"], IntegrationNotImplementedClass):
                for receipt in item["receipts"]:
                    receipt_inventory_item_ids.update(
                        [li["inventory_item_id"] for li in receipt["line_items"]]
                    )
            supplier_object = item["supplier_object"]
            if supplier_object:
                if supplier_object["supplier_id"] not in suppliers:
                    suppliers[supplier_object["supplier_id"]] = supplier_object
                elif "inbound_shipment_suppliers" not in self.ignore_link_tests():
                    assert suppliers[supplier_object["supplier_id"]] == supplier_object
        if not po_id:
            raise AssertionError("no purchase orders with line_items")
        if li_inventory_item_ids and receipt_inventory_item_ids:
            if not self.allow_unordered_inbound_receipt_li():
                if not receipt_inventory_item_ids.issubset(li_inventory_item_ids):
                    raise AssertionError(
                        "receipt inventory items not in po inventory items"
                    )

        context["inbound_inventory_ids"] = li_inventory_item_ids
        if "inventory_ids" in context:
            if "inbound_inventory_ids" not in self.ignore_link_tests():
                if not (li_inventory_item_ids & context["inventory_ids"]):
                    raise AssertionError(
                        "no inventory_item_ids from inbound shipment line items in inventory"
                    )
        if "warehouse_ids" in context and warehouse_ids:
            if "inbound_warehouse_ids" not in self.ignore_link_tests():
                if not (warehouse_ids & context["warehouse_ids"]):
                    raise AssertionError(
                        "no warehouse ids from inbound shipments in warehouses"
                    )
        external_system_url = data[0].get("external_system_url")
        if external_system_url:
            self.validate_external_system_url(external_system_url)

        child_resources = response.get("child_resources", {})
        child_suppliers = []
        for child_resource in child_resources:
            if not isinstance(child_resource, InboundShipmentSupplier):
                continue
            child_suppliers_rsp = child_resources[child_resource]
            for supplier in child_suppliers_rsp["data"]:
                supplier_copy = {
                    "supplier_id": supplier["id"],
                    "supplier_name": supplier["name"],
                }
                child_suppliers.append(supplier_copy)
        if suppliers and "inbound_shipment_suppliers" not in self.ignore_link_tests():
            if not child_suppliers:
                raise AssertionError("no suppliers attached to inbound shipments")
            if not any(supplier in suppliers.values() for supplier in child_suppliers):
                raise AssertionError(
                    "no suppliers from inbound shipments in child_resources"
                )

