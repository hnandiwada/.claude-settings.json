    # @pytest.mark.only
    # @pytest.mark.skip
    def test_get_orders(
        self,
        mocker,
        integration,
        start_time,
        end_time,
        context,
        first_crawl=False,
        page_token: object = "default",
        return_data=False,
    ):
        resource = Order(integration)
        response = self.get_and_validate(
            mocker, resource, start_time, end_time, first_crawl, page_token
        )
        data = response["data"]
        order_id = None
        li_product_ids = set()
        shipment_inv_ids = set()
        warehouse_ids = set()
        channels = {}
        shipping_methods = {}
        order_ids = set()
        carriers = {}
        try:
            resource_implemented = get_resource_implemented(resource)
        except Exception:
            resource_implemented = {}
        for item in data:
            if item["line_items"]:
                order_id = item["id"]
            li_product_ids.update([li["product_id"] for li in item["line_items"]])
            shipping_method_id = item["shipping_method_id"]
            shipping_method_name = item["shipping_method_name"]
            if shipping_method_id and resource_implemented.get("shipping_method_name"):
                if shipping_method_id not in shipping_methods:
                    shipping_methods[shipping_method_id] = shipping_method_name
                else:
                    old_sm_name = shipping_methods[shipping_method_id]
                    if self.consistent_shipping_method():
                        if old_sm_name != shipping_method_name:
                            raise AssertionError(
                                f"shipping method name changed for same id {shipping_method_id}: {old_sm_name} != {shipping_method_name}"
                            )
            carrier_id = item["carrier_id"]
            carrier_name = item["carrier_name"]
            scac = item["scac"]
            if carrier_id and resource_implemented.get("carrier_name"):
                if carrier_id not in carriers:
                    carriers[carrier_id] = {
                        "carrier_name": carrier_name,
                        "scac": scac,
                    }
                else:
                    old_carrier_name = carriers[carrier_id]["carrier_name"]
                    if old_carrier_name != carrier_name:
                        raise AssertionError(
                            f"carrier name changed for same id {carrier_id}: {old_carrier_name} != {carrier_name}"
                        )
                    # actually, scac can change for same carrier
                    # assert carriers[carrier_id]["scac"] == scac, (
                    #     f"scac changed for same carrier id {carrier_id}"
                    # )
            for shipment in item["shipments"]:
                shipment_inv_ids.update(
                    [p["inventory_item_id"] for p in shipment["line_items"]]
                )
                # box inv ids are all in shipment line items (validator) - no need to check
                warehouse_ids.add(shipment["warehouse_id"])
                for package in shipment["packages"]:
                    shipping_method_id = package["shipping_method_id"]
                    shipping_method_name = package["shipping_method_name"]
                    package_sm_impl = False
                    shipments_impl = resource_implemented.get("shipments")
                    if shipments_impl:
                        shipment_impl = shipments_impl[0]
                        package_impl = shipment_impl.get("packages")
                        if package_impl:
                            package_sm_impl = package_impl[0].get(
                                "shipping_method_name"
                            )
                    if shipping_method_id and package_sm_impl:
                        if shipping_method_id not in shipping_methods:
                            shipping_methods[shipping_method_id] = shipping_method_name
                        else:
                            old_sm_name = shipping_methods[shipping_method_id]
                            if self.consistent_shipping_method():
                                if old_sm_name != shipping_method_name:
                                    raise AssertionError(
                                        f"shipping method name changed for same id {shipping_method_id}: {old_sm_name} != {shipping_method_name}"
                                    )
                    carrier_id = package["carrier_id"]
                    carrier_name = package["carrier_name"]
                    scac = package["scac"]
                    if carrier_id:
                        if carrier_id not in carriers:
                            carriers[carrier_id] = {
                                "carrier_name": carrier_name,
                                "scac": scac,
                            }
                        else:
                            old_carrier_name = carriers[carrier_id]["carrier_name"]
                            if old_carrier_name != carrier_name:
                                raise AssertionError(
                                    f"carrier name changed for same id: {carrier_id}: {old_carrier_name} != {carrier_name}"
                                )
                            # actually, scac can change for same carrier
                            # assert carriers[carrier_id]["scac"] == scac, (
                            #     "scac changed for same carrier id"
                            # )
            channel_object = item["channel_object"]
            if channel_object:
                if channel_object["channel_id"] not in channels:
                    channels[channel_object["channel_id"]] = channel_object
                else:
                    assert channels[channel_object["channel_id"]] == channel_object
            order_ids.add(item["id"])
            if item["shipments"]:
                context["order_id_with_packs"] = item["id"]

        context["order_ids"] = order_ids
        if not order_id:
            raise AssertionError("no orders with line_items")
        context["order_product_ids"] = li_product_ids
        if "product_ids" in context:
            if "order_product_ids" not in self.ignore_link_tests():
                if not (li_product_ids & context["product_ids"]):
                    raise AssertionError(
                        "no product_ids from order line items in products"
                    )
        context["order_shipment_inventory_ids"] = shipment_inv_ids
        if "inventory_ids" in context:
            if shipment_inv_ids:
                if "order_shipment_inventory_ids" not in self.ignore_link_tests():
                    if not (shipment_inv_ids & context["inventory_ids"]):
                        raise AssertionError(
                            "no inventory_ids from order shipments in inventory"
                        )
        context["order_shipment_warehouses"] = warehouse_ids
        if "warehouse_ids" in context and warehouse_ids:
            if "order_shipment_warehouses" not in self.ignore_link_tests():
                if not (warehouse_ids & context["warehouse_ids"]):
                    raise AssertionError(
                        "no warehouse ids from order shipments in warehouses"
                    )
        context["order_shipping_methods"] = shipping_methods
        if "shipping_method_ids" in context and shipping_methods:
            if (
                "order_shipping_methods" not in self.ignore_link_tests()
                and resource_implemented.get("shipping_method_name")
            ):
                found = False
                for (
                    shipping_method_id,
                    shipping_method_name,
                ) in shipping_methods.items():
                    if shipping_method_id in context["shipping_method_ids"]:
                        found = True
                        old_name = context["shipping_method_ids"][shipping_method_id]
                        if old_name != shipping_method_name:
                            raise AssertionError(
                                f"shipping method name changed for same id {shipping_method_id}: {old_name} != {shipping_method_name}"
                            )
                if not found:
                    raise AssertionError(
                        "no shipping methods from orders in shipping methods"
                    )
        context["order_carriers"] = carriers
        if context.get("carriers"):
            if (
                "order_carriers" not in self.ignore_link_tests()
                and carriers
                and resource_implemented.get("carrier_name")
            ):
                found = False
                for carrier_id, carrier_info in carriers.items():
                    if carrier_id in context["carriers"]:
                        found = True
                        if resource_implemented.get("carrier_name"):
                            old_name = context["carriers"][carrier_id]["carrier_name"]
                            if old_name != carrier_info["carrier_name"]:
                                raise AssertionError(
                                    f"carrier name changed for same id {carrier_id}: {old_name} != {carrier_info['carrier_name']}"
                                )
                            # actually, scac can change for same carrier
                            # assert (
                            #     context["carriers"][carrier_id]["scac"]
                            #     == carrier_info["scac"]
                            # ), f"scac changed for same carrier id {carrier_id}"
                if not found:
                    raise AssertionError("no carriers from orders in carriers")
        external_system_url = data[0].get("external_system_url")
        if external_system_url:
            self.validate_external_system_url(external_system_url)

        child_resources = response.get("child_resources", {})
        child_channels = []
        for child_resource in child_resources:
            if not isinstance(child_resource, OrderChannel):
                continue
            child_channels_rsp = child_resources[child_resource]
            for channel in child_channels_rsp["data"]:
                channel_copy = {
                    "channel_id": channel["id"],
                    "channel_name": channel["name"],
                }
                child_channels.append(channel_copy)
        if channels:
