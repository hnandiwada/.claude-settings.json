        inv_item = context.get("inventory_item")
        if not inv_item:
            # TODO: find a workaround so we can test sandbox
            pytest.skip("no inventory item to adjust")

        action = AdjustInventory(InventoryItem(integration))
        full_body = self.full_inventory_adjustment(context)
        data = self.write_and_validate(
            action, full_body, connection_row, inv_item["id"]
        )
        # get inventory item before update and assert changes by quantity in proper direction
        if full_body["adjustment_type"] == "increase":
            assert data["onhand"] == inv_item["onhand"] + full_body["quantity"]
        else:
            assert data["onhand"] == inv_item["onhand"] - full_body["quantity"]
