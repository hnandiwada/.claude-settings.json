    # @pytest.mark.only
    def test_get_inventory(
        self,
        mocker,
        integration,
        start_time,
        end_time,
        context,
        first_crawl=False,
        page_token: object = "default",
    ):
        resource = InventoryItem(integration)
        response = self.get_and_validate(
            mocker, resource, start_time, end_time, first_crawl, page_token
        )
        data = response["data"]
        context["inventory_ids"] = {item["id"] for item in response["data"]}
        inventory_item_id = None
        warehouse_ids = set()
        lot_warehouse_ids = set()
        warehouse_location_ids = set()
        for item in data:
            if item["active"] and item["inventory_by_warehouse_id"]:
                inventory_item_id = item["id"]
                warehouse_ids.update(item["inventory_by_warehouse_id"].keys())
            for lot in item["lots"]:
                if lot["warehouse_id"]:
                    lot_warehouse_ids.add(lot["warehouse_id"])
            for location in item["locations"]:
                if location["location_id"]:
                    warehouse_location_ids.add(location["location_id"])
        try:
            resource_implemented = get_resource_implemented(resource)
        except Exception:
            resource_implemented = {}
        if self.returns_with_inv_by_warehouse():
            if resource_implemented.get("inventory_by_warehouse_id"):
                if not inventory_item_id:
                    raise AssertionError(
                        "no inventory items with inventory_by_warehouse_id"
                    )
        elif warehouse_ids or inventory_item_id:
            raise Exception("undo test_returns_with_inv_by_warehouse - data is found")
        context["inventory_warehouse_ids"] = warehouse_ids
        if (
            "warehouse_ids" in context
            and warehouse_ids
            and "inventory_warehouse_ids" not in self.ignore_link_tests()
        ):
            if not (warehouse_ids & context["warehouse_ids"]):
                raise AssertionError("no warehouse ids from inventory in warehouses")
            if lot_warehouse_ids:
                if not (lot_warehouse_ids & context["warehouse_ids"]):
                    raise AssertionError("no warehouse ids from lots in warehouses")
        context["inventory_warehouse_location_ids"] = warehouse_location_ids
        if (
            "warehouse_location_ids" in context
            and warehouse_location_ids
            and "inventory_warehouse_location_ids" not in self.ignore_link_tests()
        ):
            if not (warehouse_location_ids & context["warehouse_location_ids"]):
                raise AssertionError(
                    "no warehouse location ids from inventory in warehouse locations"
                )
        external_system_url = data[0].get("external_system_url")
        if external_system_url:
            self.validate_external_system_url(external_system_url)

        context["inventory_item"] = data[0]

