    # @pytest.mark.only
    # @pytest.mark.skip
    def test_get_warehouses(self, mocker, integration, start_time, end_time, context):
        if not integration.is_implemented("get_warehouses"):
            pytest.skip("get_warehouses not implemented")
        resource = Warehouse(integration)
        try:
            response = self.get_and_validate(mocker, resource, start_time, end_time)
        except AssertionError as e:
            if "no warehouses returned" not in str(e):
                raise
            uses_fallback = (
                type(integration).get_warehouses is WMSIntegration.get_warehouses
            )
            try:
                inventory_implemented = get_resource_implemented(
                    InventoryItem(integration)
                )
            except Exception:
                inventory_implemented = {}
            # the fallback reads warehouse ids off stored inventory, so it has none to find
            if uses_fallback and not integration.is_implemented("get_inventory"):
                pytest.xfail("get_inventory not implemented")
            if (
                uses_fallback
                and "inventory_by_warehouse_id" in inventory_implemented
                and not inventory_implemented["inventory_by_warehouse_id"]
            ):
                pytest.xfail("inventory_by_warehouse_id not implemented")
            raise
        warehouse_ids = {warehouse["id"] for warehouse in response["data"]}
        context["warehouse_ids"] = warehouse_ids

