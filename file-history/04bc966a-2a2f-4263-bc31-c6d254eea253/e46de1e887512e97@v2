def store_connection_error(
    org_id,
    connection_id,
    integration_name,
    failed_url,
    message,
    affected_endpoint,
    preventing_sync,
):
    table_name = ConnectionsError().table_name()
    dynamo_args, filters = create_dynamo_args(table_name, connection_id, failed_url)
    existing_error_rsp = query(ConnectionsError().table_name(), dynamo_args, filters)
    existing_error = (
        existing_error_rsp["Items"][0] if existing_error_rsp["Items"] else {}
    )

    affected_endpoints = existing_error.get("affected_endpoints", [])
    affected_endpoint_exists = False
    for existing_affected_endpoint in affected_endpoints:
        endpoint = existing_affected_endpoint["endpoint"]
        existing_preventing_sync = existing_affected_endpoint["preventing_sync"]
        if affected_endpoint == endpoint:
            if preventing_sync == existing_preventing_sync:
                affected_endpoint_exists = True
            else:
                affected_endpoints.remove(existing_affected_endpoint)
            break

    if not affected_endpoint_exists:
        affected_endpoints.append(
            {"endpoint": affected_endpoint, "preventing_sync": preventing_sync}
        )

    row = {
        "failed_url": failed_url,
        "affected_endpoints": sorted(affected_endpoints, key=lambda x: x["endpoint"]),
        "integration_name": integration_name,
        "error_message": message,
        # first seen is sticky for the life of the error: keep the original date
        # while the same error recurs, instead of resetting it every crawl
        "created_date": existing_error.get("created_date") or dt_to_str(now()),
        "updated_date": dt_to_str(now()),
        "last_seen": dt_to_str(now()),
    }
    schema_errors = ConnectionsError().schema().validate(row)
    assert not schema_errors, schema_errors
    row["connection_id"] = connection_id
    row["org_id"] = org_id
    return store_resources(table_name, [row])


