def subscribe_to_notification(org_id, email, notification_type):
    """
    create or reactivate a notification subscription
    """
    id_key = f"{notification_type}#{email}"
    id_active = f"{notification_type}#True"

    # check if subscription already exists
    response = event_notifications_table.get_item(Key={"org_id": org_id, "id": id_key})

    if "Item" in response:
        # reactivate existing subscription
        event_notifications_table.update_item(
            Key={"org_id": org_id, "id": id_key},
            UpdateExpression="SET active = :true, id_active = :id_active, updated_at = :now",
            ExpressionAttributeValues={
                ":true": True,
                ":id_active": id_active,
                ":now": dt_to_str(now()),
            },
        )
    else:
        # create new subscription
        event_notifications_table.put_item(
            Item={
                "org_id": org_id,
                "id": id_key,
                "email": email,
