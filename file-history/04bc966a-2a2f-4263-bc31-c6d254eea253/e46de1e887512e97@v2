def write_pickle_to_s3(task, payload, source):
    validate_task_payload(task, payload)
    chunk_size = TASK_CHUNK_SIZE.get(task)
    data = payload["data"]

    # only chunks if task is in TASK_CHUNK_SIZE and data is larger than chunk size
    if chunk_size and len(data) > chunk_size:
        chunks = [data[i : i + chunk_size] for i in range(0, len(data), chunk_size)]
    else:
        chunks = [data]

    current_date = now().strftime("%Y-%m-%d")
    resource = payload["resource"]
    connection_id = str(resource.integration.connection_id)
    retry_count = payload.get("retry_count", 0)
    workflow_id, base_pickle_id = parse_tracking_id(
        payload.get("tracking_id"), source, retry_count
    )

    tracking_ids = []
    for i, chunk_data in enumerate(chunks):
        chunk_payload = {**payload, "data": chunk_data}
        pickle_id = f"{base_pickle_id}_{i}" if len(chunks) > 1 else base_pickle_id
        key = f"{connection_id}/{current_date}/{workflow_id}/{pickle_id}.pkl"
        tracking_id = f"{workflow_id}/{pickle_id}"
        chunk_payload["tracking_id"] = tracking_id
        metadata = {
            "source": source,
            "tracking_id": tracking_id,
            "connection_id": connection_id,
            "retry_count": str(retry_count),
        }
        TASK_BUCKETS[task].put_object(
            Key=key, Body=pickle.dumps(chunk_payload), Metadata=metadata
        )
        tracking_ids.append(tracking_id)

    return tracking_ids


def parse_tracking_id(tracking_id, source, retry_count):
    if not tracking_id:
        timestamp = now().strftime("%H%M%S")
        workflow_id = f"{source}_{timestamp}_{uuid.uuid4().hex[:8]}"
    else:
        workflow_id = tracking_id.split("/")[0]
    if retry_count > 0:
        pickle_id = f"{tracking_id.split('/')[1]}_retry_{retry_count}"
    else:
        pickle_id = uuid.uuid4().hex[:8]
    return workflow_id, pickle_id


# large field offloading


def offload_large_fields(table_name, row):
    # collect all list/dict fields with sizes, sorted largest first
    sized_fields = []
    for field, value in row.items():
        if not isinstance(value, (dict, list)) or field == "refs":
            continue
        # sorted keys, so the same content hashes the same in any vendor key order
        serialized = orjson.dumps(value, option=orjson.OPT_SORT_KEYS)
        sized_fields.append((field, serialized, len(serialized)))
    sized_fields.sort(key=lambda x: x[2], reverse=True)

    # offload fields individually exceeding threshold
    to_offload = []
    remaining = []
    for f, s, sz in sized_fields:
        if sz > LARGE_FIELD_THRESHOLD:
            to_offload.append((f, s))
        else:
            remaining.append((f, s, sz))
    # no single field over threshold but combined may exceed dynamo 400kb limit,
    # iteratively offload largest remaining until under threshold
    while remaining and sum(sz for _, _, sz in remaining) > LARGE_FIELD_THRESHOLD:
        f, s, sz = remaining.pop(0)
        to_offload.append((f, s))
    if not to_offload:
        return row

    # the caller keeps its full row; only the copy headed for dynamo loses the field
    row = dict(row)
    refs = dict(row.get("refs", {}))
    resource_name = table_name.rsplit("-", 1)[0]
    client = resource_bucket.meta.client
    for field, serialized in to_offload:
        checksum = base64.b64encode(hashlib.sha256(serialized).digest()).decode()
        s3_key = f"{resource_name}/{row['connection_id']}/{row['id']}/{field}.json"
        stored_checksum = None
        version_id = None
        try:
            head = client.head_object(
                Bucket=RESOURCE_BUCKET_NAME, Key=s3_key, ChecksumMode="ENABLED"
            )
            # objects written before we sent a checksum have none
            stored_checksum = head.get("ChecksumSHA256")
            version_id = head["VersionId"]
        except ClientError as e:
            if e.response["Error"]["Code"] not in ("404", "NoSuchKey", "NotFound"):
                raise
        # same content keeps the stored version, so the ref changes only when the
        # content does and the diff can see it
        if stored_checksum != checksum:
            logger.info(
                f"Offloading large field {field} for {resource_name} {row['id']}"
            )
            put = client.put_object(
                Bucket=RESOURCE_BUCKET_NAME,
                Key=s3_key,
                Body=serialized,
                ChecksumSHA256=checksum,
            )
            version_id = put["VersionId"]
        refs[field] = {"key": s3_key, "hash": checksum, "version_id": version_id}
        row[field] = [] if isinstance(row[field], list) else {}
    row["refs"] = refs
    return row


def offload_large_fields_in_rows(table_name, rows):
    offloaded = []
    for row in rows:
        offloaded.append(offload_large_fields(table_name, row))
    return offloaded


def hydrate_large_fields(row, strict=False):
    refs = row.pop("refs", {})
    for field, ref in refs.items():
        # a value written inline after the field was offloaded is newer than the ref
        if row.get(field):
            continue
        try:
            # rows offloaded before the hash moved into the ref hold the bare key
            if isinstance(ref, dict):
                obj = resource_bucket.Object(ref["key"])
                obj = obj.get(VersionId=ref["version_id"])
            else:
                obj = resource_bucket.Object(ref).get()
            row[field] = orjson.loads(obj["Body"].read())
        except Exception as e:
            # the webhook lambda would rather retry than send the field empty; a
            # read keeps serving the row
            if strict:
                raise
            logger.error(f"Failed to hydrate field {field} from S3: {e}")
    return row


