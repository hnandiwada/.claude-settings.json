# process-local cache for Secrets Manager; keeps GetSecretValue + KMS Decrypt
# out of the hot path. no TTL — pokedex secrets don't rotate in-place, so
# cached values are valid for the process lifetime. redeploy/restart to
# pick up a rotated secret.
_secret_cache = {}

# process-local cache for DDB table metadata (key_schema, GSIs). schemas are
# effectively immutable during a process lifetime, so no TTL needed. without
# this, every query triggers a DescribeTable via boto3's lazy attribute access.
_table_meta_cache = {}

# process-local TTL caches for the per-request auth hot path. every API call
# reads the api-keys table to validate the key and the orgs table to resolve the
# org; without this, one customer's burst can throttle the shared api-keys table
# and degrade auth for everyone. entries are {value, expires_at}. the write
# functions below pop their entry so a change lands right away in that process;
# other warm containers pick it up when their TTL expires.
_api_key_row_cache = {}
_org_row_cache = {}


def get_table_meta(table_name):
    # callers pass `table.name` — that's a boto3 resource *identifier* set at
    # construction time (dynamodb.Table("foo") → .name == "foo") and does NOT
    # trigger DescribeTable. only *loaded* attributes (.key_schema,
    # .global_secondary_indexes, .table_arn, etc.) hit the wire, which is why
    # we cache their lookup below.
    meta = _table_meta_cache.get(table_name)
    if meta is None:
        table = dynamodb.Table(table_name)
        meta = {
            "key_schema": table.key_schema,
            "global_secondary_indexes": table.global_secondary_indexes or [],
        }
        _table_meta_cache[table_name] = meta
    return meta


