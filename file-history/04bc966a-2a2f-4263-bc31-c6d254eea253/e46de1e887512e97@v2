def create_connections_row(row):
    existing_row = None
    try:
        existing_row = get_connections_row(row["id"])
        if existing_row == row:
            return
        else:
            # Row exists but integration_secret is different, update it
            update_connections_row(
                row["id"], {"integration_secret": row["integration_secret"]}
            )
            return
    except Exception:
        pass

    connections_table.put_item(Item=row)
    if (
        STAGE == "prod"
        and "sandbox" not in row["integration_name"]
        and row["org_id"] not in SKIP_GROWTH_ORG_IDS
    ):
        try:
            # remove integration_secret from row
            row.pop("integration_secret")
            org = get_org_row(row["org_id"])
            # prioritize most important first
            priority_row = {
                "org_name": org["name"],
                "integration_name": row["integration_name"],
                "customer_id": row["customer_id"],
                "id": row["id"],
                "integration_type": row["integration_type"],
            }
            # sort keys for consistent formatting
            row = {k: row[k] for k in sorted(row)}
            for k in row:
                if k not in priority_row:
                    priority_row[k] = row[k]
            formatted_text = "\n".join(
                [f"*{key}*: {value}" for key, value in priority_row.items()]
            )
            title = "New Connection Created!"
            send_slack_webhook(SLACK_GROWTH_CHANNEL, title, formatted_text)
        except Exception as e:
            logger.error(e)


