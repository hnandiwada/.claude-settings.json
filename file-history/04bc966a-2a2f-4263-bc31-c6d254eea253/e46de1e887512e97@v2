def read_webhook_payload(org_id, payload_id):
    # the key is built from the caller's own authenticated org, so a payload id
    # guessed from another org just misses instead of reading their data
    key = webhook_payload_key(org_id, payload_id)
    try:
        s3_client.head_object(Bucket=WEBHOOK_PAYLOAD_BUCKET_NAME, Key=key)
    except ClientError:
        return None

    # always a link, even for an event small enough to return whole, so there is
    # one shape to code against and it gets exercised on every fetch
    expires_at = now() + timedelta(seconds=PRESIGNED_URL_EXPIRATION)
    return {
        "download_url": s3_client.generate_presigned_url(
            "get_object",
            Params={"Bucket": WEBHOOK_PAYLOAD_BUCKET_NAME, "Key": key},
            ExpiresIn=PRESIGNED_URL_EXPIRATION,
        ),
        "download_url_expires_at": dt_to_str(expires_at),
    }


# dynamo


def get_table_keys(table):
    keys = {}
    meta = get_table_meta(table.name)
    for schema in meta["key_schema"]:
        if schema["KeyType"] == "HASH":
            keys["primary"] = schema["AttributeName"]
        elif schema["KeyType"] == "RANGE":
            keys["sort"] = schema["AttributeName"]
    return keys


def query(table_name, query_args, filters):
    table = dynamodb.Table(table_name)
    response = table.query(**query_args)
    if "Items" in response:
        items = response["Items"]
        for f in filters:
            items = list(filter(f, items))
        response["Items"] = items
    return response


def query_paginated(table_name, query_args, filters):
    response = query(table_name, query_args, filters)
    items = response["Items"]
    while "LastEvaluatedKey" in response:
        query_args["ExclusiveStartKey"] = response["LastEvaluatedKey"]
        response = query(table_name, query_args, filters)
        items.extend(response["Items"])
    return items


def scan_paginated(table_name, scan_args):
    table = dynamodb.Table(table_name)
    response = table.scan(**scan_args)
    items = response["Items"]
    while "LastEvaluatedKey" in response:
        response = table.scan(
            ExclusiveStartKey=response["LastEvaluatedKey"], **scan_args
        )
        items.extend(response["Items"])
    return items


def query_single_page(table_name, query_args, filters, exclusive_start_key=None):
    if exclusive_start_key:
        query_args["ExclusiveStartKey"] = json.loads(
            base64.b64decode(exclusive_start_key).decode("utf-8")
        )
    response = query(table_name, query_args, filters)
    next_token = None
    if response.get("LastEvaluatedKey"):
        next_token = base64.b64encode(
            json.dumps(response["LastEvaluatedKey"]).encode("utf-8")
        ).decode("utf-8")
    return response["Items"], next_token


def scan_single_page(table, scan_args, exclusive_start_key=None):
    if exclusive_start_key:
        scan_args["ExclusiveStartKey"] = json.loads(
            base64.b64decode(exclusive_start_key).decode("utf-8")
        )
    response = table.scan(**scan_args)
    next_token = None
    if response.get("LastEvaluatedKey"):
        next_token = base64.b64encode(
            json.dumps(response["LastEvaluatedKey"]).encode("utf-8")
        ).decode("utf-8")
    return response["Items"], next_token


def get_best_index(table, query_params):
    table_indexes = get_table_meta(table.name)["global_secondary_indexes"]
    for idx in table_indexes:
        if idx["IndexStatus"] != "ACTIVE":
            continue
        for key in query_params:
            if key != idx["IndexName"]:
                continue
            for operator in query_params[key]:
                op = operator
                if operator.endswith("-insensitive"):
                    op = operator[:-12]
                # neq, in, and nin are not supported
                if op not in ["neq", "in", "nin"]:
                    return idx


operator_to_lambda_filter = {
    "eq": lambda row, p, v: row[p] == v,
    "neq": lambda row, p, v: row[p] != v,
    "gt": lambda row, p, v: row[p] > v,
    "lt": lambda row, p, v: row[p] < v,
    "gte": lambda row, p, v: row[p] >= v,
    "lte": lambda row, p, v: row[p] <= v,
    "in": lambda row, p, v: row[p] in v,
    "nin": lambda row, p, v: row[p] not in v,
    "contains": lambda row, p, v: v in row[p],
    "not_contains": lambda row, p, v: v not in row[p],
}


def generate_filter_wrapper(p, v, raw_filter):
    def full_filter(row):
        return raw_filter(row, p, v)

    return full_filter


def create_dynamo_args(
    table_name, primary_value, sec_value="", key_names={}, query_params={}
):
    if sec_value and query_params:
        raise Exception("Cannot have both secondary key and query_params")
    table = dynamodb.Table(table_name)
    if not key_names:
        key_names = get_table_keys(table)
    key_expression = Key(key_names["primary"]).eq(primary_value)
    if sec_value:
        key_expression = key_expression & Key(key_names["sort"]).eq(sec_value)
    index = get_best_index(table, query_params)
    # the range attribute to build key conditions on: the field itself for a
    # normal index, or the gsi_<field> shadow for a nullable one. the GSI is still
    # named for the field — e.g. for ?reference_id=X, get_best_index returns
    #   index = {"IndexName": "reference_id", "KeySchema": [
    #       {"AttributeName": "connection_id",    "KeyType": "HASH"},
    #       {"AttributeName": "gsi_reference_id", "KeyType": "RANGE"}]}
    # so index_key_attr resolves to "gsi_reference_id".
    index_key_attr = None
    if index:
        for index_key in index["KeySchema"]:
            if index_key["KeyType"] == "RANGE":
                index_key_attr = index_key["AttributeName"]
    formatted_filters = []
    attr_values = {}
    attr_names = {}
    page_token = None
    limit = MIN_API_RETURN_SIZE
    # indexed fields can only handle one filter
    unapplied_filters = []
    for param, entry in query_params.items():
        # given an input like ?order_number[eq]=12345&order_number[gt]=999
        # query_params will be {"order_number": {"eq":      "12345", "gt":      "999"}}
        #                        ^param           ^operator  ^value   ^operator  ^value
        # if it's like ?order_number[in]=foo&order_number[in]=bar
        # query_params will be {"order_number": {"in":       ["foo", "bar"]}}
        #                        ^param           ^operator  ^value is the whole list
        # `lookup_param` (set below) is what `param` resolves to as the attribute we
        # actually look up by: the field itself, or its gsi_<field> shadow for a
        # nullable index (so ?reference_id= looks up by gsi_reference_id).
        if param == "page_token":
            page_token = entry["eq"]
            continue
        if param == "limit":
            # clamp to MIN_API_RETURN_SIZE so the first ddb page can't
            # hydrate past the 6mb lambda response payload limit
            raw_limit = int(entry["eq"])
            limit = min(raw_limit, MIN_API_RETURN_SIZE)
            continue

        lookup_param = param
        if index and param == index["IndexName"] and index_key_attr:
            lookup_param = index_key_attr

        # indexed field with both gte and lte: use between as a single key condition
        skip_operators = set()
        if index and param == index["IndexName"] and "gte" in entry and "lte" in entry:
            gte_val = entry["gte"]
            lte_val = entry["lte"]
            if gte_val > lte_val:
                raise ValidationError(
                    f"Invalid query parameter: {param} gte value of {gte_val} > lte value of {lte_val}"
                )
            key_expression = key_expression & Key(lookup_param).between(
                gte_val, lte_val
            )
            skip_operators = {"gte", "lte"}

        for operator, value in entry.items():
            if operator in skip_operators:
                continue

            operator_attr_values = {}
            if not isinstance(value, list):
                attr_value = f":{param}_{operator}"
                # e.g. :order_number_eq
                if operator == "is_null":
                    value = None
                operator_attr_values[attr_value] = value
                # is_null compares against None, not the boolean operator_value
                value_in_filter = attr_value
            else:
                # for instances of in and nin
                # and sometimes contains + not contains (for example, tags[contains])
                # where the parameter is a CommaSeparatedList
                attr_value_list = []
                for idx, val_elem in enumerate(value):
                    attr_value = f":{param}_{operator}_{idx}"
                    attr_value_list.append(attr_value)
                    # e.g. :order_number_in_0 and :order_number_in_1
                    operator_attr_values[attr_value] = val_elem
                if operator in ["in", "nin"]:
                    # these are part of the same filter, comma joined
                    # #{param} IN (:param_in_0, :param_in_1)
                    value_in_filter = ", ".join(attr_value_list)
                else:  # contains, not_contains
                    # if this is a list, these are ANDed together - values in different filters
                    # contains(param, :value1) AND contains(param, :value2)
                    value_in_filter = attr_value_list

            operator_to_ddb_key = {
                "eq": Key(lookup_param).eq(value),
                "gt": Key(lookup_param).gt(value),
                "lt": Key(lookup_param).lt(value),
                "gte": Key(lookup_param).gte(value),
                "lte": Key(lookup_param).lte(value),
            }
            operator_to_ddb_filter = {
                "eq": [f"#{param} = {value_in_filter}"],
                "neq": [f"#{param} <> {value_in_filter}"],
                "gt": [f"#{param} > {value_in_filter}"],
                "lt": [f"#{param} < {value_in_filter}"],
                "gte": [f"#{param} >= {value_in_filter}"],
                "lte": [f"#{param} <= {value_in_filter}"],
                "in": [f"#{param} IN ({value_in_filter})"],
                "nin": [f"NOT #{param} IN ({value_in_filter})"],
                "contains": (
                    [f"contains (#{param}, {vf})" for vf in value_in_filter]
                    if isinstance(value_in_filter, list)
                    else [f"contains (#{param}, {value_in_filter})"]
                ),
                "not_contains": (
                    [f"NOT contains (#{param}, {vf})" for vf in value_in_filter]
                    if isinstance(value_in_filter, list)
                    else [f"NOT contains (#{param}, {value_in_filter})"]
                ),
                "is_null": (
                    [f"#{param} = {value_in_filter}"]
                    if entry[operator] is True
                    else [f"#{param} <> {value_in_filter}"]
                ),
            }

            if not index or (index and param != index["IndexName"]):
                attr_names[f"#{param}"] = param
                attr_values.update(operator_attr_values)
                ddb_filters = operator_to_ddb_filter[operator]
                formatted_filters.extend(ddb_filters)
            elif (
                operator in ["neq", "in", "nin", "contains", "not_contains"]
                or key_expression.expression_operator == "AND"
            ):
                raw_lambda_filter = operator_to_lambda_filter[operator]
                lambda_filter = generate_filter_wrapper(param, value, raw_lambda_filter)
                unapplied_filters.append(lambda_filter)
            else:
                key_expression = key_expression & operator_to_ddb_key[operator]

    dynamo_args: dict[str, object] = {
        "KeyConditionExpression": key_expression,
        "ExpressionAttributeValues": attr_values,
        "ExpressionAttributeNames": attr_names,
    }
    if index:
        dynamo_args["IndexName"] = index["IndexName"]
    filter_expression = " AND ".join(formatted_filters)
    if filter_expression:
        dynamo_args["FilterExpression"] = filter_expression
    if page_token:
        decoded_page_token = base64.b64decode(page_token)
        loaded_page_token = json.loads(decoded_page_token)
        expected_token_keys = set(key_names.values())
        if index and index_key_attr:
            expected_token_keys.add(index_key_attr)
        if expected_token_keys != set(loaded_page_token.keys()):
            raise ValidationError("Invalid page token. Did you change the filters?")
        dynamo_args["ExclusiveStartKey"] = loaded_page_token
    dynamo_args["Limit"] = limit
    return dynamo_args, unapplied_filters


def dict_to_dynamo(obj):
    result = {}
    for key, member in obj.items():
        if isinstance(member, float):
            member = decimal.Decimal(str(member))
        elif isinstance(member, dict):
            member = dict_to_dynamo(member)
        elif isinstance(member, list):
            formatted_list = []
            for elem in member:
                if isinstance(elem, float):
                    elem = decimal.Decimal(str(elem))
                elif isinstance(elem, dict):
                    elem = dict_to_dynamo(elem)
                # shouldn't need to handle list of list
                formatted_list.append(elem)
            member = formatted_list
        result[key] = member
    return result


def dynamo_to_dict(obj, hydrate=True):
    result = {}
    for key, member in obj.items():
        if isinstance(member, decimal.Decimal):
            if int(member) == float(member):
                member = int(member)
            else:
                member = float(member)
        elif isinstance(member, dict):
            member = dynamo_to_dict(member)
        elif isinstance(member, list):
            formatted_list = []
            for elem in member:
                if isinstance(elem, decimal.Decimal):
                    if int(elem) == float(elem):
                        elem = int(elem)
                    else:
                        elem = float(elem)
                elif isinstance(elem, dict):
                    elem = dynamo_to_dict(elem)
                # shouldn't need to handle list of list
                formatted_list.append(elem)
            member = formatted_list
        result[key] = member

    if hydrate:
        hydrate_large_fields(result)
    return result


