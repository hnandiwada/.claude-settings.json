def list_raw_files(
    archive_prefix: str,
    start_time: str,
    end_time: str,
    limit: int = 100,
    continuation_token: str = None,
    file_type: str = None,
    file_name: str = None,
) -> dict:
    prefix = archive_prefix

    list_kwargs = {
        "Bucket": CARRIER_BUCKET_NAME,
        "Prefix": prefix,
        "MaxKeys": 1000,
    }

    if continuation_token:
        decoded = base64.b64decode(continuation_token).decode("utf-8")
        list_kwargs["StartAfter"] = decoded

    files = []
    exhausted = False
    while not exhausted:
        response = s3_client.list_objects_v2(**list_kwargs)

        for obj in response.get("Contents", []):
            key = obj["Key"]

            # skip directories (size 0)
            if obj["Size"] == 0:
                continue

            entry_name = key.split("/")[-1]
            # a key ending in / has no file name, which the files schema rejects
            if not entry_name:
                continue

            relative = key[len(prefix) :].lstrip("/")
            file_date = relative.split("/")[0]
            if len(file_date) == 10:
                file_date = f"{file_date}T00:00:00Z"

            # s3 keys are sorted, so past end_time means no more matches
            if file_date > end_time:
                exhausted = True
                break

            if file_date < start_time:
                continue

            ext = entry_name.split(".")[-1].lower() if "." in entry_name else None
            if file_type and ext and ext != file_type:
                continue

            if file_name and file_name.lower() not in entry_name.lower():
                continue

            files.append(
                {
                    "key": key,
                    "file_name": entry_name,
                    # the key's date folder is the crawl start, not the file's time
                    "created_date": dt_to_str(obj["LastModified"]),
                    "file_type": ext,
                }
            )

            if len(files) >= limit:
                break

        if len(files) >= limit or not response.get("IsTruncated"):
            break

        list_kwargs["ContinuationToken"] = response["NextContinuationToken"]
        list_kwargs.pop("StartAfter", None)

    next_token = None
    if len(files) >= limit:
        next_token = base64.b64encode(files[-1]["key"].encode("utf-8")).decode("utf-8")

    return {
        "data": files[:limit],
        "total_count": len(files[:limit]),
        "next_token": next_token,
    }


def generate_download_urls(
    files: list, expiration: int = PRESIGNED_URL_EXPIRATION
) -> list:
    expires_at = now() + timedelta(seconds=expiration)

    for file in files:
        file["download_url"] = s3_client.generate_presigned_url(
            "get_object",
            Params={
                "Bucket": CARRIER_BUCKET_NAME,
                "Key": file["key"],
            },
            ExpiresIn=expiration,
        )
        file["download_url_expires_at"] = dt_to_str(expires_at)
    return files


IDEMPOTENCY_IN_PROGRESS = "in_progress"
IDEMPOTENCY_SUCCEEDED = "succeeded"


def idempotency_key_dynamo_key(connection_id, idempotency_key):
    return {"connection_id": connection_id, "idempotency_key": idempotency_key}


def create_idempotency_key_row(
    connection_id, idempotency_key, request_hash, request_id
):
    # returns None when the row was created, else the row that already exists
    now_ts = int(time.time())
    row = {
        "connection_id": connection_id,
        "idempotency_key": idempotency_key,
        "status": IDEMPOTENCY_IN_PROGRESS,
        "request_hash": request_hash,
        "request_id": request_id,
        "created_at": now_ts,
        "expires_at": now_ts + IDEMPOTENCY_KEY_TTL_SECONDS,
    }
    for attempt in range(2):
        try:
            idempotency_keys_table.put_item(
                Item=row,
                # dynamo deletes expired rows late, so one still on the table is free,
                # as is one left in progress by a request that died before finishing
                ConditionExpression=Attr("connection_id").not_exists()
                | Attr("expires_at").lte(now_ts)
                | (
                    Attr("status").eq(IDEMPOTENCY_IN_PROGRESS)
                    & Attr("created_at").lte(
                        now_ts - IDEMPOTENCY_KEY_STILL_RUNNING_SECONDS
                    )
                ),
            )
            return None
        except ClientError as e:
            if e.response["Error"]["Code"] != "ConditionalCheckFailedException":
                raise
        existing = get_idempotency_key_row(connection_id, idempotency_key)
        if existing is not None:
            return existing
        # the other request deleted its row between our put and get, so try the
        # put once more
    raise RuntimeError(
        f"could not create idempotency_key row {idempotency_key} for {connection_id}"
    )


def get_idempotency_key_row(connection_id, idempotency_key):
    rsp = idempotency_keys_table.get_item(
        Key=idempotency_key_dynamo_key(connection_id, idempotency_key),
        ConsistentRead=True,
    )
    if "Item" not in rsp:
        return None
    return dynamo_to_dict(rsp["Item"])


def mark_idempotency_key_succeeded(
    connection_id, idempotency_key, write_ids, batch, skip_retrieval, response
):
    idempotency_keys_table.update_item(
