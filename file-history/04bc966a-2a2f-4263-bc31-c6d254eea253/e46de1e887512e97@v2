def upload_custom_logo_for_org(org_id, base64_image):
    """
    Upload a base64-encoded image to S3 as a PNG file.

    Args:
        org_id: The organization ID to use as the filename
        base64_image: Base64-encoded image string (format: 'data:image/...;base64,...')

    Returns:
        bool: True if upload was successful

    Raises:
        ValueError: If the input is not a valid base64-encoded image
        Exception: For any S3 upload errors
    """
    try:
        if not isinstance(base64_image, str) or not base64_image.startswith(
            "data:image/"
        ):
            raise ValueError(
                "Input must be a base64-encoded image string starting with 'data:image/'"
            )

        # Extract the base64-encoded part after the comma
        file_content = base64.b64decode(base64_image.split(",", 1)[1])

        if not file_content:
            raise ValueError("Decoded image data is empty")

        # Upload to S3 with .png extension
        custom_logos_bucket.put_object(
            Key=f"{org_id}.png",
            Body=file_content,
            ContentType="image/png",
        )
        return True

    except Exception as e:
        print(f"Error uploading file: {str(e)}")
        print(f"Input type: {type(base64_image)}")
        if "file_content" in locals():
            print(f"Decoded size: {len(file_content)} bytes")
        raise


