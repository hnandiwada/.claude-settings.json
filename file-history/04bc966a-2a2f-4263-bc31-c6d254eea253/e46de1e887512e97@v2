def set_org_integration_disabled_functions(
    org_id, integration_name, disabled_functions
):
    # set just one integration's entry in the map without reading it first: a plain
    # read-modify-write of the whole map loses a concurrent write to a different
    # integration. dynamo won't let one update both create the map and write a key
    # inside it (overlapping paths), so write the nested key when the map already
    # exists, and otherwise seed the map with just this entry. attribute_exists /
    # attribute_not_exists keep both branches safe against a racing writer; if the map
    # appears between the two attempts we retry and take the nested-write branch.
    names = {"#map": "disabled_functions_by_integration", "#name": integration_name}
    for _ in range(3):
        try:
            result = orgs_table.update_item(
                Key={"id": org_id},
                UpdateExpression="SET #map.#name = :functions",
                ConditionExpression="attribute_exists(#map)",
                ExpressionAttributeNames=names,
                ExpressionAttributeValues={":functions": disabled_functions},
                ReturnValues="ALL_NEW",
            )
            _org_row_cache.pop(org_id, None)
            return result
        except ClientError as e:
            if e.response["Error"]["Code"] != "ConditionalCheckFailedException":
                raise
        try:
            result = orgs_table.update_item(
                Key={"id": org_id},
                UpdateExpression="SET #map = :seed",
                ConditionExpression="attribute_not_exists(#map)",
                ExpressionAttributeNames={"#map": "disabled_functions_by_integration"},
                ExpressionAttributeValues={
                    ":seed": {integration_name: disabled_functions}
                },
                ReturnValues="ALL_NEW",
            )
            _org_row_cache.pop(org_id, None)
            return result
        except ClientError as e:
            if e.response["Error"]["Code"] != "ConditionalCheckFailedException":
                raise
            # a racing writer created the map first; loop back to the nested write
    raise Exception(
        f"could not set disabled_functions_by_integration for org {org_id} after retries"
    )


def set_org_type_disabled_functions(org_id, integration_type, disabled_functions):
    # update only this type's entry, leaving the other types alone. we don't read the whole
