# a month is closed when its marker row says so, not when it has rows in it. the
# marker is claimed before the first invoice is written, so a second closer stops
# before storing anything, and it only flips to closed once every invoice is in.
# the claim's timestamp doubles as a fencing token: a reclaim after a stale claim
# is strictly newer, so every write can prove it isn't from an abandoned closer.
BILLING_MONTH_MARKER = "#status"


def claim_billing_month(month):
    claim_token = dt_to_str(now())
    marker = {
        "month": month,
        "org_id": BILLING_MONTH_MARKER,
        "state": "closing",
        "claimed_at": claim_token,
    }
    stale_before = dt_to_str(now() - timedelta(minutes=BILLING_MONTH_CLAIM_MINUTES))
    try:
        billing_invoices_table.put_item(
            Item=dict_to_dynamo(marker),
            # a closed month is never reclaimed, and neither is one another
            # request is closing right now; a claim left behind by a request that
            # died goes stale so the month can be closed later
            ConditionExpression=Attr("org_id").not_exists()
            | Attr("state").eq("reopened")
            | (Attr("state").eq("closing") & Attr("claimed_at").lt(stale_before)),
        )
    except ClientError as e:
        if e.response["Error"]["Code"] != "ConditionalCheckFailedException":
            raise
        return None
    return claim_token


def commit_billing_month(month, invoice_count, claim_token):
    try:
        billing_invoices_table.update_item(
            Key={"month": month, "org_id": BILLING_MONTH_MARKER},
            UpdateExpression=(
                "SET #state = :closed, invoice_count = :count, closed_at = :closed_at"
            ),
            # only the claim holder may finalize; a closer resuming after its
            # claim went stale and was taken over must fail, not commit
            ConditionExpression=Attr("state").eq("closing")
            & Attr("claimed_at").eq(claim_token),
            ExpressionAttributeNames={"#state": "state"},
            ExpressionAttributeValues={
                ":closed": "closed",
                ":count": invoice_count,
                ":closed_at": dt_to_str(now()),
            },
        )
    except ClientError as e:
        if e.response["Error"]["Code"] != "ConditionalCheckFailedException":
            raise
        return False
    return True


# None until the month is committed, so an interrupted close reads as open and
# is recomputed rather than served as a half-written final answer — while a
# month closed with nothing billed stays an empty final answer rather than
# springing back to life when a rule is added later. only rows written by the
# committed claim count: an abandoned earlier close can leave rows for orgs the
# finishing close no longer computes (a rule deleted in between), and those
# must not surface as part of the final month.
def get_billing_invoices_for_month(month, consistent=False):
    rows = []
    committed_token = None
    kwargs = {
        "KeyConditionExpression": Key("month").eq(month),
        "ConsistentRead": consistent,
    }
    while True:
        response = billing_invoices_table.query(**kwargs)
        for item in response["Items"]:
            row = dynamo_to_dict(item)
            if row["org_id"] == BILLING_MONTH_MARKER:
                if row["state"] == "closed":
                    committed_token = row["claimed_at"]
                continue
            rows.append(row)
        if "LastEvaluatedKey" not in response:
            break
        kwargs["ExclusiveStartKey"] = response["LastEvaluatedKey"]
    if committed_token is None:
        return None
    invoices = []
    for row in rows:
        if row["claim_token"] == committed_token:
            invoices.append(row)
    return invoices


# callers reject edits based on this, so it must not miss a month that was
# closed a moment ago
# flips the month back to live computation; the marker keeps state=reopened so
# the reopen shows in the record and a later close is allowed to reclaim it
def reopen_billing_month(month):
    try:
        billing_invoices_table.update_item(
            Key={"month": month, "org_id": BILLING_MONTH_MARKER},
            UpdateExpression="SET #state = :reopened, reopened_at = :at",
            ConditionExpression=Attr("state").eq("closed"),
            ExpressionAttributeNames={"#state": "state"},
            ExpressionAttributeValues={
                ":reopened": "reopened",
                ":at": dt_to_str(now()),
            },
        )
    except ClientError as e:
        if e.response["Error"]["Code"] != "ConditionalCheckFailedException":
            raise
        return False
    # the frozen rows are dead once the marker is no longer closed; delete them
    # so the next close starts clean
    kwargs = {"KeyConditionExpression": Key("month").eq(month)}
    while True:
        response = billing_invoices_table.query(**kwargs)
        for item in response["Items"]:
            row = dynamo_to_dict(item)
            if row["org_id"] != BILLING_MONTH_MARKER:
                delete_billing_invoice(month, row["org_id"])
        if "LastEvaluatedKey" not in response:
            break
        kwargs["ExclusiveStartKey"] = response["LastEvaluatedKey"]
    return True


def scan_closed_billing_months():
    months = []
    kwargs = {
        "ConsistentRead": True,
        "FilterExpression": Attr("org_id").eq(BILLING_MONTH_MARKER)
        & Attr("state").eq("closed"),
    }
    while True:
        response = billing_invoices_table.scan(**kwargs)
        for item in response["Items"]:
            months.append(dynamo_to_dict(item)["month"])
        if "LastEvaluatedKey" not in response:
            break
        kwargs["ExclusiveStartKey"] = response["LastEvaluatedKey"]
    return sorted(months)


