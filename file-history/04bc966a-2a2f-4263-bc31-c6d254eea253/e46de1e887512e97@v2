def generate_clean_up_crawl_submit_args(key, submit_dict):
    tasks_started = submit_dict["tasks_started"]
    tasks_finished = submit_dict["tasks_finished"]
    if len(tasks_started) < 50 or len(tasks_finished) < 50:
        return
    intersection_to_remove = tasks_started & tasks_finished
    intersection_to_remove.discard("")
    # keep dummy value because dynamo doesn't support empty sets
    logger.info(f"pruning {len(intersection_to_remove)} items")
    if not intersection_to_remove:
        return
    update_expression = "DELETE submit.tasks_started :intersection_to_remove, submit.tasks_finished :intersection_to_remove"
    expression_attribute_values = {":intersection_to_remove": intersection_to_remove}
    update_args = {
        "Key": key,
        "UpdateExpression": update_expression,
        "ExpressionAttributeValues": expression_attribute_values,
    }
    return update_args


