def get_id_for_unique_sku(resource, sku, return_dupes=False):
    query_params = {"sku": {"eq": sku}}
    dynamo_rsp = resource.get_all_resources(query_params)
    if not dynamo_rsp:
        raise PokedexException(
            f"{resource.name()} with sku {sku} not found", 404, origin="trackstar"
        )
    if len(dynamo_rsp) > 1:
        if return_dupes:
            return [item["id"] for item in dynamo_rsp]
        raise PokedexException(
            f"Multiple {resource.name()}s with sku {sku} found", 500, origin="trackstar"
        )
    return dynamo_rsp[0]["id"]


def get_ids_for_unique_skus(resource, skus):
    query_params = {"sku": {"in": skus}}
    dynamo_rsp = resource.get_all_resources(query_params)
    if not dynamo_rsp:
        raise PokedexException(
            f"{resource.name()} with skus {skus} not found", 404, origin="trackstar"
        )
    sku_to_id = {}
    duped_skus = set()
    for item in dynamo_rsp:
        sku = item["sku"]
        if sku in sku_to_id:
            duped_skus.add(sku)
            del sku_to_id[sku]
            continue
        sku_to_id[sku] = item["id"]
    return sku_to_id, duped_skus


