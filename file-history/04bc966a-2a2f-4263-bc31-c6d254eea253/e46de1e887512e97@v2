def batch_get_resources(
    connection_id, resource_name, integration_type, item_ids, hydrate=True
):
    # can also use resource.batch_get_resources()
    resource = resource_map[integration_type][resource_name]()
    table_name = resource.table_name()
    keys = [{"connection_id": connection_id, "id": item_id} for item_id in item_ids]
    chunked_keys = [
        keys[i : i + BATCH_GET_KEY_CHUNK]
        for i in range(0, len(keys), BATCH_GET_KEY_CHUNK)
    ]
    items = []
    for chunk in chunked_keys:
        batch_get_item_request = {"RequestItems": {table_name: {"Keys": chunk}}}
        # retry unprocessed keys
        retries = 0
        max_retries = 5
        unprocessed = {}
        while retries < max_retries:
            response = dynamodb.batch_get_item(**batch_get_item_request)
            items.extend(response["Responses"][table_name])

            # check for unprocessed keys
            unprocessed = response.get("UnprocessedKeys", {})
            if not unprocessed:
                break

            time.sleep(2)
            batch_get_item_request = {"RequestItems": unprocessed}
            retries += 1

        if retries == max_retries and unprocessed:
            raise Exception(
                f"Failed to fetch {len(unprocessed[table_name]['Keys'])} items after {max_retries} retries"
            )

    return [dynamo_to_dict(item, hydrate=hydrate) for item in items]


