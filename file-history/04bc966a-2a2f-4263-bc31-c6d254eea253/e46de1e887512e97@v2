def build_update_item_args(dynamo_row, table_key_names, keys_to_remove=()):
    """
    Build the arguments for DynamoDB update_item.
    Uses condition expressions to only update items that have changed.
    """
    # define the base update expression and condition expression
    update_expressions = []
    condition_expressions = []

    # start condition expression with a check for the primary key and sort key (if it exists)
    new_items_conditions = [f"attribute_not_exists(#{k})" for k in table_key_names]
    new_items_condition = f"({' AND '.join(new_items_conditions)})"
    condition_expressions.append(new_items_condition)

    # mirror logic from get_rows_for_dynamo_webhook
    # skip updated date, and only add created date if it doesn't exist
    for key in dynamo_row.keys():
        # updates
        set_key = f"#{key} = :{key}"
        set_key_if_not_exists = f"#{key} = if_not_exists(#{key}, :{key})"
        # conditions
        write_row_if_new_key = f"attribute_not_exists(#{key})"
        write_row_if_different_key = f"#{key} <> :{key}"

        if key in table_key_names:
            continue
        elif key == "trackstar_updated_date":
            update_expressions.append(set_key)
        # always persist trackstar_created_dates from the first time the object is submitted (immutable)
        elif key == "trackstar_created_date":
            update_expressions.append(set_key_if_not_exists)
        elif key == "trackstar_tags":
            # if None, called via crawler - don't overwrite tags
            # otherwise, called via API - hard overwrite tags
            if dynamo_row[key] is None:
                dynamo_row[key] = []
                condition_expressions.append(write_row_if_new_key)
                update_expressions.append(set_key_if_not_exists)
            else:
                condition_expressions.append(write_row_if_different_key)
                update_expressions.append(set_key)
        else:
            # if the attribute is not a table key, add it to the update expression
            update_expressions.append(set_key)
            condition_expressions.append(write_row_if_new_key)
            condition_expressions.append(write_row_if_different_key)

    expression_attribute_names = {f"#{k}": k for k in dynamo_row.keys()}
    update_expression = f"SET {', '.join(update_expressions)}"
    # clear shadow GSI keys whose source field went null, so the row drops out of
    # the sparse index instead of keeping a stale key (update_item only SETs)
    if keys_to_remove:
        remove_clauses = []
        for remove_key in keys_to_remove:
            remove_clauses.append(f"#{remove_key}")
            expression_attribute_names[f"#{remove_key}"] = remove_key
        update_expression = f"{update_expression} REMOVE {', '.join(remove_clauses)}"

    return {
        "Key": {k: v for k, v in dynamo_row.items() if k in table_key_names},
        "UpdateExpression": update_expression,
        "ConditionExpression": " OR ".join(condition_expressions),
        "ExpressionAttributeNames": expression_attribute_names,
        "ExpressionAttributeValues": {
            f":{k}": v for k, v in dynamo_row.items() if k not in table_key_names
        },
        "ReturnValues": "UPDATED_OLD",
    }


def store_resources(table_name, rows):
    """
    Uses DynamoDB update_item to update or create items in a table.
    Condition expressions ensure we only update items that have changed.
    update_item fails if the item hasn't changed, which we leverage to
    create/update items and dynamically set updated_date.
    """
    if DRY_RUN:
        print(f"DRY RUN: Would have stored {len(rows)} rows in {table_name}")
        return []
    table = dynamodb.Table(table_name)
    table_meta = get_table_meta(table_name)
    # get table's primary and sort key names - these should not be updated
    table_key_names = [key["AttributeName"] for key in table_meta["key_schema"]]
    # nullable indexed fields are indexed via a gsi_<field> shadow (see
    # Resource.nullable_indexes). map each deployed shadow key back to its source
    # field, so every write can mirror the field's value into it — or clear it
    shadow_key_sources = {}
    for gsi in table_meta["global_secondary_indexes"]:
        for gsi_key in gsi["KeySchema"]:
            # the shadow is always the sort (RANGE) key; HASH is connection_id
            if gsi_key["KeyType"] != "RANGE":
                continue
            attribute_name = gsi_key["AttributeName"]
            if attribute_name.startswith("gsi_"):
                shadow_key_sources[attribute_name] = attribute_name[len("gsi_") :]
    updated_or_created_items = []

    for raw_row in rows:
        if "created_date" not in raw_row:
            raise Exception(f"created_date is required: {raw_row}")
        if "updated_date" not in raw_row:
            raise Exception(f"updated_date is required: {raw_row}")

        # copy each nullable index field into its shadow key when set, clear it
        # when explicitly null, and leave it untouched when the source is absent
        # (a partial write) — a present null must never reach a GSI key
        keys_to_remove = []
        if shadow_key_sources:
            # shallow-copy so we never mutate the caller's row dict with shadows
            raw_row = dict(raw_row)
        for shadow_key, source_field in shadow_key_sources.items():
            if source_field not in raw_row:
                continue
            if raw_row[source_field] is None:
                keys_to_remove.append(shadow_key)
                # drop any stale shadow (e.g. a reused/round-tripped row) so we
                # never both SET and REMOVE it — dynamo rejects overlapping paths
                if shadow_key in raw_row:
                    del raw_row[shadow_key]
            else:
                raw_row[shadow_key] = raw_row[source_field]

        # crawler and api rows arrive offloaded; a direct caller's row is offloaded here
        offloaded = offload_large_fields(table_name, raw_row)
        if offloaded is not raw_row:
            # a direct caller never merged refs with the stored row, so keep the
            # stored refs of fields this row does not carry
            stored = table.get_item(
                Key={k: raw_row[k] for k in table_key_names},
                ProjectionExpression="#refs",
                ExpressionAttributeNames={"#refs": "refs"},
                ConsistentRead=True,
            ).get("Item", {})
            for field, ref in stored.get("refs", {}).items():
                if field not in raw_row:
                    offloaded["refs"][field] = ref
        raw_row = offloaded
        dynamo_row = dict_to_dynamo(raw_row)
        update_args = build_update_item_args(
            dynamo_row, table_key_names, keys_to_remove
        )

        try:
            response = table.update_item(**update_args)
        except ClientError as e:
            error_code = e.response["Error"]["Code"]
            if error_code == "ConditionalCheckFailedException":
                # row already exists and is up to date, skip it
                resource_in_dynamo = table.get_item(Key=update_args["Key"])
                existing_item = resource_in_dynamo.get("Item", {})
                dict_to_return = {
                    "new": raw_row,
                    "existing": dynamo_to_dict(existing_item, hydrate=False),
                }
                logger.info(
                    f"Exact row already exists in table {table_name} for item {raw_row.get('id')} and connection_id {raw_row.get('connection_id')}: {dict_to_return}"
                )
                continue
            else:
                logger.error(
                    f"Unexpected error when storing row in table {table_name} for item {raw_row['id']}: {e}"
                )
                raise e
        except Exception as e:
            logger.error(
                f"Unexpected error when storing row in table {table_name} for item {raw_row}: {e}"
            )
            raise e

        # row was either created or updated
        if "Attributes" in response:
            action = "updated"
            old_fields_and_values = response["Attributes"]
        else:
            action = "created"
            old_fields_and_values = {}

        updated_or_created_items.append(
            {
                "action": action,
                "table": table_name,
                "item": raw_row,
                "old_fields_and_values": old_fields_and_values,
            }
        )

    return updated_or_created_items


def get_rows_for_dynamo_webhook(resource, rows):
    # offload before the diff so it compares refs, never the existing row's big fields
    table_name = resource.table_name()
    rows_by_id = {}
    for row in rows:
        rows_by_id[row["id"]] = {
            "new": offload_large_fields(table_name, row),
            "existing": {},
        }
    existing_rows = resource.batch_get_resources(list(rows_by_id), hydrate=False)
    for existing in existing_rows:
        rows_by_id[existing["id"]]["existing"] = existing

    full_schema = resource.complete_item_schema()
    webhook_data_schema = resource.api_item_schema()
    rows_for_dynamo = []
    rows_for_webhook = []
    for row_dict in rows_by_id.values():
        new_row = deepcopy(row_dict["new"])
        existing_row = deepcopy(row_dict["existing"])

        to_store = False
        existing_refs = existing_row.get("refs", {})
        new_refs = new_row.get("refs", {})
        # don't fire a webhook if store_resources didn't update
        for key, value in new_row.items():
            existing_value = existing_row.get(key)
            if key in existing_refs and key not in new_refs:
                # the stored value is in s3 and this one is inline, so they differ
                # even when both read as empty here
                to_store = True
                continue
            if key == "trackstar_created_date":
                # always persist trackstar_created_dates from first submission (immutable)
                new_row[key] = existing_value or value
            elif key in ["trackstar_updated_date", "updated_date"]:
                # don't want to fire if only these changed
                continue
            elif key == "trackstar_tags":
                # if None, called via crawler - don't overwrite tags
                # otherwise, called via API - hard overwrite tags
                if value is None:
                    new_row[key] = existing_value or []
                else:
                    if value == existing_value:
                        continue
                    to_store = True
            elif key not in existing_row:
                to_store = True
                continue
            else:  # key exists in both
                if value == existing_value:
                    continue
                to_store = True
        if not to_store:
            continue

        # keep the stored refs of fields this row does not carry; a field it
        # carries inline replaces its ref
        refs = {}
        for field, ref in existing_refs.items():
            if field not in new_row:
                refs[field] = ref
        refs.update(new_refs)

        try:
            loaded_new_row = full_schema.load(
                deepcopy(new_row), partial=True, unknown="exclude"
            )
            # don't need to validate here
            item_to_store = full_schema.dump(loaded_new_row)
            # doing this to activate hidden fields
        except Exception:
            item_to_store = new_row
        # no schema declares refs, so the dump drops it
        if refs or "refs" in existing_row:
            item_to_store["refs"] = refs

        rows_for_dynamo.append(item_to_store)

        action = "updated"
        if not existing_row:
            action = "created"

        # skip webhook if only difference was removed fields
        try:
            new_webhook_row = webhook_data_schema.dump(new_row)
        except Exception:
            new_webhook_row = new_row
        try:
            existing_webhook_row = webhook_data_schema.dump(existing_row)
        except Exception:
            existing_webhook_row = existing_row
        # rows stored before the org turned on redaction still hold pii
        [existing_webhook_row] = resource.redact_pii([existing_webhook_row])
        # the webhook lambda fetches the big fields itself, from these refs
        if new_refs:
            new_webhook_row["refs"] = new_refs
        if existing_refs:
            existing_webhook_row["refs"] = existing_refs

        if action == "updated":
            # removed subfields still triggered to_store, which updated trackstar_updated_date
            # so we have to ignore that in our comparison
            new_webhook_without_ts_updated = {
                k: v
                for k, v in new_webhook_row.items()
                if k != "trackstar_updated_date"
            }
            existing_webhook_without_ts_updated = {
                k: v
                for k, v in existing_webhook_row.items()
                if k != "trackstar_updated_date"
            }
            if new_webhook_without_ts_updated == existing_webhook_without_ts_updated:
                continue

        row_for_webhook = {
            "action": action,
            "table": table_name,
            "item": new_webhook_row,
            "old_fields_and_values": existing_webhook_row,
        }
        rows_for_webhook.append(row_for_webhook)
    return rows_for_dynamo, rows_for_webhook


def raw_store_resources(table_name, rows):
    table = dynamodb.Table(table_name)
    with table.batch_writer() as batch:
        for row in rows:
            row = dict_to_dynamo(row)
            batch.put_item(Item=row)


def get_subscription(subscription_id):
    table = dynamodb.Table(INTEGRATION_SUBSCRIPTIONS_TABLE)
    response = table.get_item(Key={"subscription_id": subscription_id})
    return response.get("Item")


def store_subscription_row(
    subscription_id,
    connection_id,
    org_id,
    integration_name,
    integration_type,
    notification_type,
    source_type,
):
    table = dynamodb.Table(INTEGRATION_SUBSCRIPTIONS_TABLE)
    existing = table.get_item(
        Key={"subscription_id": subscription_id}, ConsistentRead=True
    ).get("Item")
    if existing:
        # subscription already exists - only shared-subscription integrations (amazon)
        # should hit this branch. ADD is idempotent so re-subscribing is a no-op.
        if integration_name not in INTEGRATIONS_WITH_SHARED_SUBSCRIPTIONS:
            return
        table.update_item(
            Key={"subscription_id": subscription_id},
            UpdateExpression="ADD aliases :alias",
            ExpressionAttributeValues={":alias": {connection_id}},
        )
        return
    item = {
        "subscription_id": subscription_id,
        "connection_id": connection_id,
        "org_id": org_id,
        "integration_name": integration_name,
        "integration_type": integration_type,
        "notification_type": notification_type,
        "source_type": source_type,
        "created_at": dt_to_str(now()),
    }
    # for shared-subscription integrations, always seed aliases so we never have to
    # handle a "first alias-add" special case later
    if integration_name in INTEGRATIONS_WITH_SHARED_SUBSCRIPTIONS:
        item["aliases"] = {connection_id}
    table.put_item(Item=item)


def get_subscription_rows_by_connection_id(connection_id, check_aliases=False):
    table = dynamodb.Table(INTEGRATION_SUBSCRIPTIONS_TABLE)
    filter_expr = Attr("connection_id").eq(connection_id)
    # shared-subscription integrations (see INTEGRATIONS_WITH_SHARED_SUBSCRIPTIONS): also match rows where
    # this connection is an alias of a subscription originally registered by a sibling connection
    if check_aliases:
        filter_expr = filter_expr | Attr("aliases").contains(connection_id)
    response = table.scan(FilterExpression=filter_expr)
    return response.get("Items", [])


def remove_connection_from_subscription_row(subscription_id, connection_id):
    """
    Clear this connection from a subscription row. Non-shared rows (single owner via
    connection_id) are deleted outright; shared rows drop this connection from the
    aliases set and delete the row only when the last owner leaves. Returns True if
    the row is gone (caller should unsubscribe from the upstream API).
    """
    table = dynamodb.Table(INTEGRATION_SUBSCRIPTIONS_TABLE)
    existing = table.get_item(
        Key={"subscription_id": subscription_id}, ConsistentRead=True
    ).get("Item")
    if not existing:
        return True

    aliases = existing.get("aliases")

    # non-shared row (single owner tracked via connection_id)
    if not aliases:
        if existing["connection_id"] == connection_id:
            table.delete_item(Key={"subscription_id": subscription_id})
            return True
        return False

    # shared row - alias dance
    if connection_id not in aliases:
        return False

    remaining = aliases - {connection_id}
    if not remaining:
        table.delete_item(Key={"subscription_id": subscription_id})
        return True

    table.update_item(
        Key={"subscription_id": subscription_id},
        UpdateExpression="DELETE aliases :alias",
        ExpressionAttributeValues={":alias": {connection_id}},
    )
    return False


# consistent with store_resources: table keys are immutable,
# created_date is set once via if_not_exists, tags are api-specific not touched by crawls/webhooks
BANNED_PARTIAL_UPDATE_FIELDS = {
    "connection_id",
    "id",
    "created_date",
    "trackstar_created_date",
    "trackstar_tags",
}


def prepare_partial_update(resource, resource_id, updates):
    # allow callers to pass full formatter output (which always includes id)
    # verify it matches the resource_id, then strip so the banned-field check passes
    if "id" in updates:
        if updates["id"] != resource_id:
            raise Exception(
                f"id mismatch in partial update: fields id={updates['id']} vs resource_id={resource_id}"
            )
        updates = {k: v for k, v in updates.items() if k != "id"}
    for field in BANNED_PARTIAL_UPDATE_FIELDS:
        if field in updates:
            raise Exception(f"Cannot partially update protected field: {field}")

    # validate against resource schema
    schema = resource.schema(partial=True)
    validated = schema.load(updates, partial=True, unknown="exclude")
    validated = schema.dump(validated)

    # fetch existing row
    try:
        existing = resource.get_resource(resource_id)
    except ResourceNotFoundException:
        return None

    # dicts merge in place (e.g. fba additional_fields.listing_status updates without overwriting asin, product_type, etc).
    # lists are a hard overwrite since they represent the full current value
    now_str = dt_to_str(now())
    merged = {**existing}
    for key, value in validated.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = {**merged[key], **value}
        else:
            merged[key] = value
    merged["updated_date"] = now_str
    merged["trackstar_updated_date"] = now_str
    return merged


def get_all_resources(
    connection_id,
    resource_name,
    integration_type,
    query_params={},
) -> list:
    # IMPORTANT: whenever possible, use resource.get_all_resources()
    # otherwise, resources_queried won't work

    # dynamo caps an `in` filter at 100 operands and counts duplicates toward
    # that cap, so dedupe each one; anything still over 100 has to be chunked.
    deduped_params = {}
    oversized_in_field = None
    for param, entry in query_params.items():
        in_values = entry.get("in")
        if in_values:
            in_values = list(set(in_values))
            entry = {**entry, "in": in_values}
            if len(in_values) > MAX_IN_OPERANDS:
                if oversized_in_field:
                    raise Exception("cannot chunk more than one oversized `in` filter")
                oversized_in_field = param
        deduped_params[param] = entry
    query_params = deduped_params

    if oversized_in_field:
        # split the oversized filter into 100-value queries and merge the rows
        # (e.g. resolving products for a 100+ line order)
        all_values = query_params[oversized_in_field]["in"]
        chunked_resources = []
        for start in range(0, len(all_values), MAX_IN_OPERANDS):
            value_chunk = all_values[start : start + MAX_IN_OPERANDS]
            # deepcopy so this chunk's values don't bleed into the next one
            chunk_params = deepcopy(query_params)
            chunk_params[oversized_in_field]["in"] = value_chunk
            chunked_resources.extend(
                get_all_resources(
                    connection_id, resource_name, integration_type, chunk_params
                )
            )
        return chunked_resources

    resource = resource_map[integration_type][resource_name]()
    table_name = resource.table_name()

    # the status index can only look up one status at a time, so a filter like
    # "not fulfilled" reads every stored row. look up each wanted status instead
    table = dynamodb.Table(table_name)
    only_filter_is_status = list(query_params) == ["status"]
    query_uses_an_index = get_best_index(table, query_params)
    one_status_uses_the_index = get_best_index(table, {"status": {"eq": None}})
    if only_filter_is_status and not query_uses_an_index and one_status_uses_the_index:
        status_filter = query_params["status"]
        # keep each status the filter lets through: on the in list if there is one,
        # not on the nin list, and not the neq value
        wanted_statuses = []
        for status in resource.statuses():
            if "in" in status_filter and status not in status_filter["in"]:
                continue
            if "nin" in status_filter and status in status_filter["nin"]:
                continue
            if "neq" in status_filter and status == status_filter["neq"]:
                continue
            wanted_statuses.append(status)

        status_resources = []
        for status in wanted_statuses:
            status_resources.extend(
                get_all_resources(
                    connection_id,
                    resource_name,
                    integration_type,
                    {"status": {"eq": status}},
                )
            )
        return status_resources

    dynamo_args, filters = create_dynamo_args(
        table_name, connection_id, query_params=query_params
    )
    items = query_paginated(table_name, dynamo_args, filters)
    full_items = items
    if dynamo_args.get("IndexName"):
        # resource indexes are projections that don't include all fields,
        # so we need to fill in the rest of the data from the main table
        # see utils.api.api_get_resources
        # and get_resources_single_page
        ids_to_get = [item["id"] for item in items]
        full_items = batch_get_resources(
            connection_id, resource_name, integration_type, ids_to_get
        )
    dictified = [dynamo_to_dict(item) for item in full_items]
    return dictified


