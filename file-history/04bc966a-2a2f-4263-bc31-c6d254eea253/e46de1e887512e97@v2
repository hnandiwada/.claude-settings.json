def get_auth_code_row(auth_code):
    retries = 2
    response = {}
    while retries > 0:
        # the exchange and permission validator each read what the other just wrote.
        # by default dynamo reads can be up to a second stale and miss a write that
        # already finished. ConsistentRead makes the read see every finished write
        response = auth_codes_table.get_item(
            Key={"auth_code": auth_code}, ConsistentRead=True
        )
        if "Item" not in response:
            retries -= 1
            time.sleep(0.5)
        else:
            break
    if "Item" not in response:
        raise Exception(f"Auth code {auth_code} not found: {response}")
    return response["Item"]


