# security


def app_encrypt(secret):
    app_pk = get_org_private_key("trackstarhq")
    return org_encrypt(secret, app_pk)


def app_decrypt(secret):
    app_pk = get_org_private_key("trackstarhq")
    return org_decrypt(secret, app_pk)


def org_encrypt(secret, org_pk):
    secret_bytes = json.dumps(secret).encode("utf-8")
    org_pk_bytes = org_pk.encode("utf-8")
    org_pk_bytes = org_pk_bytes + b"\0" * (32 - len(org_pk_bytes))
    cipher = AES.new(org_pk_bytes, AES.MODE_EAX)
    ciphertext, tag = cipher.encrypt_and_digest(secret_bytes)
    return base64.b64encode(cipher.nonce + ciphertext + tag).decode("utf-8")


def org_decrypt(secret, org_pk):
    org_pk_bytes = org_pk.encode("utf-8")
    org_pk_bytes = org_pk_bytes + b"\0" * (32 - len(org_pk_bytes))
    secret_bytes = base64.b64decode(secret)
    nonce, ciphertext, tag = (
        secret_bytes[:16],
        secret_bytes[16:-16],
        secret_bytes[-16:],
    )
    cipher = AES.new(org_pk_bytes, AES.MODE_EAX, nonce)
    plaintext = cipher.decrypt_and_verify(ciphertext, tag)
    return json.loads(plaintext)


def encode_access_token(secret, org_pk):
    return jwt.encode(secret, org_pk, algorithm="HS256")


def decode_access_token(secret, org_pk):
    return jwt.decode(secret, org_pk, algorithms=["HS256"])


def decode_auth_header(header):
    clerk_public_key = get_raw_secret(CLERK_PUBLIC_KEY)
    header = header.split(" ")[1]  # ignore Bearer
    return jwt.decode(header, clerk_public_key, algorithms=["RS256"])


