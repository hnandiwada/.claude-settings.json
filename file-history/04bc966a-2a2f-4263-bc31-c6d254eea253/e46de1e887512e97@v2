def generate_submit_update_expression(item):
    set_expression_list = []
    add_expression_list = []
    expression_attribute_values = {}

    for key, value in item.items():
        if isinstance(value, set):
            # append to list
            add_expression_list.append(f"submit.{key} :{key}")
            expression_attribute_values[f":{key}"] = value
        else:
            # set value
            set_expression_list.append(f"submit.{key} = :{key}")
            expression_attribute_values[f":{key}"] = value

    return set_expression_list, add_expression_list, expression_attribute_values


def update_crawl_items(
    connection_id,
    function_name,
    items_to_update,
    force_replace_submit=False,
    condition_expression=None,
    submit_delete=None,
    submit_remove=None,
):
    key = {"connection_id": connection_id, "function_name": function_name}
    update_expression, expression_attribute_values, expression_attribute_names = (
        generate_sync_dynamo_args(
            items_to_update, force_replace_submit, submit_delete, submit_remove
        )
    )
    update_args = {
        "Key": key,
        "UpdateExpression": update_expression,
        "ReturnValues": "ALL_NEW",
    }
    # a remove-only update has no values, and dynamo rejects an empty map
    if expression_attribute_values:
        update_args["ExpressionAttributeValues"] = expression_attribute_values
    if expression_attribute_names:
        update_args["ExpressionAttributeNames"] = expression_attribute_names
    if condition_expression:
        update_args["ConditionExpression"] = condition_expression
    try:
        update_rsp = scheduler_table.update_item(**update_args)
    except Exception as e:
        if (
            isinstance(e, ClientError)
            and e.response["Error"]["Code"] == "ConditionalCheckFailedException"
        ):
            return None
        logger.error(f"args that caused submit update error: {update_args}")
        existing_item = get_scheduler_row(connection_id, function_name)
        logger.error(f"existing item that caused submit update error: {existing_item}")
        raise e
    return update_rsp


# returns None when the pickle id isn't in tasks_started — indicates it belongs
# to a prior crawl cycle that already reset, so accepting it would create an
# orphan that clean_up_crawl_submit's intersection prune can never collect.
def add_finished_task_if_started(connection_id, function_name, pickle_id):
    try:
        return scheduler_table.update_item(
            Key={"connection_id": connection_id, "function_name": function_name},
            UpdateExpression="ADD submit.tasks_finished :pid",
            ConditionExpression="contains(submit.tasks_started, :pid)",
            ExpressionAttributeValues={":pid": {pickle_id}},
            ReturnValues="ALL_NEW",
        )["Attributes"]
    except ClientError as e:
        if e.response["Error"]["Code"] == "ConditionalCheckFailedException":
            return None
        raise


def generate_sync_dynamo_args(
    items_to_update, force_replace_submit=False, submit_delete=None, submit_remove=None
):
    set_expression_list = []
    add_expression_list = []
    delete_expression_list = []
    remove_expression_list = []
    expression_attribute_values = {}
    expression_attribute_names = {}
    for item, value in items_to_update.items():
        if item == "submit" and not force_replace_submit:
            # Generate update expression for nested dictionaries
            set_expressions, add_expressions, values = (
                generate_submit_update_expression(value)
            )
            set_expression_list.extend(set_expressions)
            add_expression_list.extend(add_expressions)
            expression_attribute_values.update(values)
        else:
            set_expression_list.append(f"#{item} = :{item}")
            expression_attribute_names[f"#{item}"] = item
            expression_attribute_values[f":{item}"] = value
    for key, values in (submit_delete or {}).items():
        # deleting nothing is nothing to say, and dynamo has no empty set
        if not values:
            continue
        delete_expression_list.append(f"submit.{key} :delete_{key}")
        expression_attribute_values[f":delete_{key}"] = values
    for key in submit_remove or []:
        remove_expression_list.append(f"submit.{key}")
    clauses = []
    if set_expression_list:
        clauses.append(f"SET {', '.join(set_expression_list)}")
    if remove_expression_list:
        clauses.append(f"REMOVE {', '.join(remove_expression_list)}")
    if add_expression_list:
        clauses.append(f"ADD {', '.join(add_expression_list)}")
    if delete_expression_list:
        clauses.append(f"DELETE {', '.join(delete_expression_list)}")
    update_expression = " ".join(clauses)
    return update_expression, expression_attribute_values, expression_attribute_names


