def get_events_for_org(
    org_id,
    start_date=None,
    end_date=None,
    integration_name=None,
    integration_type=None,
    connection_id=None,
    customer_id=None,
    event_type=None,
):
    # query the org_id + created_at index so the date window is a key condition
    # (only the window is read) rather than a filter over the whole org partition
    key_expression = Key("org_id").eq(org_id)
    # start_date is required at the api, so an end_date without it never happens.
    # a bare call with neither bound reads the whole org partition.
    if start_date and end_date:
        key_expression = key_expression & Key("created_at").between(
            start_date, end_date
        )
    elif start_date:
        key_expression = key_expression & Key("created_at").gte(start_date)
    dynamo_args = {
        "IndexName": EVENT_LOG_ORG_CREATED_INDEX,
        "KeyConditionExpression": key_expression,
        "ScanIndexForward": False,
    }
    filters = []
    if integration_name:
        filters.append(Attr("integration_name").eq(integration_name))
    if integration_type:
        filters.append(Attr("integration_type").eq(integration_type))
    if connection_id:
        filters.append(Attr("connection_id").eq(connection_id))
    if customer_id:
        filters.append(Attr("customer_id").eq(customer_id))
    if event_type:
        filters.append(Attr("event_type").eq(event_type))
    if filters:
        filter_expression = filters[0]
        for extra_filter in filters[1:]:
            filter_expression = filter_expression & extra_filter
        dynamo_args["FilterExpression"] = filter_expression
    return query_paginated(EVENT_LOG_TABLE, dynamo_args, {})


