import pathlib
import sys

root = pathlib.Path(sys.argv[1]) / ".claude" / "skills"


def sub(path, old, new):
    p = root / path
    text = p.read_text()
    if text.count(old) != 1:
        raise SystemExit(f"{path}: expected one match for {old[:60]!r}, got {text.count(old)}")
    p.write_text(text.replace(old, new))


