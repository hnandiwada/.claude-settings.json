    mocker.patch("celery_tasks.crawler.DRY_RUN", False)
    non_tty_stdin = mocker.Mock()
    non_tty_stdin.isatty.return_value = False
    mocker.patch("celery_tasks.crawler.sys.stdin", non_tty_stdin)
    input_mock = mocker.patch("builtins.input")
    crawler.crawl_task(
        connection_row,
        org_row,
        "get_warehouses",
        False,
        "1971-01-01T00:00:00Z",
        "2000-01-01T00:00:00Z",
        None,
        False,
        force=True,
    )
    input_mock.assert_not_called()
    assert get_and_submit_mock.call_count >= 1


