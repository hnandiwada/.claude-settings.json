def test_implemented_dict():
    test_rsp_1 = {
        "id": "id",
        "name": "name",
        "nested": {"id": "nested-id", "name": "nested-name"},
        "lst": [{"id": "lst-id", "name": "lst-name"}],
        "stringlist": ["lst2-id", "lst2-name"],
        "inventory_by_warehouse_id": {
            "id1": {"id": "id1", "name": "name1"},
            "id2": {"id": "id2", "name": "name2"},
        },
    }
    implemented_dict_1 = {}
    crawler.create_implemented_dict(test_rsp_1, implemented_dict_1)
    assert implemented_dict_1 == {
        "id": True,
        "name": True,
        "nested": {"id": True, "name": True},
        "lst": [{"id": True, "name": True}],
        "stringlist": [True],
        "inventory_by_warehouse_id": {"key": {"id": True, "name": True}},
    }

    test_rsp_2 = {
        "id": "id",
        "name": IntegrationNotImplemented,
        "nested": IntegrationNotImplemented,
        "lst": IntegrationNotImplemented,
    }
    implemented_dict_2 = {}
    crawler.create_implemented_dict(test_rsp_2, implemented_dict_2)
    assert implemented_dict_2 == {
        "id": True,
        "name": False,
        "nested": False,
        "lst": False,
    }

    test_rsp_3 = {
        "id": "id",
        "name": "name",
        "nested": {"id": "nested-id", "name": IntegrationNotImplemented},
        "lst": [{"id": "lst-id", "name": IntegrationNotImplemented}],
    }
    implemented_dict_3 = {}
    crawler.create_implemented_dict(test_rsp_3, implemented_dict_3)
    assert implemented_dict_3 == {
        "id": True,
        "name": True,
        "nested": {"id": True, "name": False},
        "lst": [{"id": True, "name": False}],
    }

    test_rsp_4 = {"lst": []}
    test_rsp_5 = {"lst": [{"id": "lst-id", "name": "lst-name"}]}
    implemented_dict_4 = {}
    crawler.create_implemented_dict(test_rsp_4, implemented_dict_4)
    assert implemented_dict_4 == {"lst": []}
    crawler.create_implemented_dict(test_rsp_5, implemented_dict_4)
    assert implemented_dict_4 == {
        "lst": [{"id": True, "name": True}],
    }
    implemented_dict_5 = {}
    for rsp in [test_rsp_5, test_rsp_4]:
        crawler.create_implemented_dict(rsp, implemented_dict_5)
    assert implemented_dict_5 == {
        "lst": [{"id": True, "name": True}],
    }


def test_merge_implemented_dicts():
    old = {
        "id": True,
        "name": False,
        "ignore": True,
    }
    new = {
        "id": False,
        "name": True,
        "something": True,
    }
    merged = crawler.merge_implemented_dicts(old, new)
    assert merged == {
        "id": False,
        "name": True,
        "something": True,
    }

    old = {
        "list": [{"id": True, "name": False}],
        "dict": {"id": True, "name": False},
    }
    new = {
        "list": [],
        "dict": {},
    }
    merged = crawler.merge_implemented_dicts(old, new)
    assert merged == {
        "list": [{"id": True, "name": False}],
        "dict": {"id": True, "name": False},
    }

    old = {
        "list": [{"id": True, "name": False}],
        "dict": {"id": True, "name": False},
    }
    new = {
        "list": [{"id": True, "name": True}],
        "dict": {"id": True, "name": True},
    }
    merged = crawler.merge_implemented_dicts(old, new)
    assert merged == {
        "list": [{"id": True, "name": True}],
        "dict": {"id": True, "name": True},
    }

    old = {
        "nested": {"key": {"id": True, "name": False}},
    }
    new = {
        "nested": {"key": {"id": True, "name": True}},
    }
    merged = crawler.merge_implemented_dicts(old, new)
    assert merged == {
        "nested": {"key": {"id": True, "name": True}},
    }


