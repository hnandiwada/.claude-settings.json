@pytest.fixture(autouse=True)
def update_crawl_items_mock(mocker):
    # dynamo returns the whole row on ALL_NEW, so carry earlier writes forward: the
    # latest_data a page arms has to still be there when a later call reads it back
    row = {"submit": {"tasks_started": {""}, "tasks_finished": {""}}}

    def side_effect(
        conn_id,
        function_name,
        update_dict,
        force_replace_submit=False,
        condition_expression=None,
        submit_delete=None,
        submit_remove=None,
    ):
        if "submit" not in update_dict:
            update_dict["submit"] = {"tasks_started": {""}, "tasks_finished": {""}}
        for key, value in update_dict.items():
            if key != "submit":
                row[key] = deepcopy(value)
                continue
            if force_replace_submit:
                row["submit"] = deepcopy(value)
                continue
            for submit_key, submit_value in value.items():
                if isinstance(submit_value, set):
                    # dynamo ADDs to the task sets rather than replacing them
                    existing = row["submit"].get(submit_key, set())
                    row["submit"][submit_key] = existing | submit_value
                else:
                    row["submit"][submit_key] = submit_value
        for submit_key, values in (submit_delete or {}).items():
            # dynamo DELETEs only the named members
            row["submit"][submit_key] = row["submit"].get(submit_key, set()) - values
        for submit_key in submit_remove or []:
            row["submit"].pop(submit_key, None)
        return {"Attributes": deepcopy(row)}

    mock = mocker.patch(
        "celery_tasks.crawler.update_crawl_items", side_effect=side_effect
    )
    # the crawler hands the latest_data write to the submitter, which resolves
    # update_crawl_items in its own namespace
    mocker.patch(
        "lambda_handlers.submitter.update_crawl_items", side_effect=side_effect
    )
    return mock


