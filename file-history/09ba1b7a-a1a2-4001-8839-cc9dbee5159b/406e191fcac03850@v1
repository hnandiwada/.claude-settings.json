):
    mocker.patch("celery_tasks.crawler.random.random", return_value=1)
    # between the address (~160 bytes) and the additional_fields (~620 bytes)
    mocker.patch("utils.boto.LARGE_FIELD_THRESHOLD", 300)
    get_all_resources_mock.return_value = []
    additional_fields = {f"key-{i}": "x" * 50 for i in range(10)}
    warehouse = {
        "id": "test-id",
        "name": "test-name",
        "code": None,
        "address": {
            "address1": "test-address1",
            "address2": None,
            "address3": None,
            "city": "test-city",
            "state": "test-state",
            "postal_code": "test-zip",
            "country": "test-country",
        },
        "additional_fields": additional_fields,
    }
    resource.integration.get_warehouses.return_value = {
        "data": [warehouse],
        "next_token": None,
    }
    resource.validate_crawl = mocker.Mock()

    crawler.get_and_submit(
        resource,
        str_to_dt("2000-01-01T00:00:00Z"),
        str_to_dt("2000-01-02T00:00:00Z"),
        False,
        True,
        "default",
        False,
    )

    submitted = s3_write_mock.get_calls("submitter")
    assert len(submitted) == 1
    pickled_row = submitted[0]["payload"]["data"][0]
    # the submitter gets a pointer, s3 has the content
    assert pickled_row["additional_fields"] == {}
    ref = pickled_row["refs"]["additional_fields"]
    assert ref["key"] == "warehouses/test-connection-id/test-id/additional_fields.json"
    assert ref["key"] in s3_write_mock.get_large_field_files()
    # the crawl itself still saw the full row
    validated = resource.validate_crawl.call_args[0][0]["data"][0]
    assert validated["additional_fields"] == additional_fields


