def test_first_crawl(
    store_crawl_params_connection_row,
    org_row,
    get_and_submit_mock,
    store_crawl_params_resource,
    now_mock,
    update_crawl_items_mock,
):
    function_name = "get_bills"
    start_time_str = None
    end_time_str = None
    page_token = None
    crawler.crawl_task(
        store_crawl_params_connection_row,
        org_row,
        function_name,
        True,
        start_time_str,
        end_time_str,
        page_token,
        False,
    )
    assert get_and_submit_mock.call_count == 2
    first_call_args = get_and_submit_mock.call_args_list[0][0]
    assert_resources_equal(first_call_args[0], store_crawl_params_resource)
    integration = store_crawl_params_resource.integration
    created_at = str_to_dt(store_crawl_params_connection_row["created_at"])
    expected_start = created_at - timedelta(
        days=30, minutes=integration.crawl_start_overlap_minutes
    )
    assert first_call_args[1] == expected_start
    assert first_call_args[2] == now_mock.return_value
    assert first_call_args[3] == True
    assert first_call_args[4] == True
    assert first_call_args[5] == "default"
    second_call_args = get_and_submit_mock.call_args_list[1][0]
    assert second_call_args[3] == True
    assert second_call_args[4] == False
    assert second_call_args[5] == 1
    assert update_crawl_items_mock.call_count == 4
    now_str = dt_to_str(now_mock.return_value)
    call_args_list = update_crawl_items_mock.call_args_list
    non_heartbeat_calls = []
    call_elem = None
    for call_elem in call_args_list:
        # independently check heartbeat call
        if call_elem[0][2].get("latest_heartbeat"):
            assert call_elem == call(
                store_crawl_params_connection_row["id"],
                function_name,
                {
                    "latest_heartbeat": now_str,
                    "submit": {"tasks_started": {""}, "tasks_finished": {""}},
                },
            )
            continue
        non_heartbeat_calls.append(call_elem)
    assert call_elem
    expected = [
        call(
            store_crawl_params_connection_row["id"],
            function_name,
            {
                "org_id": store_crawl_params_connection_row["org_id"],
                "last_crawl_start": now_str,
                "submit": {"tasks_started": {""}, "tasks_finished": {""}},
                "stale": False,
                "integration_type": "wms",
                "paused": False,
            },
            force_replace_submit=True,
        ),
        call(
            store_crawl_params_connection_row["id"],
            function_name,
            {
                "submit": {"tasks_started": {"submit_task_id_1"}},
                "latest_page_token": 1,
                "last_page_token_update": now_str,
                "deferred": False,
                # the start the first page was fetched from, so a resume lands there
                "current_crawl_start": dt_to_str(
                    str_to_dt(store_crawl_params_connection_row["created_at"])
                    - timedelta(days=30)
                    - timedelta(
                        minutes=store_crawl_params_resource.integration.crawl_start_overlap_minutes
                    )
                ),
                "current_crawl_end": dt_to_str(now_mock.return_value),
            },
        ),
        call(
            store_crawl_params_connection_row["id"],
            function_name,
            {
                "latest_page_token": None,
                "last_page_token_update": now_str,
                "deferred": False,
                "submit": {
                    "tasks_started": {"submit_task_id_2"},
                    "set_latest_data": now_str,
                    "mark_complete": True,
                },
            },
        ),
        call(
            store_crawl_params_connection_row["id"],
            function_name,
            {
                "last_crawl_end": now_str,
                "submit": {"tasks_started": {""}, "tasks_finished": {""}},
            },
        ),
    ]
    assert len(non_heartbeat_calls) == len(expected)
    for i in range(len(expected)):
        assert non_heartbeat_calls[i] == expected[i]


def test_forced_crawl_in_worker_proceeds_without_input(
    connection_row,
    org_row,
    get_and_submit_mock,
    resource,
    now_mock,
    crawl_heartbeat_active_mock,
    mocker,
):
    # forced crawl overlapping a running one, in a worker with no stdin. the old code
    # called input() here and died with EOFError; it must now proceed silently.
