  suggest-tests:
    runs-on: ubuntu-latest
    if: |
      !contains(github.event.pull_request.title, 'WIP')
    outputs:
      test_args: ${{ steps.determine.outputs.test_args }}
      skip_tests: ${{ steps.determine.outputs.skip_tests }}
    steps:
      - name: Determine test args
        id: determine
        uses: actions/github-script@v9
        with:
          script: |
            const pr = context.payload.pull_request;
            const body = pr.body || '';

            // strip HTML comments for skip-tests check
            const bodyWithoutComments = body.replace(/<!--[\s\S]*?-->/g, '');

            // check for skip-tests (outside of comments)
            if (bodyWithoutComments.includes('[skip-tests]')) {
              core.setOutput('skip_tests', 'true');
              core.setOutput('test_args', '');
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: pr.number,
                body: '⏭️ Tests skipped via `[skip-tests]`'
              });
              return;
            }
            core.setOutput('skip_tests', 'false');

            // check if PR body has non-default test override
            const testMatch = body.match(/test override:\s*`yarn test\s*([^`]*)`/);
            const isAutoGenerated = body.includes('<!-- auto-tests -->');

            // if override is non-default AND was manually set (no marker), use it
            if (testMatch && testMatch[1].trim() !== '-s' && !isAutoGenerated) {
              core.setOutput('test_args', testMatch[1].trim());
              console.log(`Using explicit test args: ${testMatch[1].trim()}`);
              return;
            }

            // auto-detect from changed files
            const { data: files } = await github.rest.pulls.listFiles({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: pr.number,
              per_page: 100
            });

            const integrations = new Set();
            let onlyIntegrationFiles = true;

            // exempt paths that don't affect which tests to run
            const exemptPatterns = [
              /^migrations\//,
              /^templates\//,
              /^package\.json$/,
              /^\.claude\//,
              /^\.github\//
            ];

            for (const file of files) {
              const path = file.filename;

              const intMatch = path.match(/^integrations\/(wms|cart|freight|carrier)\/([^\/]+)\//);
              if (intMatch) {
                integrations.add(intMatch[2]);
                continue;
              }

              // check integrations/shared/NAME/...
              const sharedMatch = path.match(/^integrations\/shared\/([^\/]+)\//);
              if (sharedMatch) {
                integrations.add(sharedMatch[1]);
                continue;
              }

              const testMatch = path.match(/^test\/integrations\/(wms|cart|freight|carrier)\/([^\/]+)_test\.py$/);
              if (testMatch) {
                integrations.add(testMatch[2]);
                continue;
              }

              if (exemptPatterns.some(p => p.test(path))) {
                continue;
              }

              onlyIntegrationFiles = false;
            }

            if (onlyIntegrationFiles && integrations.size > 0) {
              const kArgs = Array.from(integrations).sort().map(i => `-k ${i}`).join(' ');
              core.setOutput('test_args', kArgs);
              console.log(`Auto-detected integration tests: ${kArgs}`);

              // update PR body if default or previously auto-generated
              if (body.includes('test override: `yarn test -s`') || isAutoGenerated) {
                let newBody = body.replace(
                  /test override: `yarn test[^`]*`(\s*<!--\s*auto-tests\s*-->)?/,
                  `test override: \`yarn test ${kArgs}\` <!-- auto-tests -->`
                );
                await github.rest.pulls.update({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  pull_number: pr.number,
                  body: newBody
                });
                await github.rest.issues.createComment({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  issue_number: pr.number,
                  body: `🧪 Auto-detected integration changes, running: \`yarn test -vvv ${kArgs}\``
                });
              }
            } else {
              core.setOutput('test_args', '-s');
              console.log('Using default test args: -s');
            }

  test:
    # arm 64. the run is bound by live vendor I/O rather than CPU, so worker count (which
    # memory caps) matters more than cores. 8 vCPU / 32 GB is half the per-minute cost of
    # the 16-core box. scripts/test.py picks the worker count: serial for a single -k,
    # otherwise one worker per named test file, or 32 for a whole-suite run. a nonints run
    # splits by test instead of by file, so api_test.py doesn't hold the job on one worker.
    runs-on: depot-ubuntu-24.04-arm-8
    timeout-minutes: 40
    needs: suggest-tests
    # this job runs the branch's own code, so it drops the write access the workflow
    # grants the other jobs. id-token is what lets it reach aws without a stored key
    permissions:
      contents: read
      id-token: write
    if: |
      always() && !contains(github.event.pull_request.title, 'WIP') && needs.suggest-tests.outputs.skip_tests != 'true'
    steps:
      - name: Check out repository code
        uses: actions/checkout@v7
        with:
          ref: ${{ github.head_ref }}
          # without this the token is left in .git/config, where anything the branch
          # runs later (a postinstall hook, a test) could read it back out
          persist-credentials: false
      - uses: ./.github/actions/setup-pokedex
      # kept in the workflow rather than the composite action: this file always comes
      # from main, so the pull request cannot change which role gets assumed
      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: arn:aws:iam::708459675662:role/aws-bot-github-role
          aws-region: us-east-1
          # outlive the 40m job timeout so a long full-suite run doesn't lose creds mid-run
          role-duration-seconds: 2700
      - name: Run tests
        # no -n here on purpose: these args vary per PR, and most of them end up serial or
        # capped at the test file count, so a number in this file would describe almost no
        # run. scripts/test.py picks it, and prints the pytest command it settled on.
        run: |
          set -o pipefail
          echo "Running: yarn test -vvv ${{ needs.suggest-tests.outputs.test_args }}"
          yarn test -vvv ${{ needs.suggest-tests.outputs.test_args }} 2>&1 | tee pytest.log
      - name: Upload test log
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: pytest-log
          path: pytest.log
          if-no-files-found: ignore
          retention-days: 7

  # separate job so the results comment gets pull-requests: write without ever handing
  # that token to a job running the branch's code
  comment-results:
    runs-on: ubuntu-latest
    needs: [suggest-tests, test]
    if: ${{ always() && needs.test.result != 'cancelled' && needs.test.result != 'skipped' }}
    permissions:
      contents: read
      pull-requests: write
    steps:
      # no ref: on pull_request_target this checks out the base branch, so the parser
      # comes from main rather than the pull request
      - name: Check out repository code
        uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Download test log
        uses: actions/download-artifact@v8
        continue-on-error: true
        with:
          name: pytest-log
      - name: Build comment
        env:
          JOB_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          TEST_COMMAND: yarn test -vvv ${{ needs.suggest-tests.outputs.test_args }}
        run: python3 scripts/ci_pr_comment.py pytest.log "$JOB_URL" "$TEST_COMMAND" > comment.md
      - name: Post comment
        uses: actions/github-script@v9
        with:
          script: |
            const fs = require('fs');
            const body = fs.readFileSync('comment.md', 'utf8');
            const marker = '<!-- ci-test-results -->';
            const { data: comments } = await github.rest.issues.listComments({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.pull_request.number,
              per_page: 100
            });
            // update the previous results comment instead of stacking one per push
            const existing = comments.find(c => c.body && c.body.includes(marker));
            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.payload.pull_request.number,
                body
              });
            }

